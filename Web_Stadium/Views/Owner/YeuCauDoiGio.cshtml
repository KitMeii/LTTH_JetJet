@model List<Web_Stadium.EFCore.YeuCauDoiGio>
@{
    ViewData["Title"] = "Yêu cầu đổi giờ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActiveNav"] = "DoiGio";
    var tab = ViewBag.Tab as string ?? "ChoPheDuyet";
    var soChoDuyet = (int)(ViewBag.SoChoDuyet ?? 0);
}
<style>
    :root {
        --db-bg: #f8fafc;
        --db-surface: #ffffff;
        --db-card: #ffffff;
        --db-border: #e2e8f0;
        --db-muted: #475569;
        --db-text: #0f172a;
        --db-green: #0f6e4a;
        --db-green-bg: rgba(15,110,74,0.08);
        --db-green-border: rgba(15,110,74,0.2);
    }

    body {
        background: var(--db-bg);
        color: var(--db-text);
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    .page-header { background: var(--db-surface); border-bottom: 1px solid var(--db-border); padding: 24px 0 20px; }
    .sticky-nav { background: var(--db-surface); border-bottom: 1px solid var(--db-border); padding: 12px 0; position: sticky; top: 0; z-index: 100; }
    .nav-btn {
        font-size: 12px; padding: 5px 14px; border-radius: 30px; border: 1px solid var(--db-border);
        background: transparent; color: var(--db-muted); text-decoration: none;
        display: inline-flex; align-items: center; gap: 5px; transition: 0.15s;
    }
    .nav-btn:hover { background: var(--db-bg); color: var(--db-text); border-color: #cbd5e1; }
    .nav-btn-active { background: var(--db-green-bg); color: var(--db-green); border-color: var(--db-green-border); }

    /* ── Filter pill tabs ── */
    .filter-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
    .filter-btn {
        padding: 6px 16px; border-radius: 30px; font-size: 13px; text-decoration: none;
        background: transparent; color: var(--db-muted); border: 1px solid var(--db-border);
        transition: 0.15s; display: inline-flex; align-items: center; gap: 6px;
    }
    .filter-btn:hover { background: var(--db-bg); color: var(--db-text); }
    .filter-btn-active { background: var(--db-green-bg); color: var(--db-green); border-color: var(--db-green-border); font-weight: 600; }
    .filter-badge {
        background: #fef3c7; color: #b45309; font-size: 11px; font-weight: 600;
        padding: 1px 8px; border-radius: 30px;
    }

    /* ── Table wrapper (đồng bộ với DanhSachDonDat) ── */
    .table-wrapper { background: var(--db-card); border: 1px solid var(--db-border); border-radius: 20px; overflow: auto; }
    .booking-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .booking-table th {
        background: var(--db-surface); font-size: 11px; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.5px; color: var(--db-muted); padding: 14px 16px;
        border-bottom: 1px solid var(--db-border); text-align: left; white-space: nowrap;
    }
    .booking-table td { padding: 14px 16px; border-bottom: 1px solid var(--db-border); font-size: 13px; vertical-align: middle; }
    .booking-table tr:last-child td { border-bottom: none; }
    .booking-table code {
        background: var(--db-bg); color: var(--db-green); padding: 2px 8px;
        border-radius: 6px; font-size: 12px;
    }
    .cell-sub { font-size: 12px; color: var(--db-muted); margin-top: 2px; }

    /* ── Status badge ── */
    .status-badge {
        border-radius: 30px; padding: 4px 10px; font-size: 11px; font-weight: 500;
        display: inline-block; background: var(--db-green-bg); color: var(--db-green);
    }
    .status-badge-pending { background: #fffbeb; color: #b45309; }
    .status-badge-confirmed { background: #e6f7e6; color: #0f6e4a; }
    .status-badge-cancelled { background: #fef2f2; color: #b91c1c; }

    /* ── Buttons ── */
    .btn-sm-outline {
        background: transparent; border: 1px solid var(--db-border); border-radius: 30px;
        padding: 4px 12px; font-size: 11px; font-weight: 500; transition: 0.15s;
        text-decoration: none; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
    }
    .btn-sm-outline:hover { background: var(--db-green-bg); border-color: var(--db-green-border); color: var(--db-green); }
    .btn-sm-success { border-color: var(--db-green-border); color: var(--db-green); }
    .btn-sm-success:hover { background: var(--db-green-bg); color: var(--db-green); }
    .btn-sm-danger { border-color: #fecaca; color: #dc2626; }
    .btn-sm-danger:hover { background: #fef2f2; border-color: #f87171; color: #dc2626; }

    .empty-state { text-align: center; padding: 60px 0; color: var(--db-muted); }
</style>

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <div class="text-muted mb-1" style="font-size: 11px; letter-spacing: 1px;">OWNER · QUẢN LÝ ĐỔI GIỜ</div>
                <h1 style="font-size: 2rem; font-weight: 700; margin: 0;">Yêu cầu <span style="color: var(--db-green);">đổi giờ</span></h1>
                <p class="text-muted mt-2 mb-0">Quản lý yêu cầu đổi khung giờ đặt sân từ khách hàng</p>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_OwnerNav")

<div class="container py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc trạng thái (đồng bộ với DanhSachDonDat) -->
    <div class="filter-tabs">
        <a href="?tab=ChoPheDuyet" class="filter-btn @(tab == "ChoPheDuyet" ? "filter-btn-active" : "")">
            ⏳ Chờ duyệt
            @if (soChoDuyet > 0) { <span class="filter-badge">@soChoDuyet</span> }
        </a>
        <a href="?tab=DaDuyet" class="filter-btn @(tab == "DaDuyet" ? "filter-btn-active" : "")">✅ Đã duyệt</a>
        <a href="?tab=TuChoi" class="filter-btn @(tab == "TuChoi" ? "filter-btn-active" : "")">❌ Đã từ chối</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div style="font-size: 4rem; opacity: 0.4;">🕐</div>
            <h4 class="fw-semibold">Không có yêu cầu nào</h4>
            <p class="text-muted">Chưa có yêu cầu đổi giờ ở trạng thái này</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="booking-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Sân</th>
                        <th>Khung hiện tại</th>
                        <th>Khung yêu cầu mới</th>
                        <th>Lý do</th>
                        <th>Gửi lúc</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var y in Model)
                    {
                        <tr>
                            <td><code>@y.DatSan.MaXacNhan</code></td>
                            <td>
                                <div class="fw-semibold">@y.DatSan.User.HoTen</div>
                                <div class="cell-sub">@y.DatSan.User.Email</div>
                            </td>
                            <td>@y.DatSan.KhungGio.SanBong.TenSan</td>
                            <td>
                                <div>@y.DatSan.KhungGio.GioBatDau.ToString(@"HH\:mm") – @y.DatSan.KhungGio.GioKetThuc.ToString(@"HH\:mm")</div>
                                <div class="cell-sub">@y.DatSan.NgayThiDau.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <div>@y.KhungGioMoi.GioBatDau.ToString(@"HH\:mm") – @y.KhungGioMoi.GioKetThuc.ToString(@"HH\:mm")</div>
                                <div class="cell-sub">@y.NgayThiDauMoi.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td style="max-width: 220px;">@y.LyDo</td>
                            <td>@y.NgayTao.ToString("dd/MM HH:mm")</td>
                            <td>
                                @if (y.TrangThai == "ChoPheDuyet")
                                {
                                    <span class="status-badge status-badge-pending">⏳ Chờ duyệt</span>
                                }
                                else if (y.TrangThai == "DaDuyet")
                                {
                                    <span class="status-badge status-badge-confirmed">✅ Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-cancelled">❌ Từ chối</span>
                                    @if (!string.IsNullOrEmpty(y.GhiChuXuLy))
                                    { <div class="cell-sub">@y.GhiChuXuLy</div> }
                                }
                            </td>
                            <td>
                                @if (y.TrangThai == "ChoPheDuyet")
                                {
                                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                        <button class="btn-sm-outline btn-sm-success"
                                                data-bs-toggle="modal" data-bs-target="#modalXuLy"
                                                data-id="@y.Id" data-quyetdinh="Duyet">
                                            <i class="fas fa-check"></i> Duyệt
                                        </button>
                                        <button class="btn-sm-outline btn-sm-danger"
                                                data-bs-toggle="modal" data-bs-target="#modalXuLy"
                                                data-id="@y.Id" data-quyetdinh="TuChoi">
                                            <i class="fas fa-times"></i> Từ chối
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal xử lý -->
<div class="modal fade" id="modalXuLy" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="XuLyDoiGio" method="post" class="modal-content" style="border-radius: 20px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="xlId" />
            <input type="hidden" name="quyetDinh" id="xlQuyetDinh" />
            <div class="modal-header">
                <h5 class="modal-title" id="xlTitle">Xử lý yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label fw-semibold">Ghi chú / Lý do</label>
                <textarea name="ghiChu" class="form-control" rows="3" maxlength="500"
                          placeholder="(tuỳ chọn nếu duyệt, nên có nếu từ chối)"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-sm-outline" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn-sm-outline" id="xlSubmit">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalXuLy').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            var qd = btn.getAttribute('data-quyetdinh');
            document.getElementById('xlId').value = btn.getAttribute('data-id');
            document.getElementById('xlQuyetDinh').value = qd;
            document.getElementById('xlTitle').innerText = qd === 'Duyet' ? '✅ Duyệt yêu cầu đổi giờ' : '❌ Từ chối yêu cầu đổi giờ';
            var btnSubmit = document.getElementById('xlSubmit');
            btnSubmit.className = qd === 'Duyet' ? 'btn-sm-outline btn-sm-success' : 'btn-sm-outline btn-sm-danger';
            btnSubmit.innerText = qd === 'Duyet' ? 'Duyệt' : 'Từ chối';
        });
    </script>
}
