@model Web_Stadium.EFCore.User
@{
    ViewData["Title"] = "Hồ sơ chủ sân";
    ViewData["ActiveNav"] = "";
    var tab = ViewBag.Tab as string ?? "tongquan";
    var sanList = ViewBag.SanList as List<Web_Stadium.EFCore.SanBong> ?? new();
    var staffList = ViewBag.StaffList as List<Web_Stadium.EFCore.User> ?? new();
    var donChoDuyet = ViewBag.DonChoDuyet as List<Web_Stadium.EFCore.DatSan> ?? new();
    var donGanDay = ViewBag.DonGanDay as List<Web_Stadium.EFCore.DatSan> ?? new();
    var lapDayData = ViewBag.LapDayData as List<dynamic> ?? new();
    var khoCanh = ViewBag.KhoCanhBao as List<Web_Stadium.EFCore.DichVu> ?? new();

    int soSan = (int)(ViewBag.SoSan ?? 0);
    int soSanDaDuyet = (int)(ViewBag.SoSanDaDuyet ?? 0);
    int soStaff = (int)(ViewBag.SoStaff ?? 0);
    double tongDT = (double)(ViewBag.TongDoanhThu ?? 0.0);
    double tongPhi = (double)(ViewBag.TongPhiHoaHong ?? 0.0);
}

@section Styles {
    <style>
        :root {
            --db-bg: #f8fafc;
            --db-surface: #ffffff;
            --db-border: #e2e8f0;
            --db-muted: #475569;
            --db-text: #0f172a;
            --db-green: #0f6e4a;
            --db-green-bg: rgba(15,110,74,0.08);
            --db-green-border: rgba(15,110,74,0.2);
        }
        body { background: var(--db-bg); color: var(--db-text); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }

        .sticky-nav { background: var(--db-surface); border-bottom: 1px solid var(--db-border); padding: 12px 0; position: sticky; top: 0; z-index: 100; }
        .nav-btn {
            font-size: 12px; padding: 5px 14px; border-radius: 30px; border: 1px solid var(--db-border);
            background: transparent; color: var(--db-muted); text-decoration: none;
            display: inline-flex; align-items: center; gap: 5px; transition: 0.15s;
        }
        .nav-btn:hover { background: var(--db-bg); color: var(--db-text); border-color: #cbd5e1; }
        .nav-btn-active { background: var(--db-green-bg); color: var(--db-green); border-color: var(--db-green-border); }

        .hs {
            max-width: 960px;
            margin: 24px auto 60px;
            padding: 0 16px;
        }

        .o-hdr {
            background: linear-gradient(135deg,#064e3b,#0EA86A);
            border-radius: 18px;
            padding: 26px 28px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 6px 24px rgba(14,168,106,.28);
        }

        .o-ava {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            font-weight: 800;
            color: #fff;
            border: 3px solid rgba(255,255,255,.3);
            flex-shrink: 0;
        }

        .krow {
            display: grid;
            grid-template-columns: repeat(5,1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .kc {
            background: var(--db-surface);
            border: 1px solid var(--db-border);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(15,23,42,.05);
            position: relative;
            overflow: hidden;
        }

            .kc::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--acc,var(--db-green));
            }

        .kv {
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 5px;
        }

        .kl {
            font-size: .65rem;
            color: var(--db-muted);
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .tb {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: .82rem;
            text-decoration: none;
            border: 1px solid var(--db-border);
            color: var(--db-muted);
            background: var(--db-surface);
            transition: all .18s;
        }

            .tb:hover {
                border-color: var(--db-green);
                color: var(--db-green);
            }

            .tb.on {
                background: var(--db-green);
                color: #fff;
                border-color: var(--db-green);
                font-weight: 600;
            }

            .tb.danger {
                border-color: rgba(239,68,68,.4);
                color: #dc2626;
            }

                .tb.danger.on {
                    background: #dc2626;
                    color: #fff;
                    border-color: #dc2626;
                }

        .card {
            background: var(--db-surface);
            border: 1px solid var(--db-border);
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: 0 2px 8px rgba(15,23,42,.05);
        }

        .ct {
            font-size: .8rem;
            font-weight: 700;
            color: var(--db-text);
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--db-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .ct span {
                color: var(--db-muted);
                font-size: .74rem;
                font-weight: 400;
            }
        /* Đơn chờ duyệt */
        .don-cho {
            border: 1px solid rgba(239,68,68,.35);
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 10px;
            background: #fff5f5;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .don-cho-urgent {
            animation: pulse-border 2s infinite;
        }
        @@keyframes pulse-border {
            0%,100% { border-color: rgba(239,68,68,.35); }
            50% { border-color: rgba(239,68,68,.8); }
        }
        /* Lấp đầy */
        .ld-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--db-border);
            font-size: .83rem;
        }

            .ld-row:last-child {
                border-bottom: none;
            }

        .ld-bar {
            flex: 1;
            background: rgba(15,23,42,.08);
            border-radius: 4px;
            height: 7px;
            overflow: hidden;
        }

        .ld-fill {
            height: 100%;
            border-radius: 4px;
        }
        /* Kho cảnh báo */
        .kho-warn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-radius: 10px;
            margin-bottom: 8px;
            border: 1px solid;
        }

            .kho-warn.red {
                background: rgba(239,68,68,.06);
                border-color: rgba(239,68,68,.3);
            }

            .kho-warn.yellow {
                background: rgba(245,158,11,.06);
                border-color: rgba(245,158,11,.3);
            }
        /* San row */
        .san-r {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px;
            border-radius: 10px;
            border: 1px solid var(--db-border);
            background: #f8fafc;
            margin-bottom: 8px;
        }
        /* Staff */
        .stf {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--db-border);
        }

            .stf:last-child {
                border-bottom: none;
            }

        .stf-ava {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(14,168,106,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--db-green);
            font-size: .9rem;
            flex-shrink: 0;
        }

        .inp {
            width: 100%;
            background: #f8fafc;
            border: 1px solid var(--db-border);
            color: var(--db-text);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: .87rem;
        }

            .inp:focus {
                outline: none;
                border-color: var(--db-green);
                background: #fff;
            }

        .btn-g {
            background: var(--db-green);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            font-weight: 600;
            font-size: .87rem;
            cursor: pointer;
        }

            .btn-g:hover {
                background: #0a5338;
            }
    </style>
}

@await Html.PartialAsync("_OwnerNav")

<div class="hs">
    <!-- Header -->
    <div class="o-hdr">
        <div class="o-ava">@Model.HoTen.FirstOrDefault()</div>
        <div style="flex:1;">
            <div style="color:#fff;font-size:1.1rem;font-weight:700;margin-bottom:4px;">@Model.HoTen.ToUpper()</div>
            <span style="font-size:.7rem;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,.2);color:#fff;">🏟️ Chủ sân</span>
            <div style="color:rgba(255,255,255,.65);font-size:.78rem;margin-top:5px;">@Model.Email &nbsp;·&nbsp; @Model.NgayTao.ToString("MM/yyyy")</div>
        </div>
        @if (donChoDuyet.Any())
        {
            <div style="background:rgba(239,68,68,.2);border:1px solid rgba(239,68,68,.5);border-radius:10px;padding:10px 16px;text-align:center;">
                <div style="font-size:1.4rem;font-weight:800;color:#fff;">@donChoDuyet.Count</div>
                <div style="font-size:.7rem;color:rgba(255,255,255,.8);">⏳ Đơn chờ duyệt</div>
            </div>
        }
    </div>

    <!-- KPI -->
    <div class="krow">
        <div class="kc" style="--acc:var(--green);"><div class="kv" style="color:var(--green);">@soSan</div><div class="kl">🏟 Tổng sân</div></div>
        <div class="kc" style="--acc:#2563eb;"><div class="kv" style="color:#2563eb;">@soSanDaDuyet</div><div class="kl">✅ Đã duyệt</div></div>
        <div class="kc" style="--acc:#f59e0b;"><div class="kv" style="color:#f59e0b;">@soStaff</div><div class="kl">👷 Nhân viên</div></div>
        <div class="kc" style="--acc:var(--green);"><div class="kv" style="color:var(--green);">@((tongDT / 1_000_000).ToString("F1"))M</div><div class="kl">💰 DT (triệu đ)</div></div>
        <div class="kc" style="--acc:#8b5cf6;"><div class="kv" style="color:#8b5cf6;">@((tongPhi / 1_000_000).ToString("F2"))M</div><div class="kl">🏦 Phí HH (tr.đ)</div></div>
    </div>

    <!-- Tabs — đặt tab Đơn chờ duyệt lên đầu và nổi bật nếu có -->
    <div class="tabs">
        @if (donChoDuyet.Any())
        {
            <a href="?tab=doncho" class="tb danger @(tab == "doncho" ? "on" : "")">
                ⚡ Đơn chờ duyệt
                <span style="background:var(--danger);color:#fff;border-radius:999px;padding:1px 7px;font-size:.7rem;margin-left:4px;">@donChoDuyet.Count</span>
            </a>
        }
        <a href="?tab=tongquan" class="tb @(tab == "tongquan" ? "on" : "")">📊 Tổng quan</a>
        <a href="?tab=sanlist" class="tb @(tab == "sanlist" ? "on" : "")">🏟 Sân của tôi</a>
        <a href="?tab=nhanvien" class="tb @(tab == "nhanvien" ? "on" : "")">👷 Nhân viên</a>
        <a href="?tab=thongtin" class="tb @(tab == "thongtin" ? "on" : "")">👤 Thông tin</a>
        <a href="?tab=baomat" class="tb @(tab == "baomat" ? "on" : "")">🔒 Bảo mật</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- TAB: ĐƠN CHỜ DUYỆT -->
    @if (tab == "doncho")
    {
        <div class="card">
            <div class="ct">⚡ ĐƠN ĐANG CHỜ XÁC NHẬN <span style="color:var(--danger);">Phản hồi càng sớm càng tốt!</span></div>
            @foreach (var d in donChoDuyet.OrderBy(d => d.ThoiGianTao))
            {
                var choH = (DateTime.Now - d.ThoiGianTao).TotalHours;
                var conLai = 6.0 - choH;
                var urgent = choH > 4;
                <div class="don-cho @(urgent ? "don-cho-urgent" : "")">
                    <div style="flex:1;">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                            <span style="font-weight:700;color:var(--text);">@d.KhungGio?.SanBong?.TenSan</span>
                            <code style="font-size:.75rem;color:var(--green);">@d.MaXacNhan</code>
                            @if (urgent)
                            {
                                <span class="badge bg-danger" style="font-size:.68rem;">⚠️ Sắp tự hủy!</span>
                            }
                        </div>
                        <div style="font-size:.82rem;color:var(--muted);">
                            👤 <strong>@d.User?.HoTen</strong> &nbsp;·&nbsp; @d.NgayThiDau.ToString("dd/MM/yyyy")
                            &nbsp;·&nbsp; @(d.KhungGio != null ? $"{d.KhungGio.GioBatDau:HH\\:mm}–{d.KhungGio.GioKetThuc:HH\\:mm}" : "")
                            &nbsp;·&nbsp; Cọc: <strong style="color:var(--green);">@d.TienCoc.ToString("N0")đ</strong>
                        </div>
                        <div style="font-size:.76rem;color:@(urgent ? "var(--danger)" : "var(--muted)");margin-top:4px;">
                            ⏱ Đang chờ @choH.ToString("F0")h &nbsp;·&nbsp; Còn ~@Math.Max(0, conLai).ToString("F0")h trước khi tự hủy
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
                        <form method="post" action="/Owner/XacNhanDon">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="datSanId" value="@d.Id" />
                            <button type="submit" style="background:var(--green);color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:.8rem;font-weight:700;cursor:pointer;white-space:nowrap;"
                                    onclick="return confirm('Duyệt đơn @d.MaXacNhan?\nEmail + QR sẽ gửi cho khách ngay.')">
                                ✅ Duyệt ngay
                            </button>
                        </form>
                        <form method="post" action="/Owner/TuChoiDon" style="display:flex;gap:6px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="datSanId" value="@d.Id" />
                            <input type="text" name="lyDo" style="background:#fff;border:1px solid rgba(239,68,68,.4);color:var(--text);border-radius:8px;padding:5px 8px;font-size:.76rem;width:120px;" placeholder="Lý do..." required />
                            <button type="submit" style="background:none;border:1px solid rgba(239,68,68,.4);color:var(--danger);border-radius:8px;padding:5px 10px;font-size:.76rem;cursor:pointer;white-space:nowrap;"
                                    onclick="return confirm('Từ chối? Khách hoàn 100% cọc.')">
                                ❌
                            </button>
                        </form>
                    </div>
                </div>
            }
            <div style="text-align:right;margin-top:8px;">
                <a href="/Owner/DanhSachDonDat" style="color:var(--green);font-size:.8rem;font-weight:600;text-decoration:none;">Xem đầy đủ tại trang Duyệt đơn →</a>
            </div>
        </div>
    }

    <!-- TAB: TỔNG QUAN -->
    @if (tab == "tongquan")
    {
        <!-- Lấp đầy sân -->
        <div class="card">
            <div class="ct">📊 TỶ LỆ LẤP ĐẦY SÂN <span>Tháng @DateTime.Now.Month/@DateTime.Now.Year</span></div>
            @if (!lapDayData.Any())
            {
                <div style="text-align:center;padding:20px;color:var(--muted);">Chưa có dữ liệu.</div>
            }
            @foreach (var ld in lapDayData)
            {
                string tenSan = ""; int tong = 0, daDat = 0;
                try { tenSan = (string)ld.TenSan; tong = (int)ld.Tong; daDat = (int)ld.DaDat; } catch { }
                double pct = tong > 0 ? (double)daDat / tong * 100 : 0;
                var lc = pct >= 70 ? "var(--green)" : pct >= 40 ? "#f59e0b" : "var(--danger)";
                <div class="ld-row">
                    <div style="min-width:140px;font-weight:600;font-size:.84rem;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@tenSan</div>
                    <div class="ld-bar"><div class="ld-fill" style="width:@pct.ToString("F0")%;background:@lc;"></div></div>
                    <div style="min-width:44px;text-align:right;font-weight:700;color:@lc;">@pct.ToString("F0")%</div>
                    <div style="min-width:70px;text-align:right;font-size:.76rem;color:var(--muted);">@daDat/@tong slot</div>
                </div>
            }
        </div>

        <!-- Kho cảnh báo -->
        @if (khoCanh.Any())
        {
            <div class="card">
                <div class="ct">⚠️ HÀNG TỒN KHO SẮP HẾT <span style="color:var(--danger);">Cần nhập thêm!</span></div>
                @foreach (var dv in khoCanh)
                {
                    var isRed = dv.TonKho < 5;
                    <div class="kho-warn @(isRed ? "red" : "yellow")">
                        <div>
                            <div style="font-weight:600;font-size:.87rem;color:var(--text);">@dv.TenDichVu</div>
                            <div style="font-size:.76rem;color:var(--muted);">@dv.SanBong?.TenSan</div>
                        </div>
                        <div style="text-align:right;display:flex;align-items:center;gap:10px;">
                            <div>
                                <div style="font-size:1.2rem;font-weight:800;color:@(isRed ? "var(--danger)" : "#f59e0b");">@dv.TonKho</div>
                                <div style="font-size:.7rem;color:var(--muted);">đơn vị còn lại</div>
                            </div>
                            <a href="/Owner/KhoDichVu?sanId=@dv.SanBongId" style="font-size:.74rem;padding:5px 11px;border-radius:999px;border:1px solid var(--db-border);color:var(--db-green);text-decoration:none;background:#fff;font-weight:600;">Cập nhật →</a>
                        </div>
                    </div>
                }
                <div style="margin-top:8px;font-size:.78rem;color:var(--db-muted);">
                    💡 Bấm "Cập nhật" ngay trên dòng dịch vụ để vào trang quản lý kho của sân tương ứng.
                </div>
            </div>
        }

        <!-- Đơn gần đây -->
        <div class="card">
            <div class="ct">📋 ĐƠN RECENT (7 ngày) <span>@donGanDay.Count đơn</span></div>
            @foreach (var d in donGanDay.Take(8))
            {
                <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--border);font-size:.83rem;">
                    <div>
                        <div style="font-weight:600;color:var(--text);">@d.KhungGio?.SanBong?.TenSan</div>
                        <div style="color:var(--muted);font-size:.76rem;">@d.User?.HoTen &nbsp;·&nbsp; @d.NgayThiDau.ToString("dd/MM") &nbsp;·&nbsp; <code style="font-size:.73rem;">@d.MaXacNhan</code></div>
                    </div>
                    <span class="badge @(d.TrangThai == "HoanThanh" ? "bg-success" : d.TrangThai == "ChoDuyet" ? "bg-warning text-dark" : d.TrangThai == "DaHuy" ? "bg-danger" : "bg-primary")">@d.TrangThai</span>
                </div>
            }
            <a href="/Owner/DanhSachDonDat" style="color:var(--green);font-size:.8rem;font-weight:600;text-decoration:none;display:block;margin-top:10px;">Xem tất cả →</a>
        </div>
    }

    <!-- TAB: SÂN -->
    @if (tab == "sanlist")
    {
        <div class="card">
            <div class="ct">🏟 SÂN CỦA TÔI <span>@sanList.Count sân</span></div>
            @foreach (var s in sanList)
            {
                <div class="san-r">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(14,168,106,.1);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">🏟</div>
                    <div style="flex:1;">
                        <div style="font-weight:600;font-size:.87rem;">@s.TenSan</div>
                        <div style="font-size:.76rem;color:var(--muted);">📍 @s.DiaChi, @s.Quan &nbsp;·&nbsp; Sân @s.LoaiSan người</div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span class="badge @(s.TrangThaiDuyet == "DaDuyet" ? "bg-success" : s.TrangThaiDuyet == "ChoDuyet" ? "bg-warning text-dark" : "bg-danger")">@s.TrangThaiDuyet</span>
                        @if (s.IsHidden)
                        {
                            <span class="badge bg-secondary" style="font-size:.68rem;">Đang ẩn</span>
                        }
                        <a href="/Owner/SuaSan/@s.Id" style="font-size:.76rem;padding:4px 12px;border-radius:999px;border:1px solid var(--border);color:var(--text);text-decoration:none;">Quản lý</a>
                    </div>
                </div>
            }
            <a href="/Owner/DangKySan" class="btn-g mt-3" style="display:inline-block;text-decoration:none;padding:9px 18px;border-radius:8px;">+ Đăng ký sân mới</a>
        </div>
    }

    <!-- TAB: NHÂN VIÊN -->
    @if (tab == "nhanvien")
    {
        <div class="card">
            <div class="ct">👷 NHÂN VIÊN <span>@staffList.Count người</span></div>
            @if (!staffList.Any())
            {
                <div style="text-align:center;padding:20px;color:var(--muted);">Chưa có nhân viên nào.</div>
            }
            @foreach (var s in staffList)
            {
                <div class="stf">
                    <div class="stf-ava">@s.HoTen.FirstOrDefault()</div>
                    <div style="flex:1;"><div style="font-weight:600;font-size:.87rem;color:var(--text);">@s.HoTen</div><div style="font-size:.76rem;color:var(--muted);">@s.Email &nbsp;·&nbsp; @s.SoDienThoai</div></div>
                    <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Đang làm" : "Đã nghỉ")</span>
                </div>
            }
            <a href="/Owner/QuanLyStaff" class="btn-g mt-3" style="display:inline-block;text-decoration:none;padding:9px 18px;border-radius:8px;">Quản lý nhân viên →</a>
        </div>
    }

    <!-- TAB: THÔNG TIN -->
    @if (tab == "thongtin")
    {
        <div class="card">
            <div class="ct">👤 THÔNG TIN CHỦ SÂN</div>
            <form method="post" action="/Owner/CapNhatThongTin">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Họ và tên</label><input name="hoTen" class="inp mt-1" value="@Model.HoTen" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Email</label><input class="inp mt-1" value="@Model.Email" disabled /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Số điện thoại</label><input name="soDienThoai" class="inp mt-1" value="@Model.SoDienThoai" /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Vai trò</label><input class="inp mt-1" value="Chủ sân (Owner)" disabled /></div>
                    <div class="col-12"><button type="submit" class="btn-g">✓ Lưu thay đổi</button></div>
                </div>
            </form>
        </div>
        <div class="card">
            <div class="ct">📄 HỢP ĐỒNG NỀN TẢNG <span>@sanList.Count(s => s.DaKyHopDong) hợp đồng đã ký</span></div>
            @if (!sanList.Any())
            {
                <div style="color:var(--db-muted);font-size:.85rem;">Chưa có sân nào — bạn cần đăng ký sân để ký hợp đồng.</div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @foreach (var s in sanList)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:10px;border:1px solid var(--db-border);background:#f8fafc;">
                            <div>
                                <div style="font-weight:600;font-size:.87rem;">@s.TenSan</div>
                                <div style="font-size:.74rem;color:var(--db-muted);">
                                    @if (s.DaKyHopDong)
                                    {
                                        <span>✅ Đã ký ngày @(s.NgayKyHopDong?.ToString("dd/MM/yyyy"))</span>
                                    }
                                    else
                                    {
                                        <span>⏳ Chưa ký</span>
                                    }
                                </div>
                            </div>
                            <a href="/Owner/XemHopDong/@s.Id" target="_blank" style="font-size:.78rem;padding:6px 14px;border-radius:999px;border:1px solid var(--db-border);color:var(--db-text);text-decoration:none;background:#fff;">📑 Xem & In →</a>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- TAB: BẢO MẬT -->
    @if (tab == "baomat")
    {
        <div class="card">
            <div class="ct">🔒 ĐỔI MẬT KHẨU</div>
            <form method="post" action="/Owner/DoiMatKhau">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu hiện tại</label><input type="password" name="matKhauCu" class="inp mt-1" placeholder="••••••••" required /></div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu mới</label><input type="password" name="matKhauMoi" class="inp mt-1" placeholder="Tối thiểu 6 ký tự" minlength="6" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Xác nhận</label><input type="password" name="xacNhanMatKhau" class="inp mt-1" placeholder="Nhập lại" required /></div>
                    <div class="col-12"><button type="submit" class="btn-g">🔒 Đổi mật khẩu</button></div>
                </div>
            </form>
        </div>
    }
</div>
