@{
    ViewData["Title"] = "Xác nhận đặt sân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var khungGio = ViewBag.KhungGio as Web_Stadium.EFCore.KhungGio;
    var san = khungGio?.SanBong;
    var ngay = (DateTime)ViewBag.Ngay;
    var tienCocGoc = (decimal)ViewBag.TienCoc;
    var tyLeCoc = (decimal)ViewBag.TyLeCoc;
    var tyLePct = (int)Math.Round(tyLeCoc * 100);
    var dichVus = ViewBag.DichVus as IEnumerable<Web_Stadium.EFCore.DichVu> ?? Enumerable.Empty<Web_Stadium.EFCore.DichVu>();
    var vouchers = ViewBag.Vouchers as List<Web_Stadium.EFCore.UserVoucher> ?? new();
    var hetHan = ViewBag.HetHan as DateTime?;
    var conLaiGiay = hetHan.HasValue ? Math.Max(0, (int)(hetHan.Value - DateTime.Now).TotalSeconds) : 300;
}

@section Styles {
    <style>
        .create-wrap {
            max-width: 700px;
            margin: 100px auto 60px;
            padding: 0 16px;
        }

        /* Countdown */
        .countdown-bar {
            background: rgba(239,68,68,.1);
            border: 1px solid rgba(239,68,68,.3);
            border-radius: 12px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
        }

            .countdown-bar .cd-icon {
                font-size: 1.4rem;
            }

            .countdown-bar .cd-text {
                flex: 1;
                color: #ccc;
                font-size: .88rem;
            }

            .countdown-bar .cd-timer {
                font-family: monospace;
                font-size: 1.4rem;
                font-weight: 700;
                color: #ef4444;
                min-width: 54px;
                text-align: right;
            }

            .countdown-bar.urgent {
                border-color: rgba(239,68,68,.7);
                background: rgba(239,68,68,.18);
            }

        /* Card */
        .cb-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 18px;
        }

        .cb-label {
            font-size: .75rem;
            letter-spacing: 1.5px;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .info-cell .lbl {
            font-size: .78rem;
            color: #888;
            margin-bottom: 4px;
        }

        .info-cell .val {
            font-size: .95rem;
            color: #fff;
            font-weight: 600;
        }

            .info-cell .val.green {
                color: var(--green);
            }

        /* Dịch vụ */
        .dv-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .dv-row:last-child {
                border-bottom: none;
            }

        .qty-btn {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

            .qty-btn:hover {
                background: rgba(30,215,96,.2);
            }

        .qty-val {
            min-width: 28px;
            text-align: center;
            font-weight: 700;
            color: #fff;
            font-size: .95rem;
        }

        /* Voucher */
        .voucher-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        .voucher-opt {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 10px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.1);
            background: rgba(255,255,255,.03);
            transition: all .15s;
        }

            .voucher-opt:hover {
                border-color: rgba(30,215,96,.4);
            }

            .voucher-opt.selected {
                border-color: var(--green);
                background: rgba(30,215,96,.08);
            }

            .voucher-opt input[type=radio] {
                accent-color: var(--green);
            }

            .voucher-opt .v-name {
                color: #fff;
                font-weight: 600;
                font-size: .88rem;
            }

            .voucher-opt .v-meta {
                color: #888;
                font-size: .76rem;
                margin-top: 2px;
            }

            .voucher-opt .v-code {
                font-family: monospace;
                font-size: .78rem;
                color: var(--green);
            }

        /* Tổng tiền */
        .price-row {
            display: flex;
            justify-content: space-between;
            font-size: .9rem;
            padding: 7px 0;
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

            .price-row .lbl {
                color: #aaa;
            }

            .price-row .amt {
                color: #fff;
                font-weight: 600;
            }

            .price-row.giam .lbl {
                color: #4ade80;
            }

            .price-row.giam .amt {
                color: #4ade80;
            }

            .price-row.total {
                border-bottom: none;
                padding-top: 12px;
            }

                .price-row.total .lbl {
                    color: #fff;
                    font-weight: 700;
                    font-size: 1rem;
                }

                .price-row.total .amt {
                    color: var(--green);
                    font-weight: 700;
                    font-size: 1.1rem;
                }

        .btn-submit {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 12px;
            background: var(--green);
            color: #000;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: .5px;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .88;
            }

            .btn-submit:disabled {
                opacity: .4;
                cursor: not-allowed;
            }
    </style>
}

<div class="create-wrap">

    <!-- Breadcrumb -->
    <nav style="margin-bottom:20px;">
        <a href="/Venues/Details/@san?.Id" style="font-size:.82rem; color:#888; text-decoration:none; letter-spacing:1px;">
            ← QUAY LẠI SÂN
        </a>
    </nav>
    <div style="color:#888; font-size:.75rem; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:6px;">Đặt sân</div>
    <h2 style="color:#fff; font-size:1.6rem; font-weight:700; margin-bottom:24px;">
        Xác nhận & Thanh toán cọc
    </h2>

    @if (khungGio == null || san == null)
    {
        <div style="text-align:center; padding:60px 0; color:#888;">
            <div style="font-size:3rem; margin-bottom:12px;">⚠️</div>
            <div>Khung giờ không hợp lệ hoặc đã hết hạn giữ chỗ.</div>
            <a href="/Venues" style="color:var(--green); margin-top:16px; display:inline-block;">Quay lại tìm sân</a>
        </div>
    }
    else
    {
        <!-- ── COUNTDOWN ─────────────────────────────────── -->
        <div class="countdown-bar" id="countdownBar">
            <span class="cd-icon">⏱</span>
            <div class="cd-text">
                Slot đang được giữ cho bạn. Vui lòng thanh toán trước khi hết giờ.
            </div>
            <div class="cd-timer" id="cdTimer">05:00</div>
        </div>

        <!-- ── THÔNG TIN ĐẶT SÂN ────────────────────────── -->
        <div class="cb-card">
            <div class="cb-label">Thông tin đặt sân</div>
            <div style="font-size:1.1rem; font-weight:700; color:#fff; margin-bottom:14px;">@san.TenSan</div>
            <div class="info-grid">
                <div class="info-cell">
                    <div class="lbl">Địa chỉ</div>
                    <div class="val">@san.DiaChi, @san.Quan</div>
                </div>
                <div class="info-cell">
                    <div class="lbl">Ngày thi đấu</div>
                    <div class="val">@ngay.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="info-cell">
                    <div class="lbl">Khung giờ</div>
                    <div class="val">@khungGio.GioBatDau.ToString(@"hh\:mm") – @khungGio.GioKetThuc.ToString(@"hh\:mm")</div>
                </div>
                <div class="info-cell">
                    <div class="lbl">Giá thuê</div>
                    <div class="val">@khungGio.Gia.ToString("N0")đ</div>
                </div>
                <div class="info-cell">
                    <div class="lbl">Tỷ lệ cọc</div>
                    <div class="val">@tyLePct%</div>
                </div>
                <div class="info-cell">
                    <div class="lbl">Tiền cọc cần trả</div>
                    <div class="val green" id="lblTienCoc">@tienCocGoc.ToString("N0")đ</div>
                </div>
            </div>
        </div>

        <form method="post" action="/Booking/Create" id="bookingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="khungGioId" value="@khungGio.Id" />
            <input type="hidden" name="ngayThiDauStr" value="@ngay.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="userVoucherId" id="selectedVoucherId" value="" />

            <!-- ── DỊCH VỤ KÈM THEO ───────────────────── -->
            @if (dichVus.Any())
            {
                <div class="cb-card">
                    <div class="cb-label">Dịch vụ kèm theo (tuỳ chọn)</div>
                    @{
                        int idx = 0;
                    }
                    @foreach (var dv in dichVus)
                    {
                        <div class="dv-row">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <span style="font-size:1.3rem;">
                                    @(dv.DanhMucDichVu?.Icon ?? "🎁")
                                </span>
                                <div>
                                    <div style="color:#fff; font-weight:600; font-size:.9rem;">@dv.TenDichVu</div>
                                    <div style="color:#888; font-size:.78rem;">@dv.Gia.ToString("N0")đ / đơn vị &nbsp;·&nbsp; Còn @dv.TonKho</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <input type="hidden" name="dichVuIds" value="@dv.Id" />
                                <button type="button" class="qty-btn" onclick="changeQty(@idx,-1)">−</button>
                                <span class="qty-val" id="qty-@idx">0</span>
                                <button type="button" class="qty-btn" onclick="changeQty(@idx,1)" data-max="@dv.TonKho">+</button>
                                <input type="hidden" name="soLuongs" id="sl-@idx" value="0" />
                            </div>
                        </div>
                        idx++;
                    }
                </div>
            }

            <!-- ── MÃ VOUCHER CÔNG KHAI (Owner phát) ─── -->
            <div class="cb-card">
                <div class="cb-label">🎟️ Mã voucher công khai (do chủ sân phát hành)</div>
                <div style="display:flex; gap:8px; align-items:center;">
                    <input type="text" name="maVoucherCongKhai" maxlength="50"
                           placeholder="Nhập mã, ví dụ: GIAM20"
                           style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #444; background:#222; color:#fff; text-transform:uppercase;" />
                </div>
                <small style="color:#888;">Mã sẽ được kiểm tra khi bấm "Đặt sân". Không dùng cùng lúc với voucher trong kho.</small>
            </div>

            <!-- ── VOUCHER ────────────────────────────── -->
            @if (vouchers.Any())
            {
                <div class="cb-card">
                    <div class="cb-label">Voucher của bạn</div>
                    <div class="voucher-list">
                        <label class="voucher-opt selected" id="vopt-none">
                            <input type="radio" name="_vopt" value="" checked onchange="applyVoucher(null,0,'none')" />
                            <div>
                                <div class="v-name">Không dùng voucher</div>
                            </div>
                        </label>
                        @foreach (var uv in vouchers)
                        {
                            var v = uv.Voucher;
                            if (v == null) continue;
                            var giamHienThi = v.LoaiGiam == "PhanTram"
                            ? $"Giảm {v.GiaTriGiam:0}%{(v.GiamToiDa.HasValue ? $" (tối đa {v.GiamToiDa.Value:N0}đ)" : "")}"
                            : $"Giảm {v.GiaTriGiam:N0}đ";
                            decimal soTienGiam = v.LoaiGiam == "PhanTram"
                            ? Math.Min(tienCocGoc * v.GiaTriGiam / 100m, v.GiamToiDa ?? decimal.MaxValue)
                            : v.GiaTriGiam;
                            soTienGiam = Math.Min(soTienGiam, tienCocGoc);

                            <label class="voucher-opt" id="vopt-@uv.Id" onclick="applyVoucher('@uv.MaSuDung', @soTienGiam, '@uv.Id')">
                                <input type="radio" name="_vopt" value="@uv.MaSuDung" />
                                <div style="flex:1;">
                                    <div class="v-name">@v.TenVoucher</div>
                                    <div class="v-meta">@giamHienThi &nbsp;·&nbsp; HSD: @uv.NgayHetHan.ToString("dd/MM")</div>
                                    <div class="v-code">@uv.MaSuDung</div>
                                </div>
                                <div style="color:#4ade80; font-weight:700; font-size:.9rem; white-space:nowrap;">
                                    −@soTienGiam.ToString("N0")đ
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- ── TỔNG TIỀN ──────────────────────────── -->
            <div class="cb-card">
                <div class="cb-label">Chi tiết thanh toán</div>

                <div class="price-row">
                    <span class="lbl">Giá thuê sân</span>
                    <span class="amt">@khungGio.Gia.ToString("N0")đ</span>
                </div>
                <div class="price-row">
                    <span class="lbl">Tiền cọc (@tyLePct%)</span>
                    <span class="amt">@tienCocGoc.ToString("N0")đ</span>
                </div>
                <div class="price-row giam" id="rowGiam" style="display:none;">
                    <span class="lbl">🎁 Giảm voucher</span>
                    <span class="amt" id="amtGiam">−0đ</span>
                </div>
                <div class="price-row" id="rowDv" style="display:none;">
                    <span class="lbl">Dịch vụ kèm</span>
                    <span class="amt" id="amtDv">0đ</span>
                </div>
                <div class="price-row total">
                    <span class="lbl">💳 Thanh toán ngay (cọc)</span>
                    <span class="amt" id="amtTotal">@tienCocGoc.ToString("N0")đ</span>
                </div>
                <div class="price-row" style="border-bottom:none;">
                    <span class="lbl" style="color:#666;">Còn lại trả tại sân</span>
                    <span class="amt" style="color:#888;" id="amtConLai">@((khungGio.Gia - tienCocGoc).ToString("N0"))đ</span>
                </div>
            </div>

            <!-- ── NÚT XÁC NHẬN ─────────────────────── -->
            <button type="submit" class="btn-submit" id="btnSubmit">
                ✅ Xác nhận & Đặt sân (thanh toán tại quầy)
            </button>
            <p style="text-align:center; color:#666; font-size:.78rem; margin-top:10px;">
                Đơn sẽ ở trạng thái <strong style="color:#f59e0b;">Chờ xác nhận</strong> cho đến khi Owner duyệt.
            </p>
        </form>
    }
</div>

@section Scripts {
    <script>
        // ── Giá dịch vụ ───────────────────────────────────────────
        var dichVuGia = [@Html.Raw(string.Join(",", dichVus.Select(d => d.Gia)))];
        var tienCocGoc = @tienCocGoc;
        var soTienGiam = 0;

        function changeQty(idx, delta) {
            var el  = document.getElementById('qty-' + idx);
            var sl  = document.getElementById('sl-' + idx);
            var btn = document.querySelectorAll('.qty-btn')[idx * 2 + 1]; // nút +
            var max = parseInt(document.querySelectorAll('[data-max]')[idx]?.dataset.max || 99);
            var val = Math.max(0, Math.min(max, parseInt(el.textContent) + delta));
            el.textContent = val;
            sl.value = val;
            updateTotal();
        }

        // ── Voucher ───────────────────────────────────────────────
        function applyVoucher(maSuDung, giam, optId) {
            soTienGiam = giam || 0;
            document.getElementById('selectedVoucherId').value = maSuDung || '';
            // UI
            document.querySelectorAll('.voucher-opt').forEach(el => el.classList.remove('selected'));
            document.getElementById('vopt-' + optId)?.classList.add('selected');
            updateTotal();
        }

        // ── Tính tổng ─────────────────────────────────────────────
        function updateTotal() {
            var dvSum = 0;
            dichVuGia.forEach(function(gia, i) {
                var q = parseInt(document.getElementById('sl-' + i)?.value || 0);
                dvSum += gia * q;
            });

            var cocSauGiam = Math.max(0, tienCocGoc - soTienGiam);
            var tongThanhToan = cocSauGiam + dvSum;

            // Hiện/ẩn dòng giảm
            var rowGiam = document.getElementById('rowGiam');
            if (soTienGiam > 0) {
                rowGiam.style.display = 'flex';
                document.getElementById('amtGiam').textContent = '−' + soTienGiam.toLocaleString('vi-VN') + 'đ';
            } else {
                rowGiam.style.display = 'none';
            }

            // Dịch vụ
            var rowDv = document.getElementById('rowDv');
            if (dvSum > 0) {
                rowDv.style.display = 'flex';
                document.getElementById('amtDv').textContent = dvSum.toLocaleString('vi-VN') + 'đ';
            } else {
                rowDv.style.display = 'none';
            }

            document.getElementById('amtTotal').textContent = tongThanhToan.toLocaleString('vi-VN') + 'đ';
            document.getElementById('lblTienCoc').textContent = cocSauGiam.toLocaleString('vi-VN') + 'đ';
        }

        // ── Countdown 5 phút ──────────────────────────────────────
        var conLai = @conLaiGiay;
        var bar    = document.getElementById('countdownBar');
        var timer  = document.getElementById('cdTimer');
        var btn    = document.getElementById('btnSubmit');

        function tickCountdown() {
            if (conLai <= 0) {
                timer.textContent = '00:00';
                bar.classList.add('urgent');
                btn.disabled = true;
                btn.textContent = '⏱ Hết thời gian giữ chỗ — Vui lòng chọn lại';
                // Redirect về sân sau 3 giây
                setTimeout(function() {
                    window.location.href = '/Venues/Details/@san?.Id';
                }, 3000);
                return;
            }
            var m = Math.floor(conLai / 60);
            var s = conLai % 60;
            timer.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
            if (conLai <= 60) bar.classList.add('urgent');
            conLai--;
            setTimeout(tickCountdown, 1000);
        }
        tickCountdown();
    </script>
}
