@*  CSS chung cho mọi view Tournament — đồng bộ với Owner pattern  *@
<style>
    :root {
        --db-bg: #f8fafc;
        --db-surface: #ffffff;
        --db-card: #ffffff;
        --db-border: #e2e8f0;
        --db-muted: #475569;
        --db-text: #0f172a;
        --db-green: #0f6e4a;
        --db-green-bg: rgba(15,110,74,0.08);
        --db-green-border: rgba(15,110,74,0.2);
        --db-radius-sm: 8px;
        --db-radius-md: 16px;
        --grid-gap: 20px;
    }

    body {
        background: var(--db-bg);
        color: var(--db-text);
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    /* ── HERO ── */
    .tour-hero {
        background-size: cover;
        background-position: center;
        border-bottom: 1px solid var(--db-border);
        padding: 90px 0 28px;
    }
    .tour-hero__inner {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 16px;
    }
    .tour-hero__title { font-size: 22px; font-weight: 700; color: #000; margin: 0; }
    .tour-hero__sub   { font-size: 12px; color: #000; margin-top: 4px; }
    .tour-hero__label { font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase;
                        color: #000; font-weight: 600; margin-bottom: 6px; }
    .tour-hero__badge { font-size: 11px; padding: 5px 12px; border-radius: 20px;
                        background: var(--db-green-bg); color: #fff;
                        border: 1px solid var(--db-green-border); font-weight: 600; white-space: nowrap; }

    /* ── CONTENT ── */
    .tour-content { padding: 32px 0; display: flex; flex-direction: column; gap: 24px; }
    .tour-section-label { font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase;
                          color: var(--db-muted); font-weight: 600; margin-bottom: 12px; }

    /* ── CARD ── */
    .tour-card { background: var(--db-card); border: 1px solid var(--db-border);
                 border-radius: var(--db-radius-md); padding: 20px; transition: .2s; }
    .tour-card--hover:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.04); border-color: #cbd5e1; }
    .tour-card__title { font-size: 14px; font-weight: 600; color: var(--db-text); }
    .tour-card__sub   { font-size: 11px; color: var(--db-muted); margin-top: 4px; }
    .tour-card__header { margin-bottom: 14px; display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }

    /* ── KPI ── */
    .tour-kpi-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--grid-gap); }
    .tour-kpi { background: var(--db-card); border: 1px solid var(--db-border);
                border-radius: var(--db-radius-md); padding: 14px 16px; position: relative;
                overflow: hidden; transition: .2s; }
    .tour-kpi:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.04); border-color: #cbd5e1; }
    .tour-kpi__label { font-size: 10px; letter-spacing: .8px; text-transform: uppercase;
                       color: var(--db-muted); margin-bottom: 4px; }
    .tour-kpi__num   { font-size: 20px; font-weight: 700; color: var(--db-text); line-height: 1.1; }
    .tour-kpi__sub   { font-size: 11px; color: var(--db-muted); margin-top: 4px; }
    .tour-kpi__icon  { position: absolute; right: 14px; top: 12px; font-size: 22px; opacity: .15; }

    /* ── STATUS PILL ── */
    .tour-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11px;
                 font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
                 padding: 4px 12px; border-radius: 999px; white-space: nowrap; }
    .tp-draft     { background: rgba(15,23,42,.08); color: var(--db-muted); }
    .tp-approved  { background: rgba(15,110,74,.1); color: var(--db-green); }
    .tp-open      { background: rgba(14,165,233,.1); color: #0369A1; border: 1px solid rgba(14,165,233,.2); }
    .tp-closed    { background: rgba(245,158,11,.1); color: #B45309; border: 1px solid rgba(245,158,11,.2); }
    .tp-active    { background: rgba(15,110,74,.15); color: var(--db-green); border: 1px solid var(--db-green-border); }
    .tp-finished  { background: rgba(100,116,139,.1); color: #475569; border: 1px solid rgba(100,116,139,.2); }

    /* ── BUTTONS ── */
    .tour-btn { display: inline-flex; align-items: center; gap: 6px;
                font-size: 12.5px; font-weight: 600; padding: 7px 16px;
                border-radius: 999px; border: 1px solid var(--db-border);
                background: transparent; color: var(--db-text); text-decoration: none;
                cursor: pointer; transition: .15s; }
    .tour-btn:hover  { background: var(--db-bg); border-color: #cbd5e1; }
    .tour-btn--primary { background: var(--db-green); color: #fff; border-color: var(--db-green); }
    .tour-btn--primary:hover { background: #0a5238; color: #fff; }
    .tour-btn--ghost-green { color: var(--db-green); border-color: var(--db-green-border); background: var(--db-green-bg); }
    .tour-btn--ghost-green:hover { background: rgba(15,110,74,.14); }
    .tour-btn--warn  { background: #f59e0b; color: #fff; border-color: #f59e0b; }
    .tour-btn--warn:hover { background: #d97706; color: #fff; }
    .tour-btn--danger { background: #dc2626; color: #fff; border-color: #dc2626; }
    .tour-btn--danger:hover { background: #b91c1c; color: #fff; }
    .tour-btn--sm { padding: 4px 12px; font-size: 11.5px; }
    .tour-btn--block { width: 100%; justify-content: center; }

    /* ── FORM ── */
    .tour-lbl { font-size: 11.5px; font-weight: 600; letter-spacing: .3px;
                text-transform: uppercase; color: var(--db-muted); margin-bottom: 7px; display: block; }
    .tour-inp { width: 100%; background: #fff; border: 1px solid var(--db-border);
                color: var(--db-text); border-radius: 10px; padding: 10px 13px;
                font-size: 14px; font-family: inherit; transition: border-color .15s, box-shadow .15s; }
    .tour-inp:focus { outline: none; border-color: var(--db-green);
                      box-shadow: 0 0 0 3px var(--db-green-bg); }
    .tour-inp::placeholder { color: #94a3b8; }
    .tour-hint { font-size: 11px; color: var(--db-muted); margin-top: 5px; }
    .tour-form-section { background: var(--db-card); border: 1px solid var(--db-border);
                         border-radius: var(--db-radius-md); padding: 22px 24px; margin-bottom: 18px; }
    .tour-form-section__title { font-size: 11px; letter-spacing: 2.4px; text-transform: uppercase;
                                color: var(--db-green); font-weight: 700; margin-bottom: 16px;
                                padding-bottom: 10px; border-bottom: 1px solid var(--db-border);
                                display: flex; align-items: center; gap: 8px; }

    /* ── TABLE ── */
    .tour-table { width: 100%; border-collapse: collapse; }
    .tour-table thead th { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
                           color: var(--db-muted); padding: 10px 14px; font-weight: 600;
                           border-bottom: 1px solid var(--db-border); white-space: nowrap; text-align: left; }
    .tour-table tbody tr { border-bottom: 1px solid var(--db-border); }
    .tour-table tbody tr:last-child { border-bottom: none; }
    .tour-table tbody tr:hover { background: var(--db-green-bg); }
    .tour-table tbody td { padding: 11px 14px; font-size: 13px; color: var(--db-text); vertical-align: middle; }

    /* Rank colors */
    .rank-1 td:first-child { color: #FFD700; font-weight: 800; }
    .rank-2 td:first-child { color: #94a3b8; font-weight: 700; }
    .rank-3 td:first-child { color: #CD7F32; font-weight: 700; }

    /* ── TABS ── */
    .tour-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--db-border);
                 margin-bottom: 22px; overflow-x: auto; }
    .tour-tab { padding: 10px 18px; font-size: 12px; letter-spacing: .8px;
                text-transform: uppercase; color: var(--db-muted); cursor: pointer;
                white-space: nowrap; border: none; background: none; font-weight: 600;
                border-bottom: 2px solid transparent; margin-bottom: -1px; transition: .15s; }
    .tour-tab:hover { color: var(--db-text); }
    .tour-tab.active { color: var(--db-green); border-bottom-color: var(--db-green); }
    .tour-panel { display: none; }
    .tour-panel.active { display: block; }

    /* ── INFO ROW ── */
    .tour-info-row { display: flex; justify-content: space-between; padding: 9px 0;
                     border-bottom: 1px solid var(--db-border); font-size: 13px; }
    .tour-info-row:last-child { border-bottom: none; }
    .tour-info-row__lbl { color: var(--db-muted); }
    .tour-info-row__val { font-weight: 600; color: var(--db-text); text-align: right; max-width: 60%; }

    /* ── EMPTY STATE ── */
    .tour-empty { padding: 60px 20px; text-align: center; color: var(--db-muted); }
    .tour-empty__icon { font-size: 3rem; margin-bottom: 12px; }
    .tour-empty__title { font-size: 1.1rem; color: var(--db-text); font-weight: 600; margin-bottom: 6px; }
    .tour-empty__sub { font-size: 13px; margin-bottom: 18px; }

    /* ── PROGRESS BAR ── */
    .tour-prog { height: 5px; border-radius: 4px; background: var(--db-bg); overflow: hidden; }
    .tour-prog__fill { height: 100%; border-radius: 4px; background: var(--db-green); transition: width .4s ease; }

    /* ── ALERTS ── */
    .tour-alert { padding: 12px 16px; border-radius: 10px; font-size: 13px;
                  display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
    .tour-alert--success { background: rgba(15,110,74,.08); border: 1px solid var(--db-green-border); color: var(--db-green); }
    .tour-alert--error   { background: rgba(220,38,38,.08); border: 1px solid rgba(220,38,38,.2); color: #b91c1c; }
    .tour-alert--info    { background: rgba(14,165,233,.08); border: 1px solid rgba(14,165,233,.2); color: #0369A1; }

    /* ── BADGE ── */
    .tour-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px;
                  font-weight: 600; padding: 3px 9px; border-radius: 999px; }
    .tour-badge--ok   { background: var(--db-green-bg); color: var(--db-green); border: 1px solid var(--db-green-border); }
    .tour-badge--warn { background: rgba(245,158,11,.1); color: #b45309; border: 1px solid rgba(245,158,11,.2); }

    @@media (max-width: 992px) {
        .tour-kpi-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 600px) {
        .tour-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .tour-hero { padding-top: 80px; }
        .tour-hero__title { font-size: 18px; }
    }
</style>
