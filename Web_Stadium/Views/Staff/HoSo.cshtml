@model Web_Stadium.EFCore.User
@{
    ViewData["Title"] = "Hồ sơ nhân viên";
    var tab = ViewBag.Tab as string ?? "tongquan";
    var sanPhanCong = ViewBag.SanPhanCong as List<Web_Stadium.EFCore.SanBong> ?? new();
    var lichSuCa = ViewBag.LichSuCa as List<Web_Stadium.EFCore.DatSan> ?? new();
    int soCheckIn = (int)(ViewBag.SoCheckIn ?? 0);
    int soCheckOut = (int)(ViewBag.SoCheckOut ?? 0);
    int soSuCo = (int)(ViewBag.SoSuCo ?? 0);
    double tongGio = (double)(ViewBag.TongGioLam ?? 0.0);
    var homNay = lichSuCa.Where(d => d.NgayThiDau.Date == DateTime.Today).OrderBy(d => d.KhungGio?.GioBatDau).ToList();
    var ngayMai = lichSuCa.Where(d => d.NgayThiDau.Date == DateTime.Today.AddDays(1)).OrderBy(d => d.KhungGio?.GioBatDau).ToList();
    var thangNay = lichSuCa.Where(d => d.NgayThiDau.Month == DateTime.Now.Month && d.NgayThiDau.Year == DateTime.Now.Year).ToList();
    double tongGioThang = thangNay.Where(d => d.KhungGio != null).Sum(d => (d.KhungGio!.GioKetThuc - d.KhungGio.GioBatDau).TotalHours);
}

@section Styles {
    <style>
        .hs {
            max-width: 940px;
            margin: 86px auto 60px;
            padding: 0 16px;
        }

        .s-hdr {
            background: linear-gradient(135deg,#1e3a5f,#1d4ed8);
            border-radius: 18px;
            padding: 26px 28px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 6px 24px rgba(29,78,216,.25);
        }

        .s-ava {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            font-weight: 800;
            color: #fff;
            border: 3px solid rgba(255,255,255,.3);
            flex-shrink: 0;
        }

        .krow {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .kc {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px 14px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(15,23,42,.05);
            position: relative;
            overflow: hidden;
        }

            .kc::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--acc,#1d4ed8);
            }

        .kv {
            font-size: 1.55rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 5px;
        }

        .kl {
            font-size: .68rem;
            color: var(--muted);
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .tb {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: .82rem;
            text-decoration: none;
            border: 1px solid var(--border);
            color: var(--muted);
            background: #fff;
            transition: all .18s;
        }

            .tb:hover {
                border-color: #1d4ed8;
                color: #1d4ed8;
            }

            .tb.on {
                background: #1d4ed8;
                color: #fff;
                border-color: #1d4ed8;
                font-weight: 600;
            }

        .card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: 0 2px 8px rgba(15,23,42,.05);
        }

        .ct {
            font-size: .8rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .ct span {
                color: var(--muted);
                font-size: .74rem;
                font-weight: 400;
            }

        .ca {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: #f8fafc;
            margin-bottom: 8px;
        }

            .ca.td {
                border-color: #1d4ed8;
                background: #eff6ff;
            }

            .ca.tm {
                border-color: rgba(29,78,216,.3);
                background: #f8faff;
            }

        .ct-gio {
            font-size: .74rem;
            font-weight: 700;
            color: #1d4ed8;
            background: rgba(29,78,216,.1);
            padding: 4px 10px;
            border-radius: 8px;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .empty {
            text-align: center;
            padding: 18px;
            color: var(--muted);
            font-size: .83rem;
            background: #f8fafc;
            border-radius: 10px;
        }

        .pg {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .pi {
            padding: 14px;
            background: #f8fafc;
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        .pb {
            margin-top: 8px;
            background: rgba(15,23,42,.08);
            border-radius: 4px;
            height: 5px;
            overflow: hidden;
        }

        .pf {
            height: 100%;
            border-radius: 4px;
            background: #1d4ed8;
        }

        .kho {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: .83rem;
            gap: 10px;
        }

            .kho:last-child {
                border-bottom: none;
            }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .kb {
            flex: 1;
            background: rgba(15,23,42,.08);
            border-radius: 4px;
            height: 5px;
            overflow: hidden;
        }

        .kbf {
            height: 100%;
            border-radius: 4px;
        }

        .inp {
            width: 100%;
            background: #f8fafc;
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: .87rem;
        }

            .inp:focus {
                outline: none;
                border-color: #1d4ed8;
                background: #fff;
            }

        .btn-b {
            background: #1d4ed8;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            font-weight: 600;
            font-size: .87rem;
            cursor: pointer;
        }
    </style>
}

<div class="hs">
    <div class="s-hdr">
        <div class="s-ava">@Model.HoTen.FirstOrDefault()</div>
        <div style="flex:1;">
            <div style="color:#fff;font-size:1.1rem;font-weight:700;margin-bottom:4px;">@Model.HoTen.ToUpper()</div>
            <span style="font-size:.7rem;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,.2);color:#fff;">👷 Nhân viên</span>
            <div style="color:rgba(255,255,255,.65);font-size:.78rem;margin-top:5px;">@Model.Email &nbsp;·&nbsp; Gia nhập @Model.NgayTao.ToString("MM/yyyy")</div>
        </div>
        <div style="text-align:right;">
            <div style="color:rgba(255,255,255,.6);font-size:.7rem;">Phụ trách</div>
            <div style="color:#fff;font-size:1.4rem;font-weight:800;">@sanPhanCong.Count <span style="font-size:.8rem;font-weight:400;">sân</span></div>
        </div>
    </div>

    <div class="krow">
        <div class="kc" style="--acc:#1d4ed8;"><div class="kv" style="color:#1d4ed8;">@soCheckIn</div><div class="kl">✅ Check-in</div></div>
        <div class="kc" style="--acc:var(--green);"><div class="kv" style="color:var(--green);">@soCheckOut</div><div class="kl">🏁 Check-out</div></div>
        <div class="kc" style="--acc:#f59e0b;"><div class="kv" style="color:#f59e0b;">@tongGio.ToString("F0")<span style="font-size:.85rem;">h</span></div><div class="kl">⏱ Giờ phục vụ</div></div>
        <div class="kc" style="--acc:var(--danger);"><div class="kv" style="color:var(--danger);">@soSuCo</div><div class="kl">⚠️ Sự cố</div></div>
    </div>

    <div class="tabs">
        <a href="?tab=tongquan" class="tb @(tab == "tongquan" ? "on" : "")">📋 Tổng quan ca</a>
        <a href="?tab=hieusuat" class="tb @(tab == "hieusuat" ? "on" : "")">📊 Hiệu suất</a>
        <a href="?tab=tonkho" class="tb @(tab == "tonkho" ? "on" : "")">📦 Tồn kho</a>
        <a href="?tab=thongtin" class="tb @(tab == "thongtin" ? "on" : "")">👤 Thông tin</a>
        <a href="?tab=baomat" class="tb @(tab == "baomat" ? "on" : "")">🔒 Bảo mật</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (tab == "tongquan")
    {
        <div class="card">
            <div class="ct">📅 HÔM NAY — @DateTime.Today.ToString("dd/MM/yyyy") <span>@homNay.Count ca</span></div>
            @if (!homNay.Any())
            {
                <div class="empty">Không có ca trực hôm nay.</div>
            }
            @foreach (var d in homNay)
            {
                var g = d.KhungGio != null ? $"{d.KhungGio.GioBatDau:HH\\:mm}–{d.KhungGio.GioKetThuc:HH\\:mm}" : "--";
                <div class="ca td">
                    <div class="ct-gio">🔴 @g</div>
                    <div style="flex:1;"><div style="font-weight:600;font-size:.87rem;">@d.KhungGio?.SanBong?.TenSan</div><div style="font-size:.76rem;color:var(--muted);">📍 @d.KhungGio?.SanBong?.Quan &nbsp;·&nbsp; @d.User?.HoTen</div></div>
                    <span class="badge @(d.TrangThai == "DangSuDung" ? "bg-primary" : d.TrangThai == "HoanThanh" ? "bg-success" : "bg-success")">@d.TrangThai</span>
                </div>
            }
        </div>
        <div class="card">
            <div class="ct">📆 NGÀY MAI — @DateTime.Today.AddDays(1).ToString("dd/MM/yyyy") <span>@ngayMai.Count ca</span></div>
            @if (!ngayMai.Any())
            {
                <div class="empty">Không có ca trực ngày mai.</div>
            }
            @foreach (var d in ngayMai)
            {
                var g = d.KhungGio != null ? $"{d.KhungGio.GioBatDau:HH\\:mm}–{d.KhungGio.GioKetThuc:HH\\:mm}" : "--";
                <div class="ca tm">
                    <div class="ct-gio">🟡 @g</div>
                    <div style="flex:1;"><div style="font-weight:600;font-size:.87rem;">@d.KhungGio?.SanBong?.TenSan</div><div style="font-size:.76rem;color:var(--muted);">📍 @d.KhungGio?.SanBong?.Quan</div></div>
                </div>
            }
        </div>
        <div class="card">
            <div class="ct">🏟 SÂN ĐƯỢC PHÂN CÔNG <span>@sanPhanCong.Count sân</span></div>
            @if (!sanPhanCong.Any())
            {
                <div class="empty">Chưa được phân công sân nào.</div>
            }
            @foreach (var s in sanPhanCong)
            {
                <div style="display:flex;align-items:center;gap:12px;padding:12px;border-radius:10px;border:1px solid var(--border);background:#f8fafc;margin-bottom:8px;">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(29,78,216,.1);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">🏟</div>
                    <div style="flex:1;"><div style="font-weight:600;font-size:.87rem;">@s.TenSan</div><div style="font-size:.76rem;color:var(--muted);">📍 @s.DiaChi, @s.Quan &nbsp;·&nbsp; Sân @s.LoaiSan người</div></div>
                    <a href="/Staff/CheckIn" style="font-size:.76rem;padding:5px 12px;border-radius:999px;border:1px solid #1d4ed8;color:#1d4ed8;text-decoration:none;">Check-in →</a>
                </div>
            }
        </div>
    }

    @if (tab == "hieusuat")
    {
        <div class="card">
            <div class="ct">📊 HIỆU SUẤT THÁNG @DateTime.Now.Month/@DateTime.Now.Year <span>@thangNay.Count ca</span></div>
            <div class="pg">
                <div class="pi"><div style="font-size:.72rem;color:var(--muted);margin-bottom:6px;">✅ Ca check-in tháng này</div><div style="font-size:1.4rem;font-weight:800;color:#1d4ed8;">@thangNay.Count(d => d.StaffCheckInId != null)</div><div class="pb"><div class="pf" style="width:@Math.Min(thangNay.Count(d => d.StaffCheckInId != null) * 5, 100)%;"></div></div></div>
                <div class="pi"><div style="font-size:.72rem;color:var(--muted);margin-bottom:6px;">🏁 Ca hoàn thành</div><div style="font-size:1.4rem;font-weight:800;color:var(--green);">@thangNay.Count(d => d.TrangThai == "HoanThanh")</div><div class="pb"><div class="pf" style="width:@Math.Min(thangNay.Count(d => d.TrangThai == "HoanThanh") * 5, 100)%;background:var(--green);"></div></div></div>
                <div class="pi"><div style="font-size:.72rem;color:var(--muted);margin-bottom:6px;">⏱ Tổng giờ phục vụ</div><div style="font-size:1.4rem;font-weight:800;color:#f59e0b;">@tongGioThang.ToString("F0")h</div><div class="pb"><div class="pf" style="width:@Math.Min(tongGioThang * 2, 100)%;background:#f59e0b;"></div></div></div>
                <div class="pi"><div style="font-size:.72rem;color:var(--muted);margin-bottom:6px;">⚠️ Sự cố ghi nhận</div><div style="font-size:1.4rem;font-weight:800;color:var(--danger);">@soSuCo</div><div class="pb"><div class="pf" style="width:@Math.Min(soSuCo * 20, 100)%;background:var(--danger);"></div></div></div>
            </div>
        </div>
        <div class="card">
            <div class="ct">📋 10 CA GẦN NHẤT</div>
            @foreach (var d in lichSuCa.Take(10))
            {
                var g = d.KhungGio != null ? $"{d.KhungGio.GioBatDau:HH\\:mm}–{d.KhungGio.GioKetThuc:HH\\:mm}" : "--";
                var gh = d.KhungGio != null ? (d.KhungGio.GioKetThuc - d.KhungGio.GioBatDau).TotalHours.ToString("F1") + "h" : "--";
                <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--border);font-size:.83rem;">
                    <div><div style="font-weight:600;color:var(--text);">@d.KhungGio?.SanBong?.TenSan</div><div style="color:var(--muted);font-size:.76rem;">@d.NgayThiDau.ToString("dd/MM/yyyy") @g &nbsp;·&nbsp; @gh</div></div>
                    <span class="badge @(d.TrangThai == "HoanThanh" ? "bg-success" : d.TrangThai == "DaHuy" ? "bg-danger" : "bg-primary")">@d.TrangThai</span>
                </div>
            }
        </div>
    }

    @if (tab == "tonkho")
    {
        <div class="card">
            <div class="ct">📦 TỒN KHO CÁC SÂN PHỤ TRÁCH <span style="color:var(--danger);">🔴 &lt;5 &nbsp;🟡 &lt;20 &nbsp;🟢 Đủ</span></div>
            @{
                var dvBySan = ViewBag.DichVuBySan as Dictionary<int, List<Web_Stadium.EFCore.DichVu>>;
            }
            @foreach (var san in sanPhanCong)
            {
                var dvs = dvBySan?.GetValueOrDefault(san.Id) ?? new();
                <div style="margin-bottom:20px;">
                    <div style="font-weight:700;font-size:.87rem;color:var(--text);margin-bottom:10px;padding:8px 12px;background:#f0f4f8;border-radius:8px;">🏟 @san.TenSan</div>
                    @if (!dvs.Any())
                    {
                        <div style="color:var(--muted);font-size:.82rem;padding:4px 12px;">Không có dịch vụ.</div>
                    }
                    @foreach (var dv in dvs)
                    {
                        var dc = dv.TonKho < 5 ? "var(--danger)" : dv.TonKho < 20 ? "#f59e0b" : "var(--green)";
                        var bw = Math.Min(dv.TonKho * 2, 100);
                        <div class="kho">
                            <div class="dot" style="background:@dc;"></div>
                            <span style="flex:1;color:var(--text);font-weight:500;">@dv.TenDichVu</span>
                            <div class="kb"><div class="kbf" style="width:@bw%;background:@dc;"></div></div>
                            <div style="min-width:64px;text-align:right;font-weight:700;color:@dc;">@dv.TonKho <span style="font-size:.7rem;color:var(--muted);font-weight:400;">đv</span></div>
                            @if (dv.TonKho < 5)
                            {
                                <span class="badge bg-danger" style="font-size:.65rem;">SẮP HẾT</span>
                            }
                        </div>
                    }
                </div>
            }
            <div style="font-size:.76rem;color:var(--muted);padding-top:8px;border-top:1px solid var(--border);">ℹ️ Kho chỉ trừ khi Check-in hoặc bán POS. Liên hệ Owner để nhập thêm.</div>
        </div>
    }

    @if (tab == "thongtin")
    {
        <div class="card">
            <div class="ct">👤 THÔNG TIN CÁ NHÂN</div>
            <form method="post" action="/Staff/CapNhatThongTin">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Họ và tên</label><input name="hoTen" class="inp mt-1" value="@Model.HoTen" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Email</label><input class="inp mt-1" value="@Model.Email" disabled /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Số điện thoại</label><input name="soDienThoai" class="inp mt-1" value="@Model.SoDienThoai" /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Vai trò</label><input class="inp mt-1" value="Nhân viên (Staff)" disabled /></div>
                    <div class="col-12"><button type="submit" class="btn-b">✓ Lưu thay đổi</button></div>
                </div>
            </form>
        </div>
    }

    @if (tab == "baomat")
    {
        <div class="card">
            <div class="ct">🔒 ĐỔI MẬT KHẨU</div>
            <form method="post" action="/Staff/DoiMatKhau">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu hiện tại</label><input type="password" name="matKhauCu" class="inp mt-1" placeholder="••••••••" required /></div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu mới</label><input type="password" name="matKhauMoi" class="inp mt-1" placeholder="Tối thiểu 6 ký tự" minlength="6" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Xác nhận</label><input type="password" name="xacNhanMatKhau" class="inp mt-1" placeholder="Nhập lại" required /></div>
                    <div class="col-12"><button type="submit" class="btn-b">🔒 Đổi mật khẩu</button></div>
                </div>
            </form>
        </div>
    }
</div>

@await Html.PartialAsync("_StaffWidgets")

@section Scripts {
    <script>
        window.__STAFF_SAN_IDS = [];
    </script>
}
