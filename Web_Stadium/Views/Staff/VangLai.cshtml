@{
    ViewData["Title"] = "Đơn vãng lai";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.NavActivePage = "vanglai";
    var danhSachDV = ViewBag.DanhSachDichVu as List<Web_Stadium.EFCore.DichVu> ?? new();
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Staff — Bán lẻ</div>
        <h1 style="font-style:italic;line-height:0.9">ĐƠN VÃNG LAI<br><span class="text-green">BÁN LẺ ĐỘC LẬP</span></h1>
        <p style="color:var(--muted);margin-top:8px;font-size:14px;">
            Tách biệt hoàn toàn khỏi các booking đã đóng — không ảnh hưởng báo cáo kế toán
        </p>
    </div>
</div>

@await Html.PartialAsync("_StaffNav")

<div class="container py-5">

    @await Html.PartialAsync("_StaffAlerts")

    @*-- Đơn vãng lai: không liên kết booking, chỉ trừ kho + ghi AuditLog --*@
    <div style="background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.25);
                border-radius:12px;padding:14px 18px;margin-bottom:24px;font-size:13px;color:#aaa;">
        <strong style="color:#818cf8;">📦 Đơn vãng lai là gì?</strong><br>
        Khi khách quay lại mua thêm sau khi đơn đặt sân đã được chốt (Hoàn thành),
        hoặc khách vãng lai không có booking — dùng màn hình này.
        Kho trừ ngay, doanh thu ghi vào ca, <strong>không liên kết booking nào.</strong>
    </div>

    <div class="row g-4">

        <!-- CỘT TRÁI: Chọn dịch vụ -->
        <div class="col-md-7">
            <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:14px;">
                CHỌN DỊCH VỤ BÁN LẺ
            </div>

            @if (!danhSachDV.Any())
            {
                <div class="section-card p-4 text-center" style="color:var(--muted)">
                    <div style="font-size:2rem;margin-bottom:8px;">📦</div>
                    Không có dịch vụ nào trong kho. Liên hệ Owner để cập nhật tồn kho.
                </div>
            }
            else
            {
                <form method="post" action="/Staff/ThucHienVangLai" id="formVangLai">
                    @Html.AntiForgeryToken()
                    <div class="row g-3" id="dvGrid">
                        @{
                            int idx = 0;
                        }
                        @foreach (var dv in danhSachDV)
                        {
                            <div class="col-6">
                                <div class="section-card p-3" style="cursor:pointer;transition:border-color .2s;"
                                     id="dvCard-@idx"
                                     onclick="toggleDV(@idx, @dv.Id, @dv.Gia)">
                                    <div style="font-size:11px;color:var(--muted);margin-bottom:4px;">
                                        Còn: <span style="color:@(dv.TonKho < 5 ? "#e74c3c" : "var(--green)")">@dv.TonKho</span>
                                        &nbsp;·&nbsp; @(dv.SanBong?.TenSan ?? "")
                                    </div>
                                    <div style="font-weight:600;margin-bottom:4px;">@dv.TenDichVu</div>
                                    <div style="color:var(--green);font-size:14px;margin-bottom:10px;">
                                        @dv.Gia.ToString("N0")đ
                                    </div>
                                    <div style="display:flex;align-items:center;gap:8px;" onclick="event.stopPropagation()">
                                        <input type="hidden" name="dichVuIds" value="@dv.Id" id="dvId-@idx" disabled />
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
                                                onclick="changeQtyVL(@idx,-1,@dv.TonKho)">
                                            −
                                        </button>
                                        <span id="qty-@idx" style="min-width:24px;text-align:center;font-weight:700;">0</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
                                                onclick="changeQtyVL(@idx,1,@dv.TonKho)">
                                            +
                                        </button>
                                        <input type="hidden" name="soLuongs" id="sl-@idx" value="0" />
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    </div>

                    <button type="submit" id="btnVangLai"
                            class="btn btn-success w-100 rounded-pill mt-4"
                            style="font-size:15px;padding:12px;font-weight:700;" disabled
                            onclick="return confirm('Xác nhận tạo đơn vãng lai?')">
                        ✅ Tạo đơn vãng lai — Thu <span id="tongVL">0</span>đ
                    </button>
                </form>
            }
        </div>

        <!-- CỘT PHẢI: Tóm tắt -->
        <div class="col-md-5">
            <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:14px;">
                TÓM TẮT ĐƠN
            </div>
            <div class="section-card p-4">
                <div id="summaryEmpty" style="text-align:center;color:var(--muted);padding:20px 0;font-size:13px;">
                    Chưa chọn dịch vụ nào
                </div>
                <div id="summaryList" style="display:none;"></div>
                <div id="summaryTotal" style="display:none;padding-top:12px;border-top:1px solid var(--border);
                     display:flex;justify-content:space-between;font-weight:700;font-size:15px;">
                    <span>Tổng thu</span>
                    <span style="color:var(--green);" id="summaryTotalAmt">0đ</span>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_StaffWidgets")

@section Scripts {
    <script>
        window.__STAFF_SAN_IDS = [];
        var dvGia = [@Html.Raw(string.Join(",", danhSachDV.Select(d => d.Gia)))];
        var dvTen = [@Html.Raw(string.Join(",", danhSachDV.Select(d => $"\"{d.TenDichVu}\"")))];
        var qtyArr = Array(@danhSachDV.Count).fill(0);

        function changeQtyVL(idx, delta, max) {
            var newVal = Math.max(0, Math.min(max, qtyArr[idx] + delta));
            qtyArr[idx] = newVal;
            document.getElementById('qty-' + idx).textContent = newVal;
            document.getElementById('sl-' + idx).value = newVal;

            // Enable/disable input
            var hiddenId = document.getElementById('dvId-' + idx);
            if (newVal > 0) {
                hiddenId.disabled = false;
                document.getElementById('dvCard-' + idx).style.borderColor = 'var(--green)';
            } else {
                hiddenId.disabled = true;
                document.getElementById('dvCard-' + idx).style.borderColor = '';
            }
            updateSummary();
        }

        function toggleDV(idx, dvId, gia) {
            if (qtyArr[idx] === 0) changeQtyVL(idx, 1, 999);
            else changeQtyVL(idx, -qtyArr[idx], 999);
        }

        function updateSummary() {
            var tong = 0;
            var lines = '';
            for (var i = 0; i < qtyArr.length; i++) {
                if (qtyArr[i] > 0) {
                    var sub = dvGia[i] * qtyArr[i];
                    tong += sub;
                    lines += '<div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.05);">'
                           + '<span style="color:#aaa;">' + dvTen[i] + ' ×' + qtyArr[i] + '</span>'
                           + '<span>' + sub.toLocaleString('vi-VN') + 'đ</span>'
                           + '</div>';
                }
            }

            var hasItem = tong > 0;
            document.getElementById('summaryEmpty').style.display = hasItem ? 'none' : 'block';
            document.getElementById('summaryList').style.display = hasItem ? 'block' : 'none';
            document.getElementById('summaryList').innerHTML = lines;

            var totalEl = document.getElementById('summaryTotal');
            totalEl.style.display = hasItem ? 'flex' : 'none';
            document.getElementById('summaryTotalAmt').textContent = tong.toLocaleString('vi-VN') + 'đ';
            document.getElementById('tongVL').textContent = tong.toLocaleString('vi-VN');
            document.getElementById('btnVangLai').disabled = !hasItem;
        }
    </script>
}
