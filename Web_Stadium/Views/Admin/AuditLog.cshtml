@model List<Web_Stadium.EFCore.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="padding:0 0 40px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Bảo mật</div>
        <h2>Audit Log <span class="pg-accent">hành động</span></h2>
        <p>Nhật ký toàn bộ thao tác quản trị trong hệ thống</p>
    </div>

    <!-- BỘ LỌC -->
    <div class="section-card mb-4">
        <form method="get" class="ph-panel-body">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Loại hành động</label>
                    <select name="hanhDong" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var h in ViewBag.DanhSachHanhDong as List<string>)
                        {
                            <option value="@h" selected="@(ViewBag.HanhDong == h)">@h</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="tuNgay" class="form-control" value="@ViewBag.TuNgay" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="denNgay" class="form-control" value="@ViewBag.DenNgay" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-search me-1"></i>Lọc
                    </button>
                    <a href="/Admin/AuditLog" class="btn btn-outline-secondary">Reset</a>
                </div>
                <div class="col-auto ms-auto d-flex align-items-end">
                    <small style="color:var(--muted);">Tổng: <strong style="color:var(--text);">@ViewBag.TongSo</strong> bản ghi</small>
                </div>
            </div>
        </form>
    </div>

    <!-- BẢNG -->
    <div class="section-card">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Người thực hiện</th>
                        <th>Vai trò</th>
                        <th>Hành động</th>
                        <th>Đối tượng</th>
                        <th>Mô tả</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td><small style="color:var(--muted);">@log.ThoiGian.ToString("dd/MM HH:mm:ss")</small></td>
                            <td>
                                <div style="font-weight:700;font-size:13px;">@log.User?.HoTen</div>
                                <small style="color:var(--muted);">@log.User?.Email</small>
                            </td>
                            <td>
                                @{
                                    var roleColor = log.VaiTro switch
                                    {
                                        "Admin" => "bg-danger",
                                        "Owner" => "bg-primary",
                                        "Staff" => "bg-warning",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @roleColor">@log.VaiTro</span>
                            </td>
                            <td>
                                @{
                                    var actionColor = log.HanhDong.Contains("Khoa") || log.HanhDong.Contains("TuChoi")
                                    ? "var(--danger)"
                                    : log.HanhDong.Contains("MoKhoa") || log.HanhDong.Contains("PheDuyet") || log.HanhDong.Contains("HoanCoc")
                                    ? "var(--green2)"
                                    : "var(--blue)";
                                }
                                <span style="color:@actionColor;font-weight:700;font-size:12px;">@log.HanhDong</span>
                            </td>
                            <td>
                                <span class="badge bg-light">@log.DoiTuong #@log.DoiTuongId</span>
                            </td>
                            <td><small style="color:var(--muted);">@log.MoTa</small></td>
                            <td><small style="color:var(--muted2);">@log.IpAddress</small></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;color:var(--muted);padding:40px;">
                                Không có dữ liệu log.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if ((int)ViewBag.TongTrang > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= (int)ViewBag.TongTrang; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.Trang ? "active" : "")">
                        <a class="page-link"
                           href="/Admin/AuditLog?trang=@i&hanhDong=@ViewBag.HanhDong&tuNgay=@ViewBag.TuNgay&denNgay=@ViewBag.DenNgay">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
