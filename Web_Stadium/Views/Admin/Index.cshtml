@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .admin-main {
            padding: 28px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 28px;
        }

        .topbar-left h2 {
            font-size: 36px;
            line-height: 1;
            color: #f5f7fa;
        }

        .topbar-left p {
            color: #8fa1b7;
            margin-top: 10px;
            font-size: 14px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .search-box {
            background: #121923;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 18px;
            padding: 13px 18px;
            color: white;
            min-width: 260px;
            outline: none;
            font-size: 14px;
        }

        .btn-main {
            border: none;
            border-radius: 18px;
            background: linear-gradient(135deg,#00d47e,#00a96b);
            color: #07120c;
            padding: 13px 22px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 12px 24px rgba(0,212,126,.22);
            transition: .25s;
            white-space: nowrap;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-main:hover {
                transform: translateY(-2px);
                color: #07120c;
            }

        .hero {
            background: linear-gradient(135deg,#111927 0%,#0f1b16 100%);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 32px;
            padding: 34px;
            margin-bottom: 28px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 35px rgba(0,0,0,.35);
        }

            .hero::before {
                content: "";
                position: absolute;
                width: 350px;
                height: 350px;
                border-radius: 50%;
                background: radial-gradient(circle,rgba(0,212,126,.20),transparent 70%);
                top: -120px;
                right: -120px;
            }

        .hero-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            position: relative;
            z-index: 2;
        }

        .hero h3 {
            font-size: 36px;
            line-height: 1.1;
            margin-bottom: 18px;
            color: #f5f7fa;
        }

        .hero p {
            color: #8fa1b7;
            max-width: 650px;
            line-height: 1.7;
            font-size: 15px;
        }

        .live-box {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.05);
            border-radius: 28px;
            padding: 24px;
        }

        .live-top {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            align-items: center;
        }

        .live-badge {
            background: rgba(0,212,126,.15);
            color: #00ff99;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

        .live-num {
            font-size: 52px;
            font-weight: 800;
            color: #f5f7fa;
        }

        .live-desc {
            color: #8fa1b7;
            margin-top: 10px;
            font-size: 13px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 18px;
            margin-bottom: 28px;
        }

        .kpi-card {
            background: #121923;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 28px;
            padding: 24px;
            transition: .25s;
            box-shadow: 0 10px 35px rgba(0,0,0,.35);
        }

            .kpi-card:hover {
                transform: translateY(-4px);
                border-color: rgba(0,212,126,.18);
            }

            .kpi-card.warn {
                border-color: rgba(246,170,56,.25);
            }

            .kpi-card.danger {
                border-color: rgba(255,93,115,.25);
            }

        .kpi-label {
            color: #8fa1b7;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .kpi-value {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 10px;
            line-height: 1;
            color: #f5f7fa;
        }

            .kpi-value.green {
                color: #00ff99;
            }

            .kpi-value.blue {
                color: #6caee0;
            }

            .kpi-value.yellow {
                color: #f6aa38;
            }

            .kpi-value.red {
                color: #ff5d73;
            }

        .kpi-trend {
            color: #00ff99;
            font-size: 13px;
            font-weight: 700;
        }

            .kpi-trend.warn {
                color: #f6aa38;
            }

            .kpi-trend.danger {
                color: #ff5d73;
            }

        .content-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 24px;
            margin-bottom: 28px;
        }

        .panel {
            background: #121923;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 30px;
            padding: 26px;
            box-shadow: 0 10px 35px rgba(0,0,0,.35);
        }

        .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

            .panel-head h4 {
                font-size: 18px;
                font-weight: 700;
                color: #f5f7fa;
            }

        .panel-muted {
            color: #8fa1b7;
            font-size: 13px;
        }

        .table-modern {
            width: 100%;
            border-collapse: collapse;
        }

            .table-modern tr {
                border-bottom: 1px solid rgba(255,255,255,.05);
            }

                .table-modern tr:last-child {
                    border-bottom: none;
                }

            .table-modern td {
                padding: 16px 0;
                vertical-align: middle;
            }

        .player {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            flex-shrink: 0;
            background: linear-gradient(135deg,#1f2937,#0f172a);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            font-size: 14px;
        }

        .player-name {
            font-weight: 700;
            font-size: 14px;
            color: #f5f7fa;
        }

        .player-club {
            color: #8fa1b7;
            margin-top: 3px;
            font-size: 12px;
        }

        .status {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

            .status.ok {
                background: rgba(0,212,126,.12);
                color: #00ff99;
            }

            .status.warn {
                background: rgba(255,93,115,.12);
                color: #ff5d73;
            }

            .status.mid {
                background: rgba(246,170,56,.12);
                color: #f6aa38;
            }

        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .activity-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .activity-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: rgba(255,255,255,.05);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .activity-item strong {
            font-size: 14px;
            color: #f5f7fa;
        }

        .activity-item p {
            color: #8fa1b7;
            margin-top: 4px;
            line-height: 1.6;
            font-size: 13px;
        }

        .activity-time {
            font-size: 11px;
            color: #8fa1b7;
            margin-top: 3px;
        }

        .chart-wrap {
            background: #121923;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 30px;
            padding: 26px;
            margin-bottom: 28px;
            box-shadow: 0 10px 35px rgba(0,0,0,.35);
        }

        .qa-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .qa-card {
            background: #121923;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 24px;
            padding: 20px;
            text-decoration: none;
            display: block;
            transition: .22s;
        }

            .qa-card:hover {
                border-color: rgba(0,212,126,.35);
                transform: translateY(-3px);
            }

                .qa-card:hover .qa-icon {
                    transform: scale(1.15);
                }

        .qa-icon {
            font-size: 1.8rem;
            margin-bottom: 10px;
            transition: transform .2s;
        }

        .qa-name {
            font-weight: 700;
            font-size: 14px;
            color: #f5f7fa;
            margin-bottom: 4px;
        }

        .qa-desc {
            font-size: 12px;
            color: #8fa1b7;
            line-height: 1.5;
        }

        @@media(max-width:1200px) {
            .hero-grid, .content-grid {
                grid-template-columns: 1fr;
            }

            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .qa-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:850px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-box {
                min-width: 100%;
            }
        }
    </style>
}

<!-- TOPBAR -->
<div class="topbar">
    <div class="topbar-left">
        <h2>Control Center</h2>
        <p>Tổng quan hệ thống PitchHub — @DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
    </div>
    <div class="topbar-actions">
        <input class="search-box" placeholder="Tìm sân, người dùng, báo cáo..." />
        <a href="/Admin/BaoCao" class="btn-main">📈 Báo cáo</a>
    </div>
</div>

<!-- HERO -->
<section class="hero">
    <div class="hero-grid">
        <div>
            <h3>Nền tảng đặt sân bóng<br />thông minh 2026.</h3>
            <p>Quản lý sân, chủ sân, người dùng, doanh thu và toàn bộ hoạt động hệ thống PitchHub từ một trung tâm điều hành duy nhất.</p>
        </div>
        <div class="live-box">
            <div class="live-top">
                <strong style="color:#f5f7fa;">Hệ thống</strong>
                <span class="live-badge">ONLINE</span>
            </div>
            <div class="live-num">@ViewBag.TongSan</div>
            <div class="live-desc">Tổng sân đang hoạt động</div>
        </div>
    </div>
</section>

<!-- KPI -->
<section class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-label">Lượt đặt sân</div>
        <div class="kpi-value blue">@ViewBag.TongDatSan</div>
        <div class="kpi-trend">Tất cả thời gian</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Người dùng</div>
        <div class="kpi-value green">@ViewBag.TongUser</div>
        <div class="kpi-trend">Đang hoạt động</div>
    </div>
    <div class="kpi-card warn">
        <div class="kpi-label">Chờ duyệt sân</div>
        <div class="kpi-value yellow">@ViewBag.ChoPheDuyet</div>
        <div class="kpi-trend warn">@(ViewBag.ChoPheDuyet > 0 ? "Cần xử lý" : "Không có")</div>
    </div>
    <div class="kpi-card @(ViewBag.KhieuNaiChoXuLy > 0 ? "danger" : "")">
        <div class="kpi-label">Khiếu nại chờ</div>
        <div class="kpi-value @(ViewBag.KhieuNaiChoXuLy > 0 ? "red" : "green")">@ViewBag.KhieuNaiChoXuLy</div>
        <div class="kpi-trend @(ViewBag.KhieuNaiChoXuLy > 0 ? "danger" : "")">
            @(ViewBag.KhieuNaiChoXuLy > 0 ? "Cần xử lý ngay" : "Không có khiếu nại")
        </div>
    </div>
</section>

<!-- TOP OWNERS + ACTIVITY -->
<section class="content-grid">
    <div class="panel">
        <div class="panel-head">
            <h4>Top chủ sân</h4>
            <span class="panel-muted">Theo số sân đã duyệt</span>
        </div>
        <table class="table-modern">
            @if (ViewBag.TopOwners != null)
            {
                foreach (var o in ViewBag.TopOwners)
                {
                    var initials = string.Join("",
                    ((string)o.HoTen).Split(' ')
                    .Where(w => w.Length > 0).TakeLast(2)
                    .Select(w => w[0].ToString().ToUpper()));
                    var statusClass = (int)o.SoSan >= 5 ? "ok" : (int)o.SoSan >= 2 ? "mid" : "warn";
                    var statusText = (int)o.SoSan >= 5 ? "Elite" : (int)o.SoSan >= 2 ? "Active" : "New";
                    <tr>
                        <td>
                            <div class="player">
                                <div class="avatar">@initials</div>
                                <div>
                                    <div class="player-name">@o.HoTen</div>
                                    <div class="player-club">@o.Email</div>
                                </div>
                            </div>
                        </td>
                        <td style="color:#00ff99;font-weight:700;font-size:14px;">@o.SoSan sân</td>
                        <td><span class="status @statusClass">@statusText</span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3" style="color:#8fa1b7;font-size:14px;padding:20px 0;">Chưa có dữ liệu</td></tr>
            }
        </table>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h4>Hoạt động gần đây</h4>
            <a href="/Admin/AuditLog" style="color:#00d47e;font-size:13px;text-decoration:none;">Xem tất cả →</a>
        </div>
        <div class="activity-list">
            @if (ViewBag.RecentActivity != null)
            {
                foreach (var log in ViewBag.RecentActivity)
                {
                    var icon = ((string)log.HanhDong) switch
                    {
                        "PheDuyetSan" => "✅",
                        "TuChoiSan" => "❌",
                        "KhoaTaiKhoan" => "🔒",
                        "MoKhoaTaiKhoan" => "🔓",
                        "DoiVaiTro" => "👤",
                        "ThemVung" => "🗺️",
                        "GanQuanVaoVung" => "📍",
                        _ => "🛡️"
                    };
                    var thoiGian = (DateTime)log.ThoiGian;
                    var diff = DateTime.Now - thoiGian;
                    var timeStr = diff.TotalMinutes < 60
                    ? (int)diff.TotalMinutes + " phút trước"
                    : diff.TotalHours < 24
                    ? (int)diff.TotalHours + " giờ trước"
                    : thoiGian.ToString("dd/MM HH:mm");
                    <div class="activity-item">
                        <div class="activity-icon">@icon</div>
                        <div style="flex:1;min-width:0;">
                            <strong>@log.HanhDong</strong>
                            <p style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@log.MoTa</p>
                            <div class="activity-time">@timeStr</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="color:#8fa1b7;font-size:14px;">Chưa có hoạt động</div>
            }
        </div>
    </div>
</section>

<!-- BIỂU ĐỒ -->
<div class="chart-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <div>
            <div style="font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#8fa1b7;">
                Doanh thu 6 tháng gần nhất
            </div>
            <div style="font-size:12px;color:#8fa1b7;margin-top:4px;">Triệu VND</div>
        </div>
        <a href="/Admin/BaoCao" style="font-size:13px;color:#00d47e;text-decoration:none;font-weight:700;">
            Báo cáo đầy đủ →
        </a>
    </div>
    <div style="position:relative;height:240px;width:100%;">
        <canvas id="chartMini" style="display:block;"></canvas>
    </div>
</div>

<!-- QUICK ACCESS -->
<div style="margin-bottom:8px;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#8fa1b7;">
    Truy cập nhanh
</div>
<div class="qa-grid">
    <a href="/Admin/DuyetSan" class="qa-card">
        <div class="qa-icon">🏟️</div>
        <div class="qa-name">Duyệt sân</div>
        <div class="qa-desc">Phê duyệt Owner đăng ký sân mới</div>
    </a>
    <a href="/Admin/QuanLyUser" class="qa-card">
        <div class="qa-icon">👥</div>
        <div class="qa-name">Tài khoản</div>
        <div class="qa-desc">Quản lý, khoá/mở tài khoản người dùng</div>
    </a>
    <a href="/Admin/MasterData" class="qa-card">
        <div class="qa-icon">🗂️</div>
        <div class="qa-name">Master Data</div>
        <div class="qa-desc">Quận/Huyện, loại sân, danh mục dịch vụ</div>
    </a>
    <a href="/Admin/KhieuNai" class="qa-card">
        <div class="qa-icon">⚠️</div>
        <div class="qa-name">Khiếu nại</div>
        <div class="qa-desc">Xử lý hoàn cọc User theo yêu cầu</div>
    </a>
    <a href="/Admin/BaoCao" class="qa-card">
        <div class="qa-icon">📈</div>
        <div class="qa-name">Báo cáo</div>
        <div class="qa-desc">Doanh thu toàn hệ thống theo năm</div>
    </a>
    <a href="/Admin/AuditLog" class="qa-card">
        <div class="qa-icon">🛡️</div>
        <div class="qa-name">Audit Log</div>
        <div class="qa-desc">Nhật ký hành động bảo mật</div>
    </a>
    <a href="/Admin/TatCaHopDong" class="qa-card">
        <div class="qa-icon">📑</div>
        <div class="qa-name">Hợp đồng</div>
        <div class="qa-desc">Tất cả hợp đồng chủ sân</div>
    </a>
    <a href="/Venues" class="qa-card">
        <div class="qa-icon">🔍</div>
        <div class="qa-name">Xem trang chủ</div>
        <div class="qa-desc">Giao diện người dùng PitchHub</div>
    </a>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script>
        (function() {
            @if (ViewBag.DoanhThu6Thang != null)
            {
                    var labels6 = Newtonsoft.Json.JsonConvert.SerializeObject(
                            ((System.Collections.Generic.List<object>)ViewBag.DoanhThu6Thang)
                            .Select(x => ((dynamic)x).thang));
                    var data6 = Newtonsoft.Json.JsonConvert.SerializeObject(
                            ((System.Collections.Generic.List<object>)ViewBag.DoanhThu6Thang)
                            .Select(x => Math.Round((double)((dynamic)x).dt / 1_000_000, 2)));
                    <text>
                    var chartLabels = @Html.Raw(labels6);
                    var chartData   = @Html.Raw(data6);
                    </text>
            }
            else
            {
                    <text>
                    // Fallback: hiển thị 6 tháng gần nhất với data = 0
                    var now = new Date();
                    var chartLabels = [];
                    for (var i = 5; i >= 0; i--) {
                        var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                        chartLabels.push(('0'+(d.getMonth()+1)).slice(-2) + '/' + d.getFullYear());
                    }
                    var chartData = [0, 0, 0, 0, 0, 0];
                    </text>
            }

            var ctxEl = document.getElementById('chartMini');
            if (!ctxEl) return;

            new Chart(ctxEl, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Triệu VND',
                        data: chartData,
                        backgroundColor: function(ctx) {
                            var grad = ctx.chart.ctx.createLinearGradient(0, 0, 0, 220);
                            grad.addColorStop(0, 'rgba(0,212,126,0.55)');
                            grad.addColorStop(1, 'rgba(0,212,126,0.05)');
                            return grad;
                        },
                        borderColor: '#00d47e',
                        borderWidth: 2,
                        borderRadius: 10,
                        borderSkipped: false,
                        hoverBackgroundColor: 'rgba(0,255,153,0.45)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 900, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a2535',
                            borderColor: 'rgba(0,212,126,.3)',
                            borderWidth: 1,
                            titleColor: '#8fa1b7',
                            bodyColor: '#00ff99',
                            bodyFont: { size: 14, weight: 'bold' },
                            callbacks: { label: function(ctx) { return ctx.parsed.y + ' triệu VND'; } }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                            ticks: { color: '#8fa1b7', font: { size: 12 } },
                            border: { display: false }
                        },
                        y: {
                            grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                            ticks: { color: '#8fa1b7', font: { size: 12 }, callback: function(v) { return v + 'M'; } },
                            border: { display: false },
                            beginAtZero: true
                        }
                    }
                }
            });
        })();
    </script>
}
