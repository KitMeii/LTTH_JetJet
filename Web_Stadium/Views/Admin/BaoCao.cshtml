@{
    ViewData["Title"] = "Báo cáo Doanh thu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var data = (ViewBag.Data as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var xepHang = (ViewBag.XepHangSan as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var lapDay = (ViewBag.TyLeLapDay as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();

    var loai = (string)(ViewBag.Loai ?? "thang");
    var nam = (int)(ViewBag.Nam ?? DateTime.Now.Year);
    var thang = (int)(ViewBag.Thang ?? DateTime.Now.Month);
    var tieuDe = (string)(ViewBag.TieuDe ?? "");

    double tongPhi = (double)(ViewBag.TongPhiHoaHong ?? 0.0);
    double tongDTSan = (double)(ViewBag.TongDoanhThuSan ?? 0.0);
    int tongLuot = (int)(ViewBag.TongLuot ?? 0);

    string J(double v) => v.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    string JS(string s) => s.Replace("\"", "'");

    var lblMain = "[" + string.Join(",", data.Select(d => { try { return "\"" + JS((string)d.nhan) + "\""; } catch { return "\"?\""; } })) + "]";
    var dtSanArr = "[" + string.Join(",", data.Select(d => { try { return J((double)d.dtSan / 1_000_000); } catch { return "0"; } })) + "]";
    var phiArr = "[" + string.Join(",", data.Select(d => { try { return J((double)d.phi / 1_000_000); } catch { return "0"; } })) + "]";
    var luotArr = "[" + string.Join(",", data.Select(d => { try { return ((int)d.soLuot).ToString(); } catch { return "0"; } })) + "]";
    var kaArr = "[" + string.Join(",", data.Select(d => { try { return ((int)d.soKA).ToString(); } catch { return "0"; } })) + "]";
    var kbArr = "[" + string.Join(",", data.Select(d => { try { return ((int)d.soKB).ToString(); } catch { return "0"; } })) + "]";

    var top10 = xepHang.Take(10).ToList();
    var top5Data = xepHang.Take(5).ToList();
    var lblSan = "[" + string.Join(",", top5Data.Select(o => { try { return "\"" + JS((string)o.TenSan) + "\""; } catch { return "\"?\""; } })) + "]";
    var dtSan2 = "[" + string.Join(",", top5Data.Select(o => { try { return J((double)o.TongDT / 1_000_000); } catch { return "0"; } })) + "]";
    var luotSan2 = "[" + string.Join(",", top5Data.Select(o => { try { return ((int)o.SoLuot).ToString(); } catch { return "0"; } })) + "]";
    var phiSan2 = "[" + string.Join(",", top10.Select(o => { try { return J((double)o.PhiHoaHong / 1_000_000); } catch { return "0"; } })) + "]";

    var top12ld = lapDay.Take(12).ToList();
    var lblLd = "[" + string.Join(",", top12ld.Select(s => { try { var t = (string)s.Ten; return "\"" + JS(t.Length > 12 ? t[..12] + "..." : t) + "\""; } catch { return "\"?\""; } })) + "]";
    var ldArr = "[" + string.Join(",", top12ld.Select(s => { try { int t = (int)s.Tong, d = (int)s.DaDat; return t > 0 ? J((double)d / t * 100) : "0"; } catch { return "0"; } })) + "]";

    var byOwner = xepHang
        .GroupBy(o => { try { return (string)o.Owner; } catch { return "?"; } })
        .Select(g => new { ten = g.Key, phi = g.Sum(o => { try { return (double)o.PhiHoaHong; } catch { return 0.0; } }) })
        .OrderByDescending(x => x.phi).Take(8).ToList();
    var lblOwner = "[" + string.Join(",", byOwner.Select(o => "\"" + JS(o.ten.Length > 14 ? o.ten[..14] + "..." : o.ten) + "\"")) + "]";
    var phiOwner = "[" + string.Join(",", byOwner.Select(o => J(o.phi / 1_000_000))) + "]";
    var ldArrJs = "[" + string.Join(",", top12ld.Select(s => { try { int t = (int)s.Tong, d = (int)s.DaDat; return t > 0 ? J((double)d / t * 100) : "0"; } catch { return "0"; } })) + "]";
}

@section Styles {
    <style>
        :root {
            --bg: #0a0f1a;
            --bg2: #0f1729;
            --card: rgba(255,255,255,.045);
            --card2: rgba(255,255,255,.025);
            --line: rgba(255,255,255,.06);
            --line2: rgba(255,255,255,.03);
            --txt: #f1f5f9;
            --muted: #94a3b8;
            --dim: #64748b;
            --green: #22c55e;
            --blue: #60a5fa;
            --violet: #8b5cf6;
            --cyan: #22d3ee;
            --amber: #f59e0b;
            --red: #ef4444;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: var(--bg);
            color: var(--txt);
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: radial-gradient(circle at top left, rgba(34,197,94,.12), transparent 30%), radial-gradient(circle at top right, rgba(96,165,250,.10), transparent 28%), radial-gradient(circle at bottom, rgba(139,92,246,.10), transparent 32%);
                pointer-events: none;
                z-index: -1;
            }

        .bc-shell {
            display: grid;
            grid-template-columns: 220px 1fr;
            min-height: 100vh;
        }

        .bc-sb {
            background: rgba(255,255,255,.03);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255,255,255,.05);
            padding: 24px 14px;
        }

        .sbt {
            font-size: .65rem;
            color: var(--dim);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0 8px;
            margin: 18px 0 10px;
        }

        .sbl {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 14px;
            font-size: .84rem;
            text-decoration: none;
            color: var(--muted);
            transition: all .2s ease;
            margin-bottom: 6px;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

            .sbl:hover {
                background: rgba(255,255,255,.05);
                color: white;
                transform: translateX(2px);
            }

            .sbl.active {
                background: linear-gradient(90deg, rgba(34,197,94,.16), rgba(34,197,94,.06));
                border: 1px solid rgba(34,197,94,.22);
                color: #fff;
            }

        .sbsel {
            width: 100%;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.06);
            color: #fff;
            border-radius: 14px;
            padding: 10px 12px;
            font-size: .82rem;
            margin-bottom: 10px;
            outline: none;
        }

        .bc-main {
            padding: 30px;
        }

        .krow {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 24px;
            margin-bottom: 28px;
        }

        .cc, .kc {
            background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));
            border: 1px solid rgba(255,255,255,.06);
            backdrop-filter: blur(18px);
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.03);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
            padding: 24px;
            position: relative;
            overflow: hidden;
        }

            .cc:hover, .kc:hover {
                transform: translateY(-4px);
                border-color: rgba(255,255,255,.12);
                box-shadow: 0 20px 45px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.04);
            }

            .kc::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--acc);
                filter: blur(.4px);
                box-shadow: 0 0 18px var(--acc);
            }

        .klbl {
            font-size: .68rem;
            color: var(--muted);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .kval {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
            color: white;
            line-height: 1;
        }

            .kval span {
                font-size: .8rem;
                color: var(--muted);
            }

        .ksub {
            font-size: .76rem;
            color: var(--dim);
            margin-top: 8px;
        }

        .kico {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 2.5rem;
            opacity: .06;
        }

        .cg2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        .cg3 {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        .ch {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .ct {
            font-size: .7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 600;
        }

        .cbg {
            font-size: .7rem;
            padding: 5px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.05);
            color: #fff;
            border: 1px solid rgba(255,255,255,.05);
        }

        .sdiv {
            font-size: .68rem;
            color: var(--dim);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 2px 0 14px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .sdiv::after {
                content: '';
                flex: 1;
                height: 1px;
                background: rgba(255,255,255,.05);
            }

        .rtbl {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
            font-size: .84rem;
        }

            .rtbl thead th {
                position: sticky;
                top: 0;
                background: #0f172a;
                z-index: 5;
                padding: 12px;
                text-align: left;
                font-size: .68rem;
                color: var(--dim);
                letter-spacing: 2px;
                text-transform: uppercase;
                font-weight: 600;
            }

            .rtbl tbody tr {
                transition: all .18s ease;
            }

                .rtbl tbody tr:hover {
                    transform: scale(1.01);
                    background: linear-gradient(90deg, rgba(255,255,255,.03), transparent);
                }

            .rtbl tbody td {
                padding: 14px 12px;
                background: rgba(255,255,255,.025);
                border-top: 1px solid rgba(255,255,255,.03);
                border-bottom: 1px solid rgba(255,255,255,.03);
                color: var(--muted);
            }

                .rtbl tbody td:first-child {
                    border-radius: 14px 0 0 14px;
                }

                .rtbl tbody td:last-child {
                    border-radius: 0 14px 14px 0;
                }

        .rn {
            font-weight: 800;
            color: var(--green);
            font-family: monospace;
        }

        .rs {
            color: white;
            font-weight: 600;
        }

        .pw {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pb {
            flex: 1;
            height: 8px;
            background: rgba(255,255,255,.06);
            border-radius: 999px;
            overflow: hidden;
        }

        .pf {
            height: 100%;
            border-radius: 999px;
        }

        .pl {
            font-size: .72rem;
            padding: 4px 10px;
            border-radius: 999px;
            font-weight: 700;
        }

            .pl.g {
                background: rgba(34,197,94,.12);
                color: var(--green);
            }

            .pl.r {
                background: rgba(239,68,68,.12);
                color: var(--red);
            }

            .pl.b {
                background: rgba(96,165,250,.12);
                color: var(--blue);
            }

        canvas {
            width: 100% !important;
        }

        @@media(max-width:1200px) {
            .krow {
                grid-template-columns: repeat(2,1fr);
            }

            .cg2, .cg3 {
                grid-template-columns: 1fr;
            }

            .bc-shell {
                grid-template-columns: 1fr;
            }

            .bc-sb {
                display: none;
            }
        }
    </style>
}

<div class="bc-shell">
    <div class="bc-sb">
        <div class="sbt">Khoảng thời gian</div>
        <a href="/Admin/BaoCao?loai=ngay&nam=@nam&thang=@thang" class="sbl @(loai == "ngay" ? "active" : "")">📅 Theo ngày</a>
        <a href="/Admin/BaoCao?loai=tuan&nam=@nam&thang=@thang" class="sbl @(loai == "tuan" ? "active" : "")">📆 Theo tuần</a>
        <a href="/Admin/BaoCao?loai=thang&nam=@nam" class="sbl @(loai == "thang" ? "active" : "")">🗓 Theo tháng</a>
        <a href="/Admin/BaoCao?loai=quy&nam=@nam" class="sbl @(loai == "quy" ? "active" : "")">📊 Theo quý</a>
        <a href="/Admin/BaoCao?loai=nam" class="sbl @(loai == "nam" ? "active" : "")">📈 Theo năm</a>
        <div class="sbt">Lọc nâng cao</div>
        <form method="get" action="/Admin/BaoCao">
            <input type="hidden" name="loai" value="@loai" />
            <select name="nam" class="sbsel" onchange="this.form.submit()">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
                {
                    <option value="@y" selected="@(y == nam)">Năm @y</option>
                }
            </select>
            @if (loai == "ngay" || loai == "tuan")
            {
                <select name="thang" class="sbsel" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == thang)">Tháng @m</option>
                    }
                </select>
            }
        </form>
        <div class="sbt">Công cụ</div>
        <button class="sbl" onclick="window.print()">🖨️ In báo cáo</button>
        <button class="sbl" onclick="exportCSV()">📥 Xuất CSV</button>
    </div>

    <div class="bc-main">
        <div style="margin-bottom:22px;">
            <div style="font-size:.65rem;color:var(--dim);letter-spacing:2px;text-transform:uppercase;">Admin — Giám sát tài chính toàn hệ thống</div>
            <h2 style="font-size:1.45rem;font-weight:800;color:var(--txt);margin:5px 0 2px;">Báo cáo Doanh thu</h2>
            <div style="font-size:.82rem;color:var(--muted);">@tieuDe</div>
        </div>

        <!-- KPI -->
        <div class="krow">
            <div class="kc" style="--acc:#22c55e;">
                <div class="kico">💰</div>
                <div class="klbl">Phí HH PitchHub thu về</div>
                <div class="kval">@((tongPhi / 1_000_000).ToString("F2"))M <span>đ</span></div>
                <div class="ksub">@tongPhi.ToString("N0")đ kỳ này</div>
            </div>
            <div class="kc" style="--acc:#60a5fa;">
                <div class="kico">🏟️</div>
                <div class="klbl">Doanh thu chủ sân</div>
                <div class="kval">@((tongDTSan / 1_000_000).ToString("F2"))M <span>đ</span></div>
                <div class="ksub">@tongDTSan.ToString("N0")đ tổng giao dịch</div>
            </div>
            <div class="kc" style="--acc:#f59e0b;">
                <div class="kico">⚽</div>
                <div class="klbl">Tổng lượt đặt sân</div>
                <div class="kval">@tongLuot.ToString("N0") <span>lượt</span></div>
                <div class="ksub">TB @(tongLuot > 0 ? ((tongDTSan / tongLuot)).ToString("N0") : "0")đ/lượt</div>
            </div>
            <div class="kc" style="--acc:#8b5cf6;">
                <div class="kico">📊</div>
                <div class="klbl">Tỷ lệ HH bình quân</div>
                <div class="kval">@(tongDTSan > 0 ? ((tongPhi / tongDTSan * 100)).ToString("F1") : "0") <span>%</span></div>
                <div class="ksub">Trên tổng doanh thu sân</div>
            </div>
        </div>

        <!-- Chart 1 -->
        <div class="sdiv">Doanh thu theo thời gian</div>
        <div class="cc" style="margin-bottom:16px;">
            <div class="ch">
                <div class="ct">📈 DOANH THU SÂN + PHÍ HH PITCHHUB (Triệu đồng)</div>
                <div style="display:flex;gap:14px;font-size:.73rem;color:var(--muted);">
                    <span>■ <span style="color:#60a5fa;">DT Sân</span></span>
                    <span>■ <span style="color:#22c55e;">Phí HH</span></span>
                    <span>— <span style="color:#f59e0b;">Lượt đặt</span></span>
                </div>
            </div>
            <canvas id="cMain" style="max-height:270px;"></canvas>
        </div>

        <!-- Chart 2+3 -->
        <div class="sdiv">Phân tích chi tiết</div>
        <div class="cg2">
            <div class="cc">
                <div class="ch"><div class="ct">📦 PHÂN LOẠI KA (Hủy) / KB (Hoàn thành)</div></div>
                <canvas id="cKAKB" style="max-height:220px;"></canvas>
            </div>
            <div class="cc">
                <div class="ch">
                    <div class="ct">🥧 PHÂN BỔ PHÍ HH THEO OWNER</div>
                    <span class="cbg">Top @byOwner.Count</span>
                </div>
                <canvas id="cDonut" style="max-height:220px;"></canvas>
            </div>
        </div>

        <!-- Chart 4+5+6 -->
        <div class="cg3">
            <div class="cc">
                <div class="ch"><div class="ct">🏟 TỶ LỆ LẤP ĐẦY SÂN (%)</div></div>
                <canvas id="cLapDay" style="max-height:260px;"></canvas>
            </div>
            <div class="cc">
                <div class="ch">
                    <div class="ct">🏆 TOP 5 DT SÂN</div>
                    <span class="cbg">Top 5</span>
                </div>
                <canvas id="cTop5DT" style="max-height:260px;"></canvas>
            </div>
            <div class="cc">
                <div class="ch">
                    <div class="ct">⚽ TOP 5 LƯỢT ĐẶT</div>
                    <span class="cbg">Top 5</span>
                </div>
                <canvas id="cTop5L" style="max-height:260px;"></canvas>
            </div>
        </div>

        <!-- Bảng xếp hạng -->
        <div class="sdiv">Bảng xếp hạng chi tiết</div>
        <div class="cc">
            <div class="ch">
                <div class="ct">📋 XẾP HẠNG SÂN THEO PHÍ HOA HỒNG ĐÓNG GÓP</div>
                <span class="cbg">@xepHang.Count() sân</span>
            </div>
            @{
                double maxPhi2 = xepHang.Any() ? xepHang.Max(o => { try { return (double)o.PhiHoaHong; } catch { return 0.0; } }) : 1.0;
            }
            <div style="overflow-x:auto;">
                <table class="rtbl">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tên sân</th>
                            <th>Owner</th>
                            <th>Tỷ lệ HH</th>
                            <th>Lượt đặt</th>
                            <th>DT sân</th>
                            <th>Phí HH (progress)</th>
                            <th>KA / KB</th>
                            <th>Lấp đầy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int r = 1;
                        }
                        @foreach (var o in xepHang)
                        {
                            string ts = "", ow = ""; double tyLe = 0, tdt = 0, phi = 0; int sl = 0, ka = 0, kb = 0;
                            try
                            {
                                ts = (string)o.TenSan; ow = (string)o.Owner; tyLe = (double)o.TyLeHH;
                                tdt = (double)o.TongDT; phi = (double)o.PhiHoaHong; sl = (int)o.SoLuot;
                                ka = (int)o.SoLuotKA; kb = (int)o.SoLuotKB;
                            }
                            catch { }
                            int bw = maxPhi2 > 0 ? (int)(phi / maxPhi2 * 100) : 0;
                            var bc = bw >= 70 ? "#22c55e" : bw >= 40 ? "#f59e0b" : "#60a5fa";
                            var ldi = lapDay.FirstOrDefault(s => { try { return (string)s.Ten == ts; } catch { return false; } });
                            double lp = 0; if (ldi != null) { try { int t = (int)ldi.Tong, d = (int)ldi.DaDat; lp = t > 0 ? (double)d / t * 100 : 0; } catch { } }
                            var lc = lp >= 70 ? "#22c55e" : lp >= 40 ? "#f59e0b" : "#ef4444";
                            <tr>
                                <td><span class="rn">#@r</span></td>
                                <td><span class="rs">@ts</span></td>
                                <td style="font-size:.79rem;color:var(--muted);">@ow</td>
                                <td><span class="pl g">@((tyLe * 100).ToString("F0"))%</span></td>
                                <td>@sl</td>
                                <td style="color:#60a5fa;font-weight:600;">@((tdt / 1_000_000).ToString("F2"))M</td>
                                <td>
                                    <div class="pw">
                                        <span style="color:#22c55e;font-weight:700;min-width:52px;font-size:.8rem;">@((phi / 1_000_000).ToString("F2"))M</span>
                                        <div class="pb"><div class="pf" style="width:@bw%;background:@bc;"></div></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="pl r">KA @ka</span>
                                    <span class="pl g" style="margin-left:3px;">KB @kb</span>
                                </td>
                                <td><span style="color:@lc;font-weight:700;">@lp.ToString("F0")%</span></td>
                            </tr>
                            r++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        Chart.defaults.color='#94a3b8';
        Chart.defaults.borderColor='rgba(255,255,255,.07)';
        Chart.defaults.plugins.tooltip.backgroundColor='rgba(10,20,15,.95)';
        Chart.defaults.plugins.tooltip.borderColor='rgba(30,215,96,.3)';
        Chart.defaults.plugins.tooltip.borderWidth=1;
        Chart.defaults.plugins.tooltip.padding=10;
        Chart.defaults.plugins.legend.labels.boxWidth=12;
        Chart.defaults.plugins.legend.labels.padding=14;

        const G='#1ed760',B='#3b82f6',GOLD='#f59e0b',RED='#ef4444',
              PUR='#8b5cf6',CYA='#06b6d4',ORA='#f97316';
        const PAL=[G,B,GOLD,RED,PUR,CYA,ORA,'#ec4899','#84cc16','#14b8a6'];
        const fmtM=v=>v.toFixed(2)+'M đ';

        new Chart(document.getElementById('cMain'),{
          data:{
            labels:@Html.Raw(lblMain),
            datasets:[
              {type:'bar',label:'DT Sân (Triệu đ)',data:@Html.Raw(dtSanArr),
               backgroundColor:'rgba(59,130,246,.22)',borderColor:B,borderWidth:1.5,borderRadius:5,order:2,yAxisID:'y'},
              {type:'bar',label:'Phí HH PitchHub (Triệu đ)',data:@Html.Raw(phiArr),
               backgroundColor:'rgba(30,215,96,.22)',borderColor:G,borderWidth:1.5,borderRadius:5,order:3,yAxisID:'y'},
              {type:'line',label:'Lượt đặt',data:@Html.Raw(luotArr),
               borderColor:GOLD,backgroundColor:'rgba(245,158,11,.07)',borderWidth:2.5,
               fill:true,tension:0.45,pointBackgroundColor:GOLD,pointRadius:4,pointHoverRadius:7,
               order:1,yAxisID:'y2'}
            ]
          },
          options:{
            responsive:true,interaction:{mode:'index',intersect:false},
            plugins:{legend:{display:true,labels:{color:'#94a3b8'}},
              tooltip:{callbacks:{label:c=>c.datasetIndex<=1?` ${c.dataset.label}: ${fmtM(c.parsed.y)}`:` Lượt đặt: ${c.parsed.y}`}}},
            scales:{
              x:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#64748b'}},
              y:{position:'left',grid:{color:'rgba(255,255,255,.05)'},ticks:{color:G,callback:v=>v+'M'}},
              y2:{position:'right',grid:{drawOnChartArea:false},ticks:{color:GOLD}}
            }
          }
        });

        new Chart(document.getElementById('cKAKB'),{
          type:'bar',
          data:{
            labels:@Html.Raw(lblMain),
            datasets:[
              {label:'KB - Hoàn thành',data:@Html.Raw(kbArr),
               backgroundColor:'rgba(30,215,96,.6)',borderColor:G,borderWidth:1,borderRadius:{topLeft:4,topRight:4},stack:'s'},
              {label:'KA - Đã hủy',data:@Html.Raw(kaArr),
               backgroundColor:'rgba(239,68,68,.55)',borderColor:RED,borderWidth:1,borderRadius:{bottomLeft:4,bottomRight:4},stack:'s'}
            ]
          },
          options:{
            responsive:true,
            plugins:{legend:{labels:{color:'#94a3b8'}},tooltip:{mode:'index',intersect:false}},
            scales:{
              x:{stacked:true,grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#64748b'}},
              y:{stacked:true,grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#94a3b8'}}
            }
          }
        });

        new Chart(document.getElementById('cDonut'),{
          type:'doughnut',
          data:{
            labels:@Html.Raw(lblOwner),
            datasets:[{data:@Html.Raw(phiOwner),
              backgroundColor:PAL.map(c=>c+'bb'),borderColor:PAL,borderWidth:2,hoverOffset:10}]
          },
          options:{
            responsive:true,cutout:'62%',
            plugins:{
              legend:{position:'right',labels:{color:'#94a3b8',font:{size:11},padding:8}},
              tooltip:{callbacks:{label:c=>` ${c.label}: ${fmtM(c.parsed)}`}}
            }
          }
        });

        const ldVals=@Html.Raw(ldArrJs);
        new Chart(document.getElementById('cLapDay'),{
          type:'bar',
          data:{
            labels:@Html.Raw(lblLd),
            datasets:[{label:'Lấp đầy (%)',data:ldVals,
              backgroundColor:ldVals.map(v=>v>=70?'rgba(30,215,96,.65)':v>=40?'rgba(245,158,11,.65)':'rgba(239,68,68,.65)'),
              borderColor:ldVals.map(v=>v>=70?G:v>=40?GOLD:RED),borderWidth:1.5,borderRadius:4}]
          },
          options:{
            indexAxis:'y',responsive:true,
            plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${c.parsed.x.toFixed(1)}%`}}},
            scales:{
              x:{max:100,grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#64748b',callback:v=>v+'%'}},
              y:{ticks:{color:'#94a3b8',font:{size:10}}}
            }
          }
        });

        const t5lbl=@Html.Raw(lblSan);
        new Chart(document.getElementById('cTop5DT'),{
          type:'bar',
          data:{
            labels:t5lbl,
            datasets:[{label:'DT (Triệu đ)',data:@Html.Raw(dtSan2),
              backgroundColor:PAL.slice(0,5).map(c=>c+'88'),borderColor:PAL.slice(0,5),borderWidth:2,borderRadius:6}]
          },
          options:{
            responsive:true,
            plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${fmtM(c.parsed.y)}`}}},
            scales:{
              x:{ticks:{color:'#64748b',font:{size:10}}},
              y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:B,callback:v=>v+'M'}}
            }
          }
        });

        new Chart(document.getElementById('cTop5L'),{
          type:'bar',
          data:{
            labels:t5lbl,
            datasets:[{label:'Lượt đặt',data:@Html.Raw(luotSan2),
              backgroundColor:[G+'88',GOLD+'88',B+'88',PUR+'88',CYA+'88'],
              borderColor:[G,GOLD,B,PUR,CYA],borderWidth:2,borderRadius:6}]
          },
          options:{
            responsive:true,
            plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${c.parsed.y} lượt`}}},
            scales:{
              x:{ticks:{color:'#64748b',font:{size:10}}},
              y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:GOLD}}
            }
          }
        });

        function exportCSV(){
          const rows=[['#','Tên sân','Owner','Tỷ lệ HH','Lượt đặt','DT sân (M đ)','Phí HH (M đ)','KA','KB','Lấp đầy %']];
          document.querySelectorAll('.rtbl tbody tr').forEach(tr=>{
            rows.push([...tr.querySelectorAll('td')].map(td=>td.innerText.trim().replace(/\n/g,' ')));
          });
          const csv=rows.map(r=>r.map(c=>'"'+c+'"').join(',')).join('\n');
          const a=document.createElement('a');
          a.href='data:text/csv;charset=utf-8,\ufeff'+encodeURIComponent(csv);
          a.download='baocao_pitchhub_@(nam).csv';
          a.click();
        }
    </script>
}
