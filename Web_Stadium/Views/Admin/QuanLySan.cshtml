@{
    ViewData["Title"] = "Quản lý sân toàn hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var sanList = ViewBag.SanList as List<Web_Stadium.EFCore.SanBong> ?? new();
    var ownerList = ViewBag.OwnerList as List<Web_Stadium.EFCore.User> ?? new();
    var filterOwner = (int?)(ViewBag.FilterOwner);
}

@section Styles {
    <style>
        .ph-filter-select, .ph-filter-input {
            color-scheme: dark;
        }

        .san-card {
            transition: border-color .2s, box-shadow .2s;
        }
    </style>
}

<div style="padding:0 0 40px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Quản lý</div>
        <h2>Quản lý sân <span class="pg-accent">toàn hệ thống</span></h2>
        <p>Xem, lọc và quản lý tất cả sân bóng trong hệ thống PitchHub</p>
    </div>

    <!-- ══ BỘ LỌC ══ -->
    <div class="section-card mb-4">
        <div class="ph-filter-bar">
            <span class="title">🔍 Lọc &amp; Tìm kiếm</span>
            <div style="flex:1;"></div>
            <form method="get" action="/Admin/QuanLySan" id="filterForm"
                  style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">

                <select name="ownerId" onchange="document.getElementById('filterForm').submit()"
                        class="ph-filter-select">
                    <option value="">👤 Tất cả chủ sân</option>
                    @foreach (var o in ownerList)
                    {
                        if (filterOwner == o.Id)
                        {
                            <option value="@o.Id" selected>@o.HoTen — @o.Email</option>
                        }
                        else
                        {
                            <option value="@o.Id">@o.HoTen — @o.Email</option>
                        }
                    }
                </select>

                <select name="trangThai" onchange="document.getElementById('filterForm').submit()"
                        class="ph-filter-select">
                    <option value="">📋 Tất cả trạng thái</option>
                    @if ((string)ViewBag.FilterTT == "DaDuyet")
                    {
                        <option value="DaDuyet" selected>✅ Đã duyệt</option>
                    }
                    else
                    {
                        <option value="DaDuyet">✅ Đã duyệt</option>
                    }
                    @if ((string)ViewBag.FilterTT == "ChoDuyet")
                    {
                        <option value="ChoDuyet" selected>⏳ Chờ duyệt</option>
                    }
                    else
                    {
                        <option value="ChoDuyet">⏳ Chờ duyệt</option>
                    }
                    @if ((string)ViewBag.FilterTT == "TuChoi")
                    {
                        <option value="TuChoi" selected>❌ Từ chối</option>
                    }
                    else
                    {
                        <option value="TuChoi">❌ Từ chối</option>
                    }
                </select>

                <input type="text" name="keyword"
                       value="@ViewBag.Keyword"
                       placeholder="🔍 Tên sân, địa chỉ..."
                       class="ph-filter-input"
                       oninput="clearTimeout(window._kw); window._kw=setTimeout(()=>document.getElementById('filterForm').submit(),400)" />

                <a href="/Admin/QuanLySan" class="ph-filter-clear">✕ Xóa lọc</a>
            </form>
        </div>

        <!-- KPI nhanh -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);">
            @{
                var kpiItems = new[]{
                        ("🏟", sanList.Count.ToString(), "Tổng sân"),
                        ("✅", sanList.Count(s=>s.TrangThaiDuyet=="DaDuyet").ToString(), "Đã duyệt"),
                        ("⏳", sanList.Count(s=>s.TrangThaiDuyet=="ChoDuyet").ToString(), "Chờ duyệt"),
                        ("❌", sanList.Count(s=>s.TrangThaiDuyet=="TuChoi").ToString(), "Từ chối")
                        };
                var kpiColors = new[] { "var(--text)", "var(--green)", "#f59e0b", "var(--danger)" };
                int kpiIdx = 0;
            }
            @foreach (var (ico, val, lbl) in kpiItems)
            {
                var clr = kpiColors[kpiIdx++];
                <div style="padding:14px 20px;text-align:center;border-right:1px solid var(--border);">
                    <div style="font-size:1.6rem;font-weight:800;color:@clr;">@val</div>
                    <div style="font-size:12px;color:var(--muted);margin-top:2px;">@ico @lbl</div>
                </div>
            }
        </div>
    </div>

    <!-- ══ LAYOUT 2 CỘT ══ -->
    <div style="display:grid;grid-template-columns:1fr 420px;gap:20px;align-items:start;">

        <!-- CỘT TRÁI: DANH SÁCH SÂN -->
        <div>
            @if (!sanList.Any())
            {
                <div class="section-card p-5 text-center" style="color:var(--muted)">
                    <div style="font-size:3rem;margin-bottom:12px;">🔍</div>
                    <div>Không tìm thấy sân nào phù hợp.</div>
                </div>
            }

            @foreach (var san in sanList)
            {
                // FIX: Dùng biến string cho màu thay vì nối chuỗi trong CSS
                string stColor = san.TrangThaiDuyet == "DaDuyet" ? "#22c55e" :
                san.TrangThaiDuyet == "ChoDuyet" ? "#f59e0b" : "#ef4444";
                string stLabel = san.TrangThaiDuyet == "DaDuyet" ? "✅ Đã duyệt" :
                san.TrangThaiDuyet == "ChoDuyet" ? "⏳ Chờ duyệt" : "❌ Từ chối";
                string stBg = san.TrangThaiDuyet == "DaDuyet" ? "rgba(34,197,94,.12)" :
                san.TrangThaiDuyet == "ChoDuyet" ? "rgba(245,158,11,.12)" : "rgba(239,68,68,.12)";
                string stBd = san.TrangThaiDuyet == "DaDuyet" ? "rgba(34,197,94,.3)" :
                san.TrangThaiDuyet == "ChoDuyet" ? "rgba(245,158,11,.3)" : "rgba(239,68,68,.3)";

                <div class="section-card p-0 overflow-hidden mb-3 san-card"
                     id="san-@san.Id"
                     style="cursor:pointer;transition:border-color .2s,box-shadow .2s;border:1px solid var(--border);"
                     onclick="focusPin(@san.Id)">

                    <div style="display:flex;gap:0;">
                        <!-- Ảnh sân -->
                        <div style="width:120px;height:100px;flex-shrink:0;background:var(--bg3);
                                                    display:flex;align-items:center;justify-content:center;font-size:2.5rem;overflow:hidden;">
                            @if (san.AnhSanBongs?.Any() == true)
                            {
                                <img src="@san.AnhSanBongs.First().DuongDan"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <text>🏟️</text>
                            }
                        </div>

                        <!-- Thông tin -->
                        <div style="flex:1;padding:12px 16px;min-width:0;">
                            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px;">
                                <div style="min-width:0;">
                                    <div style="font-weight:700;font-size:15px;color:var(--text);
                                                                white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @san.TenSan
                                    </div>
                                    <div style="font-size:12px;color:var(--muted);margin-top:2px;">
                                        📍 @san.DiaChi, @san.Quan
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
                                    <span style="font-size:11px;padding:3px 10px;border-radius:20px;font-weight:700;
                                                                 background:@stBg;color:@stColor;border:1px solid @stBd;">
                                        @stLabel
                                    </span>
                                    @if (san.IsHidden)
                                    {
                                        <span style="font-size:11px;padding:2px 8px;border-radius:20px;
                                                                                     background:rgba(100,100,100,.15);color:var(--muted);">
                                            🔒 Đang ẩn
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Meta -->
                            <div style="display:flex;gap:12px;font-size:12px;color:var(--muted2);flex-wrap:wrap;margin-bottom:8px;">
                                <span>⚽ @san.LoaiSan người</span>
                                <span>🌿 @san.LoaiCo</span>
                                <span>👤 @(san.Owner?.HoTen ?? "—")</span>
                            </div>

                            <!-- Dịch vụ -->
                            @if (san.DichVus?.Any(d => d.IsActive) == true)
                            {
                                <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                    @foreach (var dv in san.DichVus.Where(d => d.IsActive).Take(5))
                                    {
                                        <span style="font-size:11px;padding:2px 8px;border-radius:8px;
                                                                                                     background:rgba(14,168,106,.1);color:var(--green);
                                                                                                     border:1px solid rgba(14,168,106,.2);">
                                            @dv.TenDichVu
                                        </span>
                                    }
                                    @if (san.DichVus.Count(d => d.IsActive) > 5)
                                    {
                                        <span style="font-size:11px;color:var(--muted);">
                                            +@(san.DichVus.Count(d => d.IsActive) - 5) khác
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="font-size:11px;color:var(--muted2);">Chưa có dịch vụ kèm</div>
                            }
                        </div>

                        <!-- Actions -->
                        <div style="display:flex;flex-direction:column;justify-content:center;gap:6px;
                                                    padding:12px;border-left:1px solid var(--border);flex-shrink:0;">
                            <a href="/Venues/Details/@san.Id"
                               onclick="event.stopPropagation()"
                               class="btn btn-sm btn-outline-success rounded-pill">
                                👁 Xem chi tiết
                            </a>
                            @if (san.TrangThaiDuyet == "ChoDuyet")
                            {
                                <a href="/Admin/DuyetSan"
                                   onclick="event.stopPropagation()"
                                   class="btn btn-sm btn-warning rounded-pill"
                                   style="font-size:12px;">
                                    ✅ Duyệt
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Expand: chi tiết dịch vụ -->
                    <div id="dv-@san.Id" style="display:none;border-top:1px solid var(--border);
                                                                padding:12px 16px;background:rgba(0,0,0,.08);">
                        <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:10px;">
                            DỊCH VỤ KÈM THEO (@(san.DichVus?.Count(d => d.IsActive) ?? 0) dịch vụ)
                        </div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;">
                            @foreach (var dv in (san.DichVus ?? new List<Web_Stadium.EFCore.DichVu>()).Where(d => d.IsActive))
                            {
                                string khoClr = dv.TonKho < 5 ? "var(--danger)" : dv.TonKho < 20 ? "#f59e0b" : "var(--muted)";
                                <div style="padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg3);">
                                    <div style="font-weight:600;font-size:13px;color:var(--text);">@dv.TenDichVu</div>
                                    <div style="color:var(--green);font-size:12px;margin-top:2px;">@dv.Gia.ToString("N0")đ/đv</div>
                                    <div style="color:@khoClr;font-size:11px;margin-top:2px;">Kho: @dv.TonKho</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- CỘT PHẢI: BẢN ĐỒ -->
        <div>
            <div class="ph-map-label">Bấm card để định vị trên bản đồ</div>
            <div id="map" class="ph-map" style="height:520px;"></div>
        </div>
    </div>

    <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);">
            <div style="width:12px;height:12px;border-radius:50%;background:#22c55e;"></div> Đã duyệt
        </div>
        <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);">
            <div style="width:12px;height:12px;border-radius:50%;background:#f59e0b;"></div> Chờ duyệt
        </div>
        <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);">
            <div style="width:12px;height:12px;border-radius:50%;background:#ef4444;"></div> Từ chối
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([21.028, 105.854], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap', maxZoom: 18
        }).addTo(map);

        // Data từ Controller — serialize sẵn, không dùng Razor loop trong JS
        var sanData = @Html.Raw(ViewBag.MapDataJson ?? "[]");

        function pinColor(t) {
            return t === 'DaDuyet' ? '#22c55e' : t === 'ChoDuyet' ? '#f59e0b' : '#ef4444';
        }
        function makeIcon(c) {
            return L.divIcon({
                className: '',
                html: '<div style="width:14px;height:14px;border-radius:50%;background:'+c+';border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.4);"></div>',
                iconSize:[14,14], iconAnchor:[7,7], popupAnchor:[0,-10]
            });
        }

        var markers = {}, bounds = [];

        sanData.forEach(function(s) {
            if (!s.lat || !s.lng || s.lat === 0) return;
            var m = L.marker([s.lat, s.lng], { icon: makeIcon(pinColor(s.trangThai)) }).addTo(map);

            var dvHtml = '';
            if (s.dichVus && s.dichVus.length > 0) {
                dvHtml = '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:3px;">';
                s.dichVus.slice(0,4).forEach(function(dv){
                    dvHtml += '<span style="font-size:10px;padding:1px 6px;border-radius:6px;background:rgba(34,197,94,.12);color:#15803d;border:1px solid rgba(34,197,94,.25);">'+dv.ten+'</span>';
                });
                if (s.dichVus.length > 4) dvHtml += '<span style="font-size:10px;color:#888;">+' + (s.dichVus.length-4) + ' khác</span>';
                dvHtml += '</div>';
            }

            m.bindPopup(
                '<div style="font-family:Arial,sans-serif;min-width:200px;">' +
                '<div style="font-weight:700;font-size:14px;color:#111;margin-bottom:4px;">'+s.ten+'</div>' +
                '<div style="font-size:12px;color:#666;margin-bottom:3px;">📍 '+s.diaChi+'</div>' +
                '<div style="font-size:12px;color:#666;margin-bottom:3px;">⚽ Sân '+s.loaiSan+' người · 👤 '+s.owner+'</div>' +
                dvHtml +
                '<div style="margin-top:8px;padding-top:8px;border-top:1px solid #eee;">' +
                '<a href="/Venues/Details/'+s.id+'" style="display:inline-block;background:#0EA86A;color:#fff;padding:5px 14px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:700;">👁 Xem chi tiết</a>' +
                '</div></div>',
                { maxWidth: 280 }
            );

            m.on('click', function() { highlightCard(s.id); });
            markers[s.id] = m;
            bounds.push([s.lat, s.lng]);
        });

        if (bounds.length > 0) {
            try { map.fitBounds(bounds, { padding:[30,30] }); } catch(e) {}
        }

        function highlightCard(sanId) {
            document.querySelectorAll('.san-card').forEach(function(c) {
                c.style.borderColor = 'var(--border)';
                c.style.boxShadow = 'none';
            });
            var card = document.getElementById('san-' + sanId);
            if (card) {
                card.style.borderColor = 'var(--green)';
                card.style.boxShadow = '0 0 0 2px rgba(14,168,106,.3)';
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        // FIX: focusPin chỉ nhận sanId, lấy lat/lng từ sanData
        function focusPin(sanId) {
            highlightCard(sanId);
            if (markers[sanId]) {
                markers[sanId].openPopup();
                var s = sanData.find(function(x) { return x.id === sanId; });
                if (s && s.lat) map.setView([s.lat, s.lng], 16, { animate: true });
            }
            // Toggle chi tiết dịch vụ
            var dvEl = document.getElementById('dv-' + sanId);
            if (dvEl) {
                var isOpen = dvEl.style.display !== 'none';
                document.querySelectorAll('[id^="dv-"]').forEach(function(el) {
                    el.style.display = 'none';
                });
                if (!isOpen) dvEl.style.display = 'block';
            }
        }
    </script>
}
