@model List<Web_Stadium.EFCore.SanBong>
@{
    ViewData["Title"] = "Duyệt sân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tyLeMap = ViewBag.TyLeMap as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
}

@section Styles {
    <style>
        .ds-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            transition: border-color .2s,transform .2s;
            margin-bottom: 16px;
        }

            .ds-card:hover {
                border-color: var(--border2);
                transform: translateY(-1px);
            }

        .ds-head {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,.025);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .ds-body {
            padding: 18px 20px;
        }

        .ds-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .ds-field {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .ds-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: var(--muted2);
            text-transform: uppercase;
        }

        .ds-val {
            font-size: 13.5px;
            font-weight: 600;
        }

        .ds-pics {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .ds-pic {
            width: 88px;
            height: 64px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: transform .2s;
        }

            .ds-pic:hover {
                transform: scale(1.05);
            }

        .ds-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .tyLe-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(0,212,126,.1);
            border: 1px solid rgba(0,212,126,.2);
            color: var(--green2);
            padding: 4px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }
    </style>
}

<div style="padding:0 0 40px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Quản lý</div>
        <h2>Duyệt sân <span class="pg-accent">chờ phê duyệt</span></h2>
        <p>Xem xét và phê duyệt các hồ sơ đăng ký sân mới từ Owner</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 0;">
            <div style="font-size:3rem;margin-bottom:16px;">🎉</div>
            <div style="font-size:20px;font-weight:700;margin-bottom:8px;">Không có hồ sơ chờ duyệt</div>
            <div style="color:var(--muted);">Tất cả sân đã được xử lý</div>
        </div>
    }
    else
    {
        <!-- Tổng quan -->
        <div class="section-card mb-4">
            <div style="display:flex;gap:0;overflow:hidden;border-radius:16px;">
                <div style="flex:1;padding:18px 20px;border-right:1px solid var(--border);text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--warn);">@Model.Count</div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Chờ duyệt</div>
                </div>
                <div style="flex:1;padding:18px 20px;border-right:1px solid var(--border);text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--blue);">@Model.Select(s => s.OwnerId).Distinct().Count()</div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Chủ sân khác nhau</div>
                </div>
                <div style="flex:1;padding:18px 20px;text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--green2);">@Model.Select(s => s.Quan).Distinct().Count()</div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Quận khác nhau</div>
                </div>
            </div>
        </div>

        @foreach (var san in Model)
        {
            var tyLe = tyLeMap.ContainsKey(san.Quan ?? "") ? tyLeMap[san.Quan ?? ""] : 0m;
            // Lấy ảnh từ HinhAnh (string) hoặc AnhSanBongs (collection)
            var anhList = new List<string>();
            if (!string.IsNullOrEmpty(san.HinhAnh))
                anhList = san.HinhAnh.Split(',').Select(a => a.Trim()).Where(a => !string.IsNullOrEmpty(a)).ToList();
            else if (san.AnhSanBongs?.Any() == true)
                anhList = san.AnhSanBongs.OrderBy(a => a.ThuTu).Select(a => a.DuongDan).Take(6).ToList();

            <div class="ds-card">
                <div class="ds-head">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:42px;height:42px;border-radius:12px;background:rgba(0,212,126,.1);border:1px solid rgba(0,212,126,.2);display:flex;align-items:center;justify-content:center;font-size:20px;">🏟️</div>
                        <div>
                            <div style="font-weight:800;font-size:16px;">@san.TenSan</div>
                            <div style="font-size:12px;color:var(--muted);">@(san.Owner?.HoTen ?? "—") · @(san.Owner?.Email ?? "")</div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                        @if (tyLe > 0)
                        {
                            <span class="tyLe-badge">💰 @((tyLe * 100).ToString("F0"))% hoa hồng</span>
                        }
                        <span class="status-pill warn">Chờ duyệt</span>
                    </div>
                </div>
                <div class="ds-body">
                    @if (anhList.Any())
                    {
                        <div class="ds-pics">
                            @foreach (var anh in anhList.Take(6))
                            {
                                <img src="@anh" class="ds-pic"
                                     onclick="window.open('@anh','_blank')"
                                     onerror="this.style.display='none'" />
                            }
                        </div>
                    }

                    <div class="ds-grid">
                        <div class="ds-field">
                            <span class="ds-label">📍 Địa chỉ</span>
                            <span class="ds-val">@san.DiaChi, @san.Quan</span>
                        </div>
                        <div class="ds-field">
                            <span class="ds-label">⚽ Loại sân / Cỏ</span>
                            <span class="ds-val">@san.LoaiSan · @san.LoaiCo</span>
                        </div>
                        <div class="ds-field">
                            <span class="ds-label">💵 Tỷ lệ cọc</span>
                            <span class="ds-val" style="color:var(--green2);">@((san.TyLeCoc * 100).ToString("F0"))%</span>
                        </div>
                        <div class="ds-field">
                            <span class="ds-label">⭐ Đánh giá</span>
                            <span class="ds-val">@san.DanhGiaTrungBinh.ToString("F1") / 5.0</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(san.MoTa))
                    {
                        <div style="background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:13px;color:var(--muted);line-height:1.6;margin-bottom:16px;">@san.MoTa</div>
                    }

                    <div class="ds-actions">
                        <form method="post" action="/Admin/PheDuyetSan"
                              onsubmit="return confirm('Xác nhận duyệt sân @san.TenSan?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@san.Id" />
                            <button type="submit" class="btn btn-success">✅ Phê duyệt</button>
                        </form>
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="collapse"
                                data-bs-target="#tuChoi_@san.Id">
                            ✕ Từ chối
                        </button>
                        <a href="/Admin/XemHoSo/@san.Id" class="btn btn-outline-primary">📋 Xem hồ sơ</a>
                    </div>

                    <div class="collapse mt-3" id="tuChoi_@san.Id">
                        <form method="post" action="/Admin/TuChoiSan">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@san.Id" />
                            <div class="row g-2">
                                <div class="col">
                                    <input type="text" name="lyDo" class="form-control"
                                           placeholder="Lý do từ chối..." required />
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
