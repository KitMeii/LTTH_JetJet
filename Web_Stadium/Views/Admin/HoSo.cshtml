@model Web_Stadium.EFCore.User
@{
    ViewData["Title"] = "Hồ sơ Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tab = ViewBag.Tab as string ?? "suckhoe";
    var auditLogs = ViewBag.AuditLogs as List<Web_Stadium.EFCore.AuditLog> ?? new();
    var canhBao = ViewBag.CanhBao as List<string> ?? new();

    int tongSan = (int)(ViewBag.TongSan ?? 0);
    int tongUser = (int)(ViewBag.TongUser ?? 0);
    int tongOwner = (int)(ViewBag.TongOwner ?? 0);
    int tongKN = (int)(ViewBag.TongKN ?? 0);
    int sanChoDuyet = (int)(ViewBag.SanChoDuyet ?? 0);
    double dtHomNay = (double)(ViewBag.DoanhThuHomNay ?? 0.0);
    int luotHomNay = (int)(ViewBag.LuotDatHomNay ?? 0);
    int userMoiTuan = (int)(ViewBag.UserMoiTuan ?? 0);
}

@section Styles {
    <style>
        .hs {
            max-width: 960px;
            margin: 0 auto 48px;
            padding: 0 16px;
        }

        .a-hdr {
            background: linear-gradient(135deg,#1e1b4b,#4f46e5);
            border-radius: 18px;
            padding: 26px 28px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 6px 24px rgba(79,70,229,.3);
        }

        .a-ava {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            font-weight: 800;
            color: #fff;
            border: 3px solid rgba(255,255,255,.25);
            flex-shrink: 0;
        }

        .krow {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .krow2 {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .kc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .kc::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--acc, var(--green));
            }

        .kv {
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 5px;
        }

        .kl {
            font-size: .65rem;
            color: var(--muted);
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .tb {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: .82rem;
            text-decoration: none;
            border: 1px solid var(--border2);
            color: var(--muted);
            background: transparent;
            transition: all .18s;
        }

            .tb:hover {
                border-color: var(--green);
                color: var(--green2);
            }

            .tb.on {
                background: var(--green);
                color: #07120c;
                border-color: var(--green);
                font-weight: 700;
            }

        .card {
            background: var(--card) !important;
            border: 1px solid var(--border) !important;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 16px;
            color: var(--text) !important;
        }

        .ct {
            font-size: .8rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .ct span {
                color: var(--muted);
                font-size: .74rem;
                font-weight: 400;
            }
        /* Cảnh báo */
        .warn-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid rgba(239,68,68,.3);
            background: rgba(239,68,68,.06);
            margin-bottom: 8px;
        }

            .warn-item.yellow {
                border-color: rgba(245,158,11,.3);
                background: rgba(245,158,11,.06);
            }
        /* Shortcut */
        .sc-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 12px;
        }

        .sc {
            padding: 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--bg3);
            text-decoration: none;
            text-align: center;
            transition: all .18s;
            display: block;
        }

            .sc:hover {
                border-color: var(--green);
                background: rgba(0,212,126,.06);
            }

    .sc-ico {
        order-color: #4f46e5;
        background: #eef2ff;
        font-size: 1.8rem;
        margin-bottom: 6px;
    }

    .sc-lbl {
        font-size: .83rem;
        color: var(--text);
        font-weight: 600;
    }

    .sc-sub {
        font-size: .72rem;
        color: var(--muted);
        margin-top: 2px;
    }
    /* Log */
    .log-r {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 9px 0;
        border-bottom: 1px solid var(--border);
        font-size: .82rem;
    }

        .log-r:last-child {
            border-bottom: none;
        }

    .log-act {
        font-size: .72rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        background: rgba(0,212,126,.1);
        color: var(--green2);
        white-space: nowrap;
    }

    .inp {
        width: 100%;
        background: var(--bg3);
        border: 1px solid var(--border2);
        color: var(--text);
        border-radius: 8px;
        padding: 9px 12px;
        font-size: .87rem;
    }

        .inp:focus {
            outline: none;
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(0,212,126,.12);
        }

        .inp:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .btn-i {
        background: var(--green);
        color: #07120c;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-weight: 700;
        font-size: .87rem;
        cursor: pointer;
    }

        .btn-i:hover {
            opacity: .88;
        }
</style>
}

<div class="hs">
    <!-- Header -->
    <div class="a-hdr">
        <div class="a-ava">⚡</div>
        <div style="flex:1;">
            <div style="color:#fff;font-size:1.1rem;font-weight:700;margin-bottom:4px;">@Model.HoTen.ToUpper()</div>
            <span style="font-size:.7rem;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,.2);color:#fff;">⚡ Quản trị viên hệ thống</span>
            <div style="color:rgba(255,255,255,.65);font-size:.78rem;margin-top:5px;">@Model.Email &nbsp;·&nbsp; Gia nhập @Model.NgayTao.ToString("MM/yyyy")</div>
        </div>
        <!-- Alert nếu có khiếu nại hoặc sân chờ duyệt -->
        @if (tongKN > 0 || sanChoDuyet > 0)
        {
            <div style="background:rgba(239,68,68,.2);border:1px solid rgba(239,68,68,.5);border-radius:10px;padding:10px 14px;">
                @if (tongKN > 0)
                {
                    <div style="color:#fff;font-size:.8rem;">⚠️ @tongKN khiếu nại chờ xử lý</div>
                }
                @if (sanChoDuyet > 0)
                {
                    <div style="color:#fff;font-size:.8rem;margin-top:2px;">🏟 @sanChoDuyet sân chờ duyệt</div>
                }
            </div>
        }
    </div>

    <!-- KPI Hệ thống -->
    <div class="krow">
        <div class="kc" style="--acc:var(--green);"><div class="kv" style="color:var(--green);">@tongSan</div><div class="kl">🏟 Tổng sân hoạt động</div></div>
        <div class="kc" style="--acc:#2563eb;"><div class="kv" style="color:#2563eb;">@tongUser.ToString("N0")</div><div class="kl">👥 Người dùng</div></div>
        <div class="kc" style="--acc:#f59e0b;"><div class="kv" style="color:#f59e0b;">@tongOwner</div><div class="kl">🏟️ Chủ sân</div></div>
        <div class="kc" style="--acc:var(--danger);"><div class="kv" style="color:var(--danger);">@tongKN</div><div class="kl">⚠️ Khiếu nại chờ</div></div>
    </div>

    <!-- KPI Hôm nay -->
    <div class="krow2">
        <div class="kc" style="--acc:#4f46e5;"><div style="font-size:.68rem;color:var(--muted);letter-spacing:1px;margin-bottom:4px;">HÔM NAY</div><div class="kv" style="color:#4f46e5;">@((dtHomNay / 1_000_000).ToString("F2"))M</div><div class="kl">💰 Doanh thu (tr.đ)</div></div>
        <div class="kc" style="--acc:var(--green);"><div style="font-size:.68rem;color:var(--muted);letter-spacing:1px;margin-bottom:4px;">HÔM NAY</div><div class="kv" style="color:var(--green);">@luotHomNay</div><div class="kl">⚽ Lượt đặt sân</div></div>
        <div class="kc" style="--acc:#06b6d4;"><div style="font-size:.68rem;color:var(--muted);letter-spacing:1px;margin-bottom:4px;">TUẦN NÀY</div><div class="kv" style="color:#06b6d4;">+@userMoiTuan</div><div class="kl">🆕 Người dùng mới</div></div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <a href="?tab=suckhoe" class="tb @(tab == "suckhoe" ? "on" : "")">🏥 Sức khỏe hệ thống</a>
        <a href="?tab=nhatky" class="tb @(tab == "nhatky" ? "on" : "")">📋 Nhật ký hoạt động</a>
        <a href="?tab=phimtat" class="tb @(tab == "phimtat" ? "on" : "")">⚡ Truy cập nhanh</a>
        <a href="?tab=thongtin" class="tb @(tab == "thongtin" ? "on" : "")">👤 Thông tin</a>
        <a href="?tab=baomat" class="tb @(tab == "baomat" ? "on" : "")">🔒 Bảo mật</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- TAB: SỨC KHỎE HỆ THỐNG -->
    @if (tab == "suckhoe")
    {
        <div class="card">
            <div class="ct">🚨 CẢNH BÁO CẦN XỬ LÝ <span>@canhBao.Count mục</span></div>
            @if (!canhBao.Any())
            {
                <div style="text-align:center;padding:20px;color:var(--green);font-weight:600;">✅ Hệ thống hoạt động bình thường. Không có cảnh báo.</div>
            }
            @{
                int ci = 0;
            }
            @foreach (var cb in canhBao)
            {
                bool isRed = ci % 2 == 0;
                <div class="warn-item @(!isRed ? "yellow" : "")">
                    <span style="font-size:1.1rem;">@(isRed ? "🔴" : "🟡")</span>
                    <span style="color:var(--text);font-size:.85rem;">@cb</span>
                </div>
                ci++;
            }
        </div>

        <div class="card">
            <div class="ct">📈 THỐNG KÊ HỆ THỐNG REALTIME</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:8px;letter-spacing:1px;text-transform:uppercase;">Phân bổ tài khoản</div>
                    @{
                        var roles = new[]{
                                ("👥 User","var(--green)",tongUser),
                                ("🏟️ Owner","#f59e0b",tongOwner),
                                ("👷 Staff","#2563eb",(int)(ViewBag.TongStaff??0)),
                                ("⚡ Admin","#4f46e5",(int)(ViewBag.TongAdmin??0))
                                };
                        int totalAcc = roles.Sum(r => r.Item3);
                    }
                    @foreach (var (label, color, count) in roles)
                    {
                        int pct2 = totalAcc > 0 ? (int)((double)count / totalAcc * 100) : 0;
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:.83rem;">
                            <span style="min-width:80px;color:var(--text);">@label</span>
                            <div style="flex:1;background:rgba(15,23,42,.08);border-radius:4px;height:6px;overflow:hidden;">
                                <div style="width:@pct2%;height:100%;border-radius:4px;background:@color;"></div>
                            </div>
                            <span style="min-width:36px;text-align:right;font-weight:700;color:@color;">@count</span>
                        </div>
                    }
                </div>
                <div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:8px;letter-spacing:1px;text-transform:uppercase;">Trạng thái sân</div>
                    @{
                        int sanDaDuyet = (int)(ViewBag.SanDaDuyet ?? 0);
                        int sanCho = (int)(ViewBag.SanChoDuyet ?? 0);
                        int sanTuChoi = (int)(ViewBag.SanTuChoi ?? 0);
                        var sanRoles = new[] { ("✅ Đã duyệt", "var(--green)", sanDaDuyet), ("⏳ Chờ duyệt", "#f59e0b", sanCho), ("❌ Từ chối", "var(--danger)", sanTuChoi) };
                        int totalSan = sanRoles.Sum(r => r.Item3);
                    }
                    @foreach (var (label, color, count) in sanRoles)
                    {
                        int pct2 = totalSan > 0 ? (int)((double)count / totalSan * 100) : 0;
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:.83rem;">
                            <span style="min-width:90px;color:var(--text);">@label</span>
                            <div style="flex:1;background:rgba(15,23,42,.08);border-radius:4px;height:6px;overflow:hidden;">
                                <div style="width:@pct2%;height:100%;border-radius:4px;background:@color;"></div>
                            </div>
                            <span style="min-width:28px;text-align:right;font-weight:700;color:@color;">@count</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- TAB: NHẬT KÝ -->
    @if (tab == "nhatky")
    {
        <div class="card">
            <div class="ct">📋 NHẬT KÝ HOẠT ĐỘNG CỦA TÔI <span>50 hành động gần nhất</span></div>
            @if (!auditLogs.Any())
            {
                <div style="text-align:center;padding:20px;color:var(--muted);">Chưa có hoạt động.</div>
            }
            @foreach (var log in auditLogs)
            {
                <div class="log-r">
                    <div>
                        <span class="log-act">@log.HanhDong</span>
                        <span style="color:var(--text);font-size:.82rem;margin-left:8px;">@log.MoTa</span>
                        <div style="color:var(--muted);font-size:.73rem;margin-top:2px;">@log.DoiTuong #@log.DoiTuongId</div>
                    </div>
                    <div style="color:var(--muted);font-size:.73rem;white-space:nowrap;flex-shrink:0;margin-left:12px;">@log.ThoiGian.ToString("dd/MM HH:mm")</div>
                </div>
            }
            <a href="/Admin/AuditLog" style="color:var(--green2);font-size:.8rem;font-weight:600;text-decoration:none;display:block;margin-top:12px;">Xem toàn bộ Audit Log →</a>
        </div>
    }

    <!-- TAB: PHÍM TẮT -->
    @if (tab == "phimtat")
    {
        <div class="card">
            <div class="ct">⚡ TRUY CẬP NHANH</div>
            <div class="sc-grid">
                <a href="/Admin/DuyetSan" class="sc">
                    <div class="sc-ico">🏟️</div>
                    <div class="sc-lbl">Duyệt sân mới</div>
                    <div class="sc-sub">@sanChoDuyet sân chờ duyệt</div>
                </a>
                <a href="/Admin/KhieuNai" class="sc">
                    <div class="sc-ico">⚠️</div>
                    <div class="sc-lbl">Xử lý khiếu nại</div>
                    <div class="sc-sub">@tongKN khiếu nại chờ</div>
                </a>
                <a href="/Admin/BaoCao" class="sc">
                    <div class="sc-ico">📈</div>
                    <div class="sc-lbl">Báo cáo doanh thu</div>
                    <div class="sc-sub">Giám sát tài chính</div>
                </a>
                <a href="/Admin/MasterData" class="sc">
                    <div class="sc-ico">🗂️</div>
                    <div class="sc-lbl">Master Data</div>
                    <div class="sc-sub">5 danh mục nền tảng</div>
                </a>
                <a href="/Admin/QuanLyUser" class="sc">
                    <div class="sc-ico">👥</div>
                    <div class="sc-lbl">Quản lý tài khoản</div>
                    <div class="sc-sub">@tongUser.ToString("N0") người dùng</div>
                </a>
                <a href="/Admin/AuditLog" class="sc">
                    <div class="sc-ico">🛡️</div>
                    <div class="sc-lbl">Audit Log</div>
                    <div class="sc-sub">Hậu kiểm hành động</div>
                </a>
            </div>
        </div>
    }

    <!-- TAB: THÔNG TIN -->
    @if (tab == "thongtin")
    {
        <div class="card">
            <div class="ct">👤 THÔNG TIN QUẢN TRỊ VIÊN</div>
            <form method="post" action="/Admin/CapNhatThongTin">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Họ và tên</label><input name="hoTen" class="inp mt-1" value="@Model.HoTen" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Email</label><input class="inp mt-1" value="@Model.Email" disabled /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Số điện thoại</label><input name="soDienThoai" class="inp mt-1" value="@Model.SoDienThoai" /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Vai trò</label><input class="inp mt-1" value="⚡ Admin — Quản trị viên hệ thống" disabled style="color:var(--green2);font-weight:600;" /></div>
                    <div class="col-12"><button type="submit" class="btn-i">✓ Lưu thay đổi</button></div>
                </div>
            </form>
        </div>
    }

    <!-- TAB: BẢO MẬT -->
    @if (tab == "baomat")
    {
        <div class="card">
            <div class="ct">🔒 ĐỔI MẬT KHẨU</div>
            <form method="post" action="/Admin/DoiMatKhau">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu hiện tại</label><input type="password" name="matKhauCu" class="inp mt-1" placeholder="••••••••" required /></div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Mật khẩu mới</label><input type="password" name="matKhauMoi" class="inp mt-1" placeholder="Tối thiểu 6 ký tự" minlength="6" required /></div>
                    <div class="col-md-6"><label style="font-size:.76rem;color:var(--muted);">Xác nhận</label><input type="password" name="xacNhanMatKhau" class="inp mt-1" placeholder="Nhập lại" required /></div>
                    <div class="col-12"><button type="submit" class="btn-i">🔒 Đổi mật khẩu</button></div>
                </div>
            </form>
        </div>
    }
</div>
