@model List<Web_Stadium.EFCore.User>
@{
    ViewData["Title"] = "Quản lý Tài khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="padding:0 0 40px;">

    <!-- PAGE HEADER -->
    <div class="pg-header">
        <div class="pg-label">Admin · Quản lý</div>
        <h2>Tài khoản <span class="pg-accent">hệ thống</span></h2>
        <p>Quản lý, phân quyền và khoá/mở tài khoản người dùng</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỘ LỌC -->
    <div class="section-card mb-4">
        <form method="get" class="ph-panel-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="tuKhoa" class="form-control"
                           placeholder="Tên hoặc email..." value="@ViewBag.TuKhoa" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Vai trò</label>
                    <select name="vaiTro" class="form-select">
                        <option value="">Tất cả vai trò</option>
                        <option value="Admin" selected="@(ViewBag.VaiTro == "Admin")">👑 Admin</option>
                        <option value="Owner" selected="@(ViewBag.VaiTro == "Owner")">🏟️ Owner</option>
                        <option value="Staff" selected="@(ViewBag.VaiTro == "Staff")">👷 Staff</option>
                        <option value="User" selected="@(ViewBag.VaiTro == "User")">⚽ User</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Quận / Huyện</label>
                    <select name="quan" class="form-select">
                        <option value="">Tất cả quận</option>
                        @foreach (var q in ViewBag.QuanList)
                        {
                            <option value="@q.TenQuan" selected="@(ViewBag.Quan == q.TenQuan)">@q.TenQuan</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Chủ sân</label>
                    <select name="ownerId" class="form-select">
                        <option value="">Tất cả Owner</option>
                        @foreach (var o in ViewBag.OwnerList)
                        {
                            <option value="@o.Id" selected="@(ViewBag.OwnerId?.ToString() == o.Id.ToString())">@o.HoTen</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="bi bi-search me-1"></i>Tìm
                    </button>
                    <a href="/Admin/QuanLyUser" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle me-1"></i>Xóa
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.VaiTro as string) ||
                        !string.IsNullOrEmpty(ViewBag.TuKhoa as string) ||
                        !string.IsNullOrEmpty(ViewBag.Quan as string) ||
                        ViewBag.OwnerId != null)
            {
                <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
                    <small class="text-muted">Đang lọc:</small>
                    @if (!string.IsNullOrEmpty(ViewBag.TuKhoa as string))
                    {
                        <span class="badge bg-info">Từ khoá: @ViewBag.TuKhoa</span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.VaiTro as string))
                    {
                        <span class="badge bg-primary">Vai trò: @ViewBag.VaiTro</span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Quan as string))
                    {
                        <span class="badge bg-success">Quận: @ViewBag.Quan</span>
                    }
                    @if (ViewBag.OwnerId != null)
                    {
                        <span class="badge bg-warning">Owner ID: @ViewBag.OwnerId</span>
                    }
                    <span class="badge bg-secondary">@Model.Count kết quả</span>
                </div>
            }
        </form>
    </div>

    <!-- BẢNG -->
    <div class="section-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Sân / Địa chỉ</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th style="text-align:center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr style="@(!u.IsActive ? "opacity:.55;" : "")">
                            <td>
                                <div style="font-weight:700;font-size:14px;">@u.HoTen</div>
                                @if (!u.IsActive)
                                {
                                    <small style="color:var(--danger);"><i class="bi bi-lock-fill me-1"></i>Đã khoá</small>
                                }
                            </td>
                            <td><small style="color:var(--muted);">@u.Email</small></td>
                            <td>
                                @{
                                    var badgeColor = u.VaiTro switch
                                    {
                                        "Admin" => "bg-danger",
                                        "Owner" => "bg-primary",
                                        "Staff" => "bg-warning",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeColor">@u.VaiTro</span>
                            </td>
                            <td>
                                @if (u.VaiTro == "Owner")
                                {
                                    var sanCuaOwner = u.SanBongs?.ToList() ?? new();
                                    if (sanCuaOwner.Any())
                                    {
                                        foreach (var s in sanCuaOwner.Take(2))
                                        {
                                            <small style="display:block;color:var(--muted);">
                                                <i class="bi bi-geo-alt-fill" style="color:var(--green);"></i>
                                                @s.TenSan — @s.Quan
                                            </small>
                                        }
                                        if (sanCuaOwner.Count > 2)
                                        {
                                            <small style="color:var(--muted2);">+@(sanCuaOwner.Count - 2) sân khác</small>
                                        }
                                    }
                                    else
                                    {

                                        <small style="color:var(--muted2);">Chưa có sân</small>
                                    }
                                }
                                else if (u.VaiTro == "Staff")
                                {
                                    var sanCuaStaff = u.StaffSanPhanCongs?.ToList() ?? new();
                                    if (sanCuaStaff.Any())
                                    {
                                        foreach (var sp in sanCuaStaff.Take(2))
                                        {
                                            <small style="display:block;color:var(--muted);">
                                                <i class="bi bi-building" style="color:var(--warn);"></i>
                                                @sp.SanBong?.TenSan — @sp.SanBong?.Quan
                                            </small>
                                        }
                                        if (sanCuaStaff.Count > 2)
                                        {
                                            <small style="color:var(--muted2);">+@(sanCuaStaff.Count - 2) sân</small>
                                        }
                                    }
                                    else
                                    {

                                        <small style="color:var(--muted2);">Chưa được gán sân</small>
                                    }
                                }
                                else
                                {

                                    <small style="color:var(--muted2);">—</small>
                                }
                            </td>
                            <td><small style="color:var(--muted);">@u.NgayTao.ToString("dd/MM/yyyy")</small></td>
                            <td>
                                <span class="status-pill @(u.IsActive ? "ok" : "muted")">
                                    @(u.IsActive ? "Hoạt động" : "Đã khoá")
                                </span>
                            </td>
                            <td style="text-align:center;">
                                @if (u.VaiTro != "Admin")
                                {
                                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                                        <div class="dropdown">
                                            <button class="btn btn-outline-primary btn-sm rounded-pill dropdown-toggle"
                                                    type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-person-gear me-1"></i>Vai trò
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (var vt in new[] { "User", "Owner", "Staff" })
                                                {
                                                    <li>
                                                        <form method="post" action="/Admin/DoiVaiTro"
                                                              onsubmit="return confirm('Đổi vai trò @u.HoTen sang @vt?')">
                                                            <input type="hidden" name="id" value="@u.Id" />
                                                            <input type="hidden" name="vaiTro" value="@vt" />
                                                            <button type="submit"
                                                                    class="dropdown-item @(u.VaiTro == vt ? "fw-bold" : "")">
                                                                @(u.VaiTro == vt ? "✓ " : "")@vt
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <form method="post" action="/Admin/DoiTrangThaiTaiKhoan"
                                              style="display:inline"
                                              onsubmit="return confirm('@(u.IsActive ? $"Khoá tài khoản {u.HoTen}?" : $"Mở khoá tài khoản {u.HoTen}?")')">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="isActive" value="@(!u.IsActive)" />
                                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill">
                                                <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                                                @(u.IsActive ? "Khoá" : "Mở khoá")
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {

                                    <span style="color:var(--muted2);">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;color:var(--muted);padding:40px;">
                                Không tìm thấy tài khoản nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
