<style>@@keyframes qs-spin { to { transform: rotate(360deg); } }</style>

<script>
(function () {
    /* Dùng provinces.open-api.vn — tự detect field name từ response */
    var PROV_API = 'https://provinces.open-api.vn/api/';

    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('modalThemQuan');
        if (!modal) return;
        modal.addEventListener('show.bs.modal', function () {
            resetForm();
            loadTinh();
        });
    });

    function getLabel(obj) {
        /* Tự động lấy tên dù field là name / full_name / ward_name / ten */
        return obj.name || obj.full_name || obj.ward_name || obj.ten || obj.Name || '';
    }

    function loadTinh() {
        var sel = document.getElementById('selectTinh');
        if (sel.dataset.loaded) return;
        fetch(PROV_API + 'p/')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                sel.innerHTML = '<option value="">-- Chọn tỉnh / thành phố --</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value       = p.code;           /* code số, dùng để gọi API wards */
                    opt.dataset.name = getLabel(p);     /* tên thật để lưu vào DB */
                    opt.textContent  = getLabel(p);
                    sel.appendChild(opt);
                });
                sel.dataset.loaded = '1';
            })
            .catch(function () {
                sel.innerHTML = '<option value="">⚠ Không tải được — thử lại</option>';
            });
    }

    function resetForm() {
        var tinh  = document.getElementById('selectTinh');
        var phuong = document.getElementById('selectQuan');
        tinh.value = ''; delete tinh.dataset.loaded;
        phuong.innerHTML  = '<option value="">-- Chọn tỉnh trước --</option>';
        phuong.disabled   = true;
        document.getElementById('hiddenThanhPho').value = '';
        document.getElementById('hiddenTenQuan').value  = '';
        document.getElementById('btnThemQuan').disabled = true;
        document.getElementById('phuong-error').style.display   = 'none';
        document.getElementById('phuong-loading').style.display = 'none';
    }

    window.onTinhChange = function (sel) {
        var code = sel.value;
        var selectedOpt = sel.options[sel.selectedIndex];
        /* Lấy tên từ dataset.name (đã set lúc build option) */
        var tinhName = selectedOpt ? (selectedOpt.dataset.name || selectedOpt.textContent) : '';

        document.getElementById('hiddenThanhPho').value = tinhName;
        document.getElementById('hiddenTenQuan').value  = '';
        document.getElementById('btnThemQuan').disabled = true;

        var quanSel = document.getElementById('selectQuan');
        var loading = document.getElementById('phuong-loading');
        var errBox  = document.getElementById('phuong-error');

        errBox.style.display  = 'none';
        quanSel.disabled      = true;
        quanSel.innerHTML     = '<option value="">Đang tải...</option>';

        if (!code) {
            quanSel.innerHTML = '<option value="">-- Chọn tỉnh trước --</option>';
            loading.style.display = 'none';
            return;
        }

        loading.style.display = 'flex';

        /* depth=2 → trả về districts (cũ) hoặc wards tùy phiên bản API */
        fetch(PROV_API + 'p/' + code + '?depth=2')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                loading.style.display = 'none';
                quanSel.disabled = false;

                /* API cũ trả districts, API mới 2 cấp trả wards — handle cả 2 */
                var items = data.wards || data.districts || [];

                if (items.length === 0) {
                    errBox.style.display = 'block';
                    errBox.textContent   = 'Không có dữ liệu cho tỉnh này.';
                    quanSel.innerHTML    = '<option value="">-- Không có dữ liệu --</option>';
                    return;
                }

                quanSel.innerHTML = '<option value="">-- Chọn xã / phường --</option>';
                items.forEach(function (w) {
                    var label = getLabel(w);
                    var opt   = document.createElement('option');
                    opt.value       = label;
                    opt.textContent = label;
                    quanSel.appendChild(opt);
                });
            })
            .catch(function () {
                loading.style.display  = 'none';
                quanSel.disabled       = false;
                quanSel.innerHTML      = '<option value="">-- Chọn xã / phường --</option>';
                errBox.style.display   = 'block';
                errBox.textContent     = 'Không tải được. Kiểm tra kết nối và thử lại.';
            });
    };

    window.onQuanChange = function (sel) {
        var val = sel.value;
        document.getElementById('hiddenTenQuan').value  = val;
        document.getElementById('btnThemQuan').disabled = !val;
    };
})();
</script>

