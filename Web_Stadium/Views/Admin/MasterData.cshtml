@{
    ViewData["Title"] = "Master Data";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var vungs    = ViewBag.Vungs    as List<Web_Stadium.EFCore.VungKhuVuc>    ?? new();
    var quans    = ViewBag.Quans    as List<Web_Stadium.EFCore.DanhMucQuan>   ?? new();
    var dichVus  = ViewBag.DichVus  as List<Web_Stadium.EFCore.DanhMucDichVu> ?? new();
    var loaiSans = ViewBag.LoaiSans as List<Web_Stadium.EFCore.DanhMucLoaiSan>?? new();
    var loaiCos  = ViewBag.LoaiCos  as List<Web_Stadium.EFCore.DanhMucLoaiCo> ?? new();
}

@section Styles {
<style>
/* ── MASTER DATA STYLES ── */
.md-page { padding: 20px 24px 48px; }

/* Toast */
.md-toast { border-radius: 12px; font-size: 14px; font-weight: 600; padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
.md-toast.ok  { background: rgba(0,212,126,.12); border: 1px solid rgba(0,212,126,.3); color: #00ff99; }
.md-toast.err { background: rgba(255,93,115,.12); border: 1px solid rgba(255,93,115,.3); color: #ff5d73; }

/* Section block */
.md-block {
    background: #121923;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 20px;
}

.md-block-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255,255,255,.07);
}

.md-block-title {
    display: flex; align-items: center; gap: 10px;
    font-size: 13px; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase; color: #f5f7fa;
}

.md-block-title .dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
}

.md-add-btn {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 20px;
    color: #f5f7fa;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 14px;
    cursor: pointer;
    transition: .2s;
}
.md-add-btn:hover { background: rgba(0,212,126,.15); border-color: rgba(0,212,126,.3); color: #00d47e; }

/* Table */
.md-table { width: 100%; border-collapse: collapse; }
.md-table tr { border-bottom: 1px solid rgba(255,255,255,.05); transition: .15s; }
.md-table tr:last-child { border-bottom: none; }
.md-table tr:hover { background: rgba(255,255,255,.03); }
.md-table td { padding: 11px 16px; font-size: 14px; color: #f5f7fa; vertical-align: middle; }
.md-table .muted { color: #8fa1b7; font-size: 13px; }

/* Badge tỷ lệ */
.rate-badge {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    border: 1px solid;
}

/* Toggle btn */
.toggle-btn {
    background: none; border: none; cursor: pointer;
    font-size: 12px; font-weight: 600; padding: 4px 10px;
    border-radius: 6px; transition: .15s;
}
.toggle-btn.on  { color: #8fa1b7; }
.toggle-btn.on:hover  { color: #ff5d73; background: rgba(255,93,115,.08); }
.toggle-btn.off { color: #00d47e; }
.toggle-btn.off:hover { color: #00ff99; background: rgba(0,212,126,.08); }

/* Quan chip */
.quan-chip {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 10px;
    padding: 6px 12px;
    font-size: 13px;
    transition: .2s;
}
.quan-chip:hover { background: rgba(255,255,255,.07); }
.quan-chip select {
    background: transparent; border: none;
    font-size: 12px; cursor: pointer; outline: none;
    max-width: 160px;
}

/* Filter buttons */
.filter-btn {
    padding: 4px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 600; cursor: pointer;
    border: 1px solid; transition: .15s;
}

/* Map */
#vung-map {
    height: 420px; width: 100%;
    border-top: 1px solid rgba(255,255,255,.07);
}

/* 2-col grid */
.md-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
/* 3-col grid cho vùng + bản đồ */
.md-grid-map { display: grid; grid-template-columns: 1fr 420px; gap: 0; }
/* 3-col grid cho dịch vụ / loại sân / loại cỏ */
.md-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

@@media(max-width:1100px) {
    .md-grid-3 { grid-template-columns: 1fr 1fr; }
}

/* Modal dark */
.modal-content {
    background: #0f1724 !important;
    border: 1px solid rgba(255,255,255,.1) !important;
    color: #f5f7fa !important;
    border-radius: 16px !important;
}
.modal-header { border-color: rgba(255,255,255,.08) !important; padding: 16px 20px !important; }
.modal-footer { border-color: rgba(255,255,255,.08) !important; }
.modal-title  { font-size: 16px !important; font-weight: 700 !important; color: #f5f7fa !important; }
.modal-body .form-control, .modal-body .form-select {
    background: #1a2535 !important;
    border-color: rgba(255,255,255,.1) !important;
    color: #f5f7fa !important;
    border-radius: 10px !important;
}
.modal-body .form-control:focus {
    border-color: rgba(0,212,126,.4) !important;
    box-shadow: 0 0 0 3px rgba(0,212,126,.12) !important;
}
.modal-body label { color: #8fa1b7 !important; font-size: 13px !important; margin-bottom: 6px !important; }
.modal-body .form-text { color: #64748b !important; }


/* Layout chính: bảng vùng + bản đồ song song */
.vung-map-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 20px;
    margin-bottom: 20px;
}
/* Bảng xã/phường bên dưới bảng vùng */
.xa-phuong-panel {
    background: #121923;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px;
    overflow: hidden;
}

@@media(max-width:1100px) {
    .vung-map-grid { grid-template-columns: 1fr; }
}

@@media(max-width:900px) {
    .md-grid-2   { grid-template-columns: 1fr; }
    .md-grid-map { grid-template-columns: 1fr; }
}
</style>
}

<div class="md-page">

    @if (TempData["Success"] != null)
    {
        <div class="md-toast ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="md-toast err"><i class="bi bi-x-circle-fill"></i> @TempData["Error"]</div>
    }

    <!-- ══ 1. XÃ/PHƯỜNG THEO TỈNH/THÀNH ══ -->
    <div id="section-xa-phuong">
        <div class="md-block">
            <div class="md-block-header">
                <div class="md-block-title">
                    <div class="dot" style="background:#3b82f6;"></div>
                    📍 Xã / Phường theo Tỉnh/Thành
                    <span style="font-size:11px;color:#8fa1b7;font-weight:400;letter-spacing:0;text-transform:none;">(@quans.Count xã/phường · @quans.Select(q=>q.ThanhPho).Distinct().Count() tỉnh/thành)</span>
                </div>
                <button class="md-add-btn" data-bs-toggle="modal" data-bs-target="#modalThemQuan">
                    <i class="bi bi-plus me-1"></i>Thêm mới
                </button>
            </div>
            <!-- Bộ lọc -->
            <div style="padding:12px 20px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:rgba(0,0,0,.12);">
                <div style="position:relative;flex:1;min-width:180px;">
                    <i class="bi bi-search" style="position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#8fa1b7;font-size:13px;pointer-events:none;"></i>
                    <input type="text" id="quan-search" placeholder="Tìm xã/phường hoặc tỉnh/thành..."
                           oninput="filterQuanList()"
                           style="width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
                                  color:#f5f7fa;border-radius:10px;padding:8px 12px 8px 32px;font-size:13px;outline:none;"/>
                </div>
                <select id="quan-vung-filter" onchange="filterQuanList()"
                        style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#f5f7fa;border-radius:10px;padding:8px 13px;font-size:13px;cursor:pointer;color-scheme:dark;">
                    <option value="">🌐 Tất cả vùng</option>
                    @foreach (var v in vungs)
                    {
                        <option value="@v.Id">@v.TenVung (@((v.TyLeHoaHong*100).ToString("F0"))%)</option>
                    }
                    <option value="0">⚪ Chưa gán vùng</option>
                </select>
                <select id="quan-tinh-filter" onchange="onTinhFilterChange(this)"
                        style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#f5f7fa;border-radius:10px;padding:8px 13px;font-size:13px;cursor:pointer;color-scheme:dark;">
                    <option value="">🏙️ Tất cả tỉnh/thành</option>
                    @foreach (var tp in quans.Select(q => q.ThanhPho).Distinct().OrderBy(x => x))
                    {
                        <option value="@tp">@tp</option>
                    }
                </select>
                <button onclick="expandAll()" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#8fa1b7;border-radius:10px;padding:8px 14px;font-size:12px;cursor:pointer;transition:.15s;" onmouseover="this.style.color='#f5f7fa'" onmouseout="this.style.color='#8fa1b7'">
                    ↕ Mở tất cả
                </button>
            </div>
            <!-- Stats -->
            <div style="padding:8px 20px;border-bottom:1px solid rgba(255,255,255,.07);font-size:12px;color:#8fa1b7;display:flex;gap:16px;background:rgba(0,0,0,.08);">
                <span>🟢 Đang hoạt động: <strong style="color:#f5f7fa;">@quans.Count(q => q.IsActive)</strong></span>
                <span>🔴 Đã tắt: <strong style="color:#f5f7fa;">@quans.Count(q => !q.IsActive)</strong></span>
                <span id="quan-filter-count" style="margin-left:auto;"></span>
            </div>
            <!-- Accordion -->
            <div id="quan-accordion" style="max-height:520px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;">
                @{
                    var groupedByTinh = quans.GroupBy(q => q.ThanhPho ?? "Chưa xác định").OrderBy(g => g.Key).ToList();
                }
                @foreach (var tinhGroup in groupedByTinh)
                {
                    var tinhId = "tinh-" + System.Text.RegularExpressions.Regex.Replace(tinhGroup.Key, @"[^a-zA-Z0-9]", "_");
                    var activeCount   = tinhGroup.Count(q => q.IsActive);
                    var inactiveCount = tinhGroup.Count(q => !q.IsActive);
                    <div class="tinh-group" data-tinh="@tinhGroup.Key">
                        <div class="tinh-header" onclick="toggleTinh('@tinhId')"
                             style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;cursor:pointer;transition:.15s;border-bottom:1px solid rgba(255,255,255,.05);"
                             onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background=''">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span id="@(tinhId)-icon" style="font-size:12px;color:#8fa1b7;transition:.2s;">▶</span>
                                <span style="font-size:14px;font-weight:700;color:#f5f7fa;">🏙️ @tinhGroup.Key</span>
                                <span style="font-size:11px;padding:2px 10px;border-radius:20px;background:rgba(59,130,246,.15);color:#93c5fd;border:1px solid rgba(59,130,246,.25);">@tinhGroup.Count() xã/phường</span>
                                @if (activeCount > 0) {
                                    <span style="font-size:11px;padding:2px 10px;border-radius:20px;background:rgba(0,212,126,.1);color:#00d47e;border:1px solid rgba(0,212,126,.2);">@activeCount hoạt động</span>
                                }
                                @if (inactiveCount > 0) {
                                    <span style="font-size:11px;padding:2px 10px;border-radius:20px;background:rgba(255,93,115,.1);color:#ff5d73;border:1px solid rgba(255,93,115,.2);">@inactiveCount đã tắt</span>
                                }
                            </div>
                            <div style="display:flex;gap:5px;flex-wrap:wrap;max-width:300px;justify-content:flex-end;">
                                @foreach (var vungInTinh in tinhGroup.Where(q => q.VungKhuVuc != null).Select(q => q.VungKhuVuc).DistinctBy(v => v!.Id).Take(3))
                                {
                                    <span style="font-size:10px;padding:2px 8px;border-radius:20px;border:1px solid @vungInTinh!.MauSac;color:@vungInTinh.MauSac;background:@(vungInTinh.MauSac)18;">@vungInTinh.TenVung</span>
                                }
                            </div>
                        </div>
                        <div id="@tinhId" style="display:none;background:rgba(0,0,0,.1);">
                            <table class="md-table" style="margin:0;">
                                <thead>
                                    <tr style="border-bottom:1px solid rgba(255,255,255,.06);">
                                        <th style="padding:8px 20px;font-size:10px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;">Xã / Phường</th>
                                        <th style="padding:8px 8px;font-size:10px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;">Vùng hoa hồng</th>
                                        <th style="padding:8px 8px;font-size:10px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:center;">Trạng thái</th>
                                        <th style="padding:8px 8px;font-size:10px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:right;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var q in tinhGroup.OrderBy(q => q.ThuTu))
                                    {
                                        var vungMau = q.VungKhuVuc?.MauSac ?? "#555";
                                        <tr class="quan-row" data-name="@q.TenQuan.ToLower()" data-tinh="@(q.ThanhPho?.ToLower())" data-vung="@(q.VungKhuVucId?.ToString() ?? "0")" style="opacity:@(!q.IsActive ? "0.45" : "1");">
                                            <td style="padding:10px 20px;">
                                                <div style="display:flex;align-items:center;gap:9px;">
                                                    <div style="width:8px;height:8px;border-radius:50%;background:@vungMau;flex-shrink:0;"></div>
                                                    <span style="font-size:14px;font-weight:500;">@q.TenQuan</span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (q.VungKhuVuc != null) {
                                                    <span style="font-size:12px;padding:3px 10px;border-radius:20px;border:1px solid @(q.VungKhuVuc.MauSac);color:@(q.VungKhuVuc.MauSac);background:@(q.VungKhuVuc.MauSac)18;">
                                                        @q.VungKhuVuc.TenVung · @((q.VungKhuVuc.TyLeHoaHong * 100).ToString("F0"))%
                                                    </span>
                                                } else {
                                                    <span style="font-size:12px;color:#8fa1b7;">— Chưa gán</span>
                                                }
                                            </td>
                                            <td style="text-align:center;">
                                                <span style="font-size:11px;padding:3px 10px;border-radius:20px;background:@(q.IsActive ? "rgba(0,212,126,.12)" : "rgba(255,255,255,.06)");color:@(q.IsActive ? "#00d47e" : "#8fa1b7");border:1px solid @(q.IsActive ? "rgba(0,212,126,.25)" : "rgba(255,255,255,.1)");">
                                                    @(q.IsActive ? "Hoạt động" : "Đã tắt")
                                                </span>
                                            </td>
                                            <td style="text-align:right;padding-right:16px;">
                                                <form method="post" action="/Admin/DoiTrangThaiQuan" style="display:inline;">
                                                    <input type="hidden" name="id" value="@q.Id" />
                                                    <input type="hidden" name="isActive" value="@(!q.IsActive)" />
                                                    <button type="submit" class="toggle-btn @(q.IsActive ? "on" : "off")">@(q.IsActive ? "Tắt" : "Bật")</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div id="quan-no-result" style="display:none;padding:32px;text-align:center;color:#8fa1b7;">
                    <div style="font-size:2rem;margin-bottom:8px;">🔍</div>
                    Không tìm thấy xã/phường phù hợp
                </div>
            </div>
        </div>
    </div>

    <!-- ══ 2. PHÂN VÙNG HOA HỒNG + BẢN ĐỒ ══ -->
    <div class="md-block">
        <div class="md-block-header">
            <div class="md-block-title">
                <div class="dot" style="background:#00d47e;"></div>
                🗺️ Phân vùng hoa hồng
                <span style="font-size:11px;color:#8fa1b7;font-weight:400;letter-spacing:0;text-transform:none;">
                    · Bấm vùng để lọc · Sửa tỷ lệ HH trực tiếp
                </span>
            </div>
            <button class="md-add-btn" data-bs-toggle="modal" data-bs-target="#modalThemVung">
                <i class="bi bi-plus me-1"></i>Thêm vùng
            </button>
        </div>

        <div class="md-grid-map">
            <!-- CỘT TRÁI -->
            <div style="border-right:1px solid rgba(255,255,255,.07);">

                <!-- Bảng vùng -->
                <table class="md-table">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(255,255,255,.07);">
                            <th style="padding:10px 16px;font-size:11px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;">Tên vùng</th>
                            <th style="padding:10px 8px;font-size:11px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;">Các xã/phường</th>
                            <th style="padding:10px 8px;font-size:11px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:center;">Tỷ lệ HH</th>
                            <th style="padding:10px 8px;font-size:11px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:center;">Màu</th>
                            <th style="padding:10px 8px;font-size:11px;color:#8fa1b7;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:center;">Số XP</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in vungs)
                        {
                            <tr id="vung-row-@v.Id" onclick="filterVung(@v.Id)" style="cursor:pointer;">
                                <td style="padding:13px 16px;">
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <div style="width:10px;height:10px;border-radius:50%;background:@v.MauSac;flex-shrink:0;box-shadow:0 0 6px @v.MauSac;"></div>
                                        <span style="font-weight:600;font-size:14px;">@v.TenVung</span>
                                    </div>
                                </td>
                                <td class="muted" style="font-size:12px;max-width:200px;" id="vung-xa-col-@v.Id">
                                    @{
                                        var xaList = v.DanhMucQuans ?? new List<Web_Stadium.EFCore.DanhMucQuan>();
                                        var xaArr  = xaList.ToList();
                                    }
                                    @for (var xi = 0; xi < xaArr.Count; xi++)
                                    {
                                        var xaItem = xaArr[xi];
                                        <span class="vung-xa-item"
                                              data-tinh="@(xaItem.ThanhPho?.ToLower())"
                                              style="display:inline;">@xaItem.TenQuan@(xi < xaArr.Count - 1 ? ", " : "")</span>
                                    }
                                    <span class="vung-xa-empty" style="color:#555;display:@(xaArr.Any() ? "none" : "inline");">—</span>
                                </td>
                                <td style="text-align:center;">
                                    <span class="rate-badge" style="color:@v.MauSac;border-color:@v.MauSac;background:@(v.MauSac)18;">
                                        @((v.TyLeHoaHong * 100).ToString("F0"))%
                                    </span>
                                </td>
                                <td style="text-align:center;">
                                    <div style="width:22px;height:22px;border-radius:6px;background:@v.MauSac;margin:auto;"></div>
                                </td>
                                <td style="text-align:center;font-weight:700;color:#8fa1b7;" id="vung-xa-count-@v.Id">@(v.DanhMucQuans?.Count ?? 0)</td>
                                <td style="text-align:center;">
                                    <button class="md-add-btn" style="font-size:11px;padding:3px 10px;"
                                            onclick="event.stopPropagation();moSuaVung(@v.Id,'@v.TenVung',@v.TyLeHoaHong,'@v.MauSac','@v.MoTa')">
                                        Sửa %
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Gán xã/phường vào vùng -->
                <div style="padding:14px 20px;border-top:1px solid rgba(255,255,255,.07);background:rgba(0,0,0,.15);">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;">
                        <span style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#8fa1b7;">Gán xã/phường vào vùng</span>
                        <div style="display:flex;gap:6px;flex-wrap:wrap;">
                            <button onclick="filterVung(null)" id="btn-all" class="filter-btn" style="border-color:#00d47e;color:#fff;background:#00d47e;">Tất cả</button>
                            @foreach (var v in vungs)
                            {
                                <button onclick="filterVung(@v.Id)" id="btn-vung-@v.Id"
                                        class="filter-btn" style="border-color:@v.MauSac;color:@v.MauSac;background:transparent;">
                                    @v.TenVung
                                </button>
                            }
                        </div>
                    </div>
                    <div id="quan-list" style="display:flex;flex-wrap:wrap;gap:6px;">
                        @foreach (var q in quans)
                        {
                            var vungColor = q.VungKhuVuc?.MauSac ?? "#555";
                            var vungId    = q.VungKhuVucId?.ToString() ?? "0";
                            <div class="quan-chip" data-vung="@vungId" data-tinh="@(q.ThanhPho?.ToLower())">
