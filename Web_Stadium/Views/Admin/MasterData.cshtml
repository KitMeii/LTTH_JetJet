@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var vungData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            vungs.Select(v => new {
                id   = v.Id, ten = v.TenVung, mau = v.MauSac,
                tyLe = (double)(v.TyLeHoaHong * 100),
                quans = (v.DanhMucQuans ?? new List<Web_Stadium.EFCore.DanhMucQuan>())
                         .Select(q => new { ten = q.TenQuan, thanhPho = q.ThanhPho }).ToList()
            })
        ));

        var mapCenter = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ViewBag.MapCenter ?? new { lat = 16.0, lng = 107.5, zoom = 6 }
        ));
        var map = L.map('vung-map').setView([mapCenter.lat, mapCenter.lng], mapCenter.zoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap', maxZoom: 18
        }).addTo(map);

        var fillLayers = {}, borderLayers = {}, loadedDonVis = {};

        function getCacheKey(k) { return 'geo_' + k.replace(/\s/g,'_'); }

        function loadDonViGeo(tenQuan, thanhPho, vungId, mau, callback) {
            var key = getCacheKey(tenQuan + '_' + thanhPho);
            var cached = null;
            try { cached = localStorage.getItem(key); } catch(e) {}
            if (cached) { callback(JSON.parse(cached), vungId, mau); return; }
            var query = encodeURIComponent(tenQuan + ', ' + thanhPho + ', Việt Nam');
            // Tìm xã/phường theo OSM
            fetch('https://nominatim.openstreetmap.org/search?q=' + query + '&format=json&polygon_geojson=1&limit=3&countrycodes=vn')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data || !data.length) return;
                    // Ưu tiên kết quả có type polygon (không phải Point)
                    var result = null;
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].geojson && data[i].geojson.type !== 'Point') {
                            result = data[i]; break;
                        }
                    }
                    if (!result) return;
                    var geo = result.geojson;
                    try { localStorage.setItem(key, JSON.stringify(geo)); } catch(e) {}
                    callback(geo, vungId, mau);
                }).catch(function() {});
        }

        function addGeoLayer(geo, vungId, mau) {
            if (geo.type === 'Point') return;
            var fill = L.geoJSON(geo, { style: { color: mau, weight: 1.5, fillColor: mau, fillOpacity: 0.18, opacity: 0.6 } }).addTo(map);
            var border = L.geoJSON(geo, { style: { color: mau, weight: 2.5, fillOpacity: 0, dashArray: '6,4', opacity: 0.85 } }).addTo(map);
            border.on('mouseover', function() { border.setStyle({ weight: 4, opacity: 1 }); fill.setStyle({ fillOpacity: 0.32 }); });
            border.on('mouseout',  function() { if (activeVung === null || activeVung === vungId) { border.setStyle({ weight: 2.5, opacity: 0.85 }); fill.setStyle({ fillOpacity: activeVung === vungId ? 0.32 : 0.18 }); } });
            border.on('click', function() { filterVung(vungId); });
            fill.on('click',   function() { filterVung(vungId); });
            if (!fillLayers[vungId])   fillLayers[vungId]   = [];
            if (!borderLayers[vungId]) borderLayers[vungId] = [];
            fillLayers[vungId].push(fill);
            borderLayers[vungId].push(border);
        }

        vungData.forEach(function(v) {
            v.quans.forEach(function(q) {
                if (loadedDonVis[q.ten]) return;
                loadedDonVis[q.ten] = true;
                setTimeout(function() { loadDonViGeo(q.ten, q.thanhPho, v.id, v.mau, addGeoLayer); }, Object.keys(loadedDonVis).length * 300);
            });
        });

        var activeVung = null;

        // ── Expose tất cả function ra global scope ──
        window.filterVung     = filterVung;
        window.moSuaVung      = moSuaVung;
        window.toggleTinh     = toggleTinh;
        window.expandAll      = expandAll;
        window.filterQuanList = filterQuanList;
        window.onTinhFilterChange = onTinhFilterChange;

        // ── Lọc tỉnh: lọc accordion + bảng vùng ──
        function onTinhFilterChange(sel) {
            var tinh = (sel.value || '').toLowerCase();

            // 1. Lọc accordion xã/phường
            filterQuanList();

            // 2. Lọc cột xã/phường trong bảng vùng hoa hồng
            document.querySelectorAll('[id^="vung-xa-col-"]').forEach(function(col) {
                var vungId  = col.id.replace('vung-xa-col-', '');
                var items   = col.querySelectorAll('.vung-xa-item');
                var visCount = 0;

                items.forEach(function(span) {
                    var spanTinh = (span.dataset.tinh || '').toLowerCase();
                    var show     = !tinh || spanTinh === tinh;
                    span.style.display = show ? 'inline' : 'none';
                    if (show) visCount++;
                });

                // Empty state
                var emptyEl = col.querySelector('.vung-xa-empty');
                if (emptyEl) emptyEl.style.display = visCount === 0 ? 'inline' : 'none';

                // Cập nhật số đếm
                var countEl = document.getElementById('vung-xa-count-' + vungId);
                if (countEl) {
                    var total = items.length;
                    countEl.textContent = tinh ? (visCount + ' / ' + total) : total;
                    countEl.style.color = (tinh && visCount === 0) ? '#555' : '#8fa1b7';
                }
            });

            // 3. Lọc chip gán vùng
            document.querySelectorAll('.quan-chip').forEach(function(chip) {
                var chipTinh = (chip.dataset.tinh || '').toLowerCase();
                chip.style.display = (!tinh || chipTinh === tinh) ? 'inline-flex' : 'none';
            });
        }

        function filterVung(vungId) {
            activeVung = vungId;
            vungData.forEach(function(v) {
                var isActive = !vungId || v.id === vungId;
                (fillLayers[v.id]   || []).forEach(function(l) { l.setStyle({ fillOpacity: isActive ? 0.32 : 0.04 }); });
                (borderLayers[v.id] || []).forEach(function(l) { l.setStyle({ opacity: isActive ? 0.9 : 0.15, weight: isActive ? 3 : 1 }); });
            });
            document.querySelectorAll('[id^="vung-row-"]').forEach(function(r) { r.style.background = ''; });
            document.querySelectorAll('.quan-chip').forEach(function(chip) {
                chip.style.display = (!vungId || chip.dataset.vung == vungId) ? 'inline-flex' : 'none';
            });
            document.querySelectorAll('[id^="btn-vung-"]').forEach(function(b) {
                b.style.background = 'transparent'; b.style.fontWeight = 'normal';
                b.style.color = b.dataset.origColor || '';
            });
            document.getElementById('btn-all').style.background = vungId ? 'transparent' : '#00d47e';
            document.getElementById('btn-all').style.color = vungId ? '#8fa1b7' : '#fff';
            if (vungId) {
                var v = vungData.find(function(x) { return x.id === vungId; });
                if (!v) return;
                var row = document.getElementById('vung-row-' + vungId);
                if (row) row.style.background = v.mau + '18';
                var btn = document.getElementById('btn-vung-' + vungId);
                if (btn) { btn.style.background = v.mau; btn.style.color = '#fff'; btn.style.fontWeight = '700'; }
                var allLayers = (fillLayers[vungId] || []);
                if (allLayers.length > 0) {
                    var bounds = L.latLngBounds([]);
                    allLayers.forEach(function(l) { try { bounds.extend(l.getBounds()); } catch(e) {} });
                    if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40] });
                }
                var panel = document.getElementById('vung-detail-panel');
                var list  = document.getElementById('vung-detail-list');
                if (panel && list) {
                    panel.style.display = 'block';
                    list.innerHTML = v.quans.length
                        ? v.quans.map(function(q) { return '<span style="padding:4px 10px;border-radius:20px;border:1px solid '+v.mau+';color:'+v.mau+';font-size:12px;">'+q.ten+'</span>'; }).join('')
                        : '<span style="font-size:13px;color:#8fa1b7;">Chưa có xã/phường nào</span>';
                    document.getElementById('map-legend').textContent = v.ten + ' — ' + v.tyLe + '%';
                }
            } else {
                var panel = document.getElementById('vung-detail-panel');
                if (panel) panel.style.display = 'none';
                document.getElementById('map-legend').textContent = 'Bấm vùng để lọc';
                map.setView([mapCenter.lat, mapCenter.lng], mapCenter.zoom);
            }
        }

        function moSuaVung(id, ten, tyLe, mau, moTa) {
            document.getElementById('suaVungId').value = id;
            document.getElementById('suaVungTitle').textContent = 'Sửa vùng: ' + ten;
            document.getElementById('suaVungTyLe').value = tyLe;
            document.getElementById('suaVungMauSac').value = mau;
            document.getElementById('suaVungMoTa').value = moTa || '';
            new bootstrap.Modal(document.getElementById('modalSuaVung')).show();
        }

        document.querySelectorAll('[id^="btn-vung-"]').forEach(function(b) {
            b.dataset.origColor = b.style.color;
        });

        // ── Xã/Phường Accordion ──
        function toggleTinh(id) {
            var el   = document.getElementById(id);
            var icon = document.getElementById(id + '-icon');
            if (!el) return;
            var isOpen = el.style.display !== 'none';
            el.style.display   = isOpen ? 'none' : 'block';
            icon.textContent   = isOpen ? '▶' : '▼';
            icon.style.color   = isOpen ? '#8fa1b7' : '#00d47e';
        }

        function expandAll() {
            var allPanels = document.querySelectorAll('[id^="tinh-"]');
            var anyOpen = Array.from(allPanels).some(function(p) { return p.style.display !== 'none'; });
            allPanels.forEach(function(p) {
                var icon = document.getElementById(p.id + '-icon');
                if (anyOpen) {
                    p.style.display = 'none';
                    if (icon) { icon.textContent = '▶'; icon.style.color = '#8fa1b7'; }
                } else {
                    p.style.display = 'block';
                    if (icon) { icon.textContent = '▼'; icon.style.color = '#00d47e'; }
                }
            });
        }
        function filterQuanList() {
            var searchVal = (document.getElementById('quan-search').value || '').toLowerCase().trim();
            var vungVal   = document.getElementById('quan-vung-filter').value;
            var tinhVal   = (document.getElementById('quan-tinh-filter').value || '').toLowerCase();

            var totalVisible = 0;
            var tinhGroups = document.querySelectorAll('.tinh-group');

            tinhGroups.forEach(function(tinhEl) {
                var tinhName = (tinhEl.dataset.tinh || '').toLowerCase();
                // Lọc tỉnh
                if (tinhVal && tinhName !== tinhVal) {
                    tinhEl.style.display = 'none';
                    return;
                }
                // Kiểm tra từng xã/phường trong tỉnh
                var rows = tinhEl.querySelectorAll('.quan-row');
                var visibleInTinh = 0;
                rows.forEach(function(row) {
                    var name  = row.dataset.name  || '';
                    var vung  = row.dataset.vung  || '';
                    var matchSearch = !searchVal || name.includes(searchVal) || tinhName.includes(searchVal);
                    var matchVung   = !vungVal   || vung === vungVal;
                    if (matchSearch && matchVung) {
                        row.style.display = '';
                        visibleInTinh++;
                        totalVisible++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Hiện/ẩn tỉnh
                if (visibleInTinh === 0) {
                    tinhEl.style.display = 'none';
                } else {
                    tinhEl.style.display = '';
                    // Auto expand khi đang tìm kiếm
                    if (searchVal || vungVal) {
                        var tinhId = tinhEl.querySelector('[id$="-icon"]')?.id?.replace('-icon','');
                        if (tinhId) {
                            var panel = document.getElementById(tinhId);
                            var icon  = document.getElementById(tinhId + '-icon');
                            if (panel) { panel.style.display = 'block'; }
                            if (icon)  { icon.textContent = '▼'; icon.style.color = '#00d47e'; }
                        }
                    }
                }
            });

            var noResult = document.getElementById('quan-no-result');
            if (noResult) noResult.style.display = totalVisible === 0 ? 'block' : 'none';

            var countEl = document.getElementById('quan-filter-count');
            if (countEl) {
                countEl.textContent = (searchVal || vungVal || tinhVal)
                    ? ('Đang hiển thị ' + totalVisible + ' xã/phường')
                    : '';
            }
        }
    </script>
}
