@model Web_Stadium.EFCore.SanBong
@{
    ViewData["Title"] = "Xem hợp đồng — " + Model.TenSan;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="padding:0 0 40px;max-width:860px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Hợp đồng</div>
        <h2>Hợp đồng <span class="pg-accent">@Model.TenSan</span></h2>
        <p>Nội dung hợp đồng điện tử đã ký kết</p>
    </div>

    <!-- Thống kê nhanh -->
    <div class="section-card mb-4">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;">
            <div style="padding:18px 20px;border-right:1px solid var(--border);">
                <div style="font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--muted2);text-transform:uppercase;margin-bottom:7px;">🏟️ Sân bóng</div>
                <div style="font-weight:700;font-size:15px;">@Model.TenSan</div>
                <div style="font-size:12px;color:var(--muted);margin-top:3px;">@Model.DiaChi — @Model.Quan</div>
            </div>
            <div style="padding:18px 20px;border-right:1px solid var(--border);">
                <div style="font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--muted2);text-transform:uppercase;margin-bottom:7px;">👤 Chủ sân</div>
                <div style="font-weight:700;font-size:15px;">@(Model.Owner?.HoTen ?? "—")</div>
                <div style="font-size:12px;color:var(--muted);margin-top:3px;">@(Model.Owner?.SoDienThoai ?? Model.Owner?.Email ?? "")</div>
            </div>
            <div style="padding:18px 20px;">
                <div style="font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--muted2);text-transform:uppercase;margin-bottom:7px;">📅 Ngày ký</div>
                <div style="font-weight:700;font-size:15px;color:var(--green2);">@(Model.NgayKyHopDong?.ToString("dd/MM/yyyy") ?? "—")</div>
                <div style="font-size:12px;color:var(--muted);margin-top:3px;">@(Model.NgayKyHopDong?.ToString("HH:mm") ?? "")</div>
            </div>
        </div>
    </div>

    <!-- Nội dung hợp đồng -->
    <div class="section-card mb-4">
        <div class="ph-panel-head">
            <h5>📄 Nội dung hợp đồng</h5>
            <div style="display:flex;gap:8px;">
                <a href="/Admin/XuatWordHopDong?sanId=@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill">
                    <i class="bi bi-file-earmark-word me-1"></i>Xuất Word
                </a>
                <a href="/Admin/TatCaHopDong" class="btn btn-outline-secondary btn-sm rounded-pill">
                    ← Quay lại
                </a>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.NoiDungHopDong))
        {
            <div style="padding:28px 32px;max-height:640px;overflow-y:auto;
                            font-family:'Courier New',monospace;font-size:13px;
                            line-height:2.0;color:var(--muted);
                            white-space:pre-wrap;background:rgba(0,0,0,.12);">
                @Model.NoiDungHopDong
            </div>
        }
        else
        {
            <div style="padding:48px;text-align:center;color:var(--muted);font-style:italic;">
                Không có nội dung hợp đồng.
            </div>
        }
    </div>

    <!-- Trạng thái -->
    <div style="text-align:center;padding:22px;border:1px solid rgba(0,212,126,.22);
                border-radius:16px;background:rgba(0,212,126,.05);">
        <div style="font-size:2rem;margin-bottom:10px;">✅</div>
        <div style="font-weight:700;font-size:16px;color:var(--green2);margin-bottom:5px;">
            Hợp đồng đã ký kết và có hiệu lực
        </div>
        <div style="font-size:13px;color:var(--muted);">
            Ký lúc @(Model.NgayKyHopDong?.ToString("HH:mm — dd/MM/yyyy") ?? "—")
        </div>
    </div>
</div>
