@{
    ViewData["Title"] = "Khiếu nại";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var khieuNais = ViewBag.KhieuNais as List<Web_Stadium.EFCore.KhieuNai> ?? new();
}

@section Styles {
    <style>
        .kn-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            transition: border-color .2s,transform .2s;
            margin-bottom: 14px;
        }

            .kn-card:hover {
                border-color: var(--border2);
                transform: translateY(-1px);
            }

            .kn-card.urgent {
                border-color: rgba(255,93,115,.3);
            }

        .kn-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,.02);
            flex-wrap: wrap;
        }

        .kn-body {
            padding: 16px 18px;
        }

        .kn-reason {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13.5px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 14px;
        }

        .kn-meta {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .kn-meta-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .kn-meta-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: var(--muted2);
            text-transform: uppercase;
        }

        .kn-meta-val {
            font-size: 13.5px;
            font-weight: 600;
        }

        .kn-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .amount-big {
            font-size: 22px;
            font-weight: 800;
            color: var(--warn);
        }
    </style>
}

<div style="padding:0 0 40px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Quản lý</div>
        <h2>Khiếu nại <span class="pg-accent">chờ xử lý</span></h2>
        <p>Xử lý hoàn tiền và phản hồi khiếu nại từ người dùng</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!khieuNais.Any())
    {
        <div style="text-align:center;padding:80px 0;">
            <div style="font-size:3rem;margin-bottom:16px;">🎉</div>
            <div style="font-size:20px;font-weight:700;margin-bottom:8px;">Không có khiếu nại nào</div>
            <div style="color:var(--muted);">Tất cả khiếu nại đã được xử lý</div>
        </div>
    }
    else
    {
        <!-- Tổng quan -->
        <div class="section-card mb-4">
            <div style="display:flex;gap:0;overflow:hidden;border-radius:16px;">
                <div style="flex:1;padding:18px 20px;border-right:1px solid var(--border);text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--warn);">@khieuNais.Count</div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Chờ xử lý</div>
                </div>
                <div style="flex:1;padding:18px 20px;border-right:1px solid var(--border);text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--danger);">
                        @((khieuNais.Sum(k => k.SoTienHoan ?? 0) / 1_000_000.0m).ToString("F1"))M
                    </div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Tổng hoàn tiền (VNĐ)</div>
                </div>
                <div style="flex:1;padding:18px 20px;text-align:center;">
                    <div style="font-size:28px;font-weight:800;color:var(--blue);">
                        @khieuNais.Select(k => k.DatSan?.KhungGio?.SanBongId).Distinct().Count()
                    </div>
                    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;">Sân liên quan</div>
                </div>
            </div>
        </div>

        @foreach (var kn in khieuNais.OrderByDescending(k => k.NgayGui))
        {
            var isUrgent = kn.SoTienHoan > 500000;
            <div class="kn-card @(isUrgent ? "urgent" : "")">
                <div class="kn-head">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:38px;height:38px;border-radius:11px;background:rgba(246,170,56,.12);border:1px solid rgba(246,170,56,.2);display:flex;align-items:center;justify-content:center;font-size:18px;">
                            ⚠️
                        </div>
                        <div>
                            <div style="font-weight:700;font-size:14px;">
                                @(kn.User?.HoTen ?? "Người dùng")
                            </div>
                            <div style="font-size:12px;color:var(--muted);">
                                @(kn.User?.Email ?? "") · #KN@kn.Id
                            </div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        @if (isUrgent)
                        {
                            <span class="status-pill danger">Ưu tiên cao</span>
                        }
                        <span style="font-size:12px;color:var(--muted2);">@kn.NgayGui.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="kn-body">
                    <div class="kn-meta">
                        <div class="kn-meta-item">
                            <span class="kn-meta-label">🏟️ Sân bóng</span>
                            <span class="kn-meta-val">@(kn.DatSan?.KhungGio?.SanBong?.TenSan ?? "—")</span>
                        </div>
                        <div class="kn-meta-item">
                            <span class="kn-meta-label">📅 Ngày thi đấu</span>
                            <span class="kn-meta-val">@(kn.DatSan != null ? kn.DatSan.NgayThiDau.ToString("dd/MM/yyyy") : "—")</span>
                        </div>
                        <div class="kn-meta-item">
                            <span class="kn-meta-label">⏰ Khung giờ</span>
                            <span class="kn-meta-val">@(kn.DatSan?.KhungGio?.GioBatDau.ToString(@"hh\:mm") ?? "—") – @(kn.DatSan?.KhungGio?.GioKetThuc.ToString(@"hh\:mm") ?? "")</span>
                        </div>
                        <div class="kn-meta-item">
                            <span class="kn-meta-label">💰 Hoàn tiền</span>
                            <span class="amount-big">@((kn.SoTienHoan ?? 0).ToString("N0"))đ</span>
                        </div>
                    </div>
                    <div class="kn-reason">
                        <strong style="color:var(--text);">Lý do khiếu nại:</strong><br />
                        @kn.LyDo
                    </div>
                    @if (!string.IsNullOrEmpty(kn.GhiChuAdmin))
                    {
                        <div style="background:rgba(108,174,224,.06);border:1px solid rgba(108,174,224,.15);border-radius:10px;padding:10px 14px;font-size:13px;color:var(--blue);margin-bottom:14px;">
                            <strong>Ghi chú Admin:</strong> @kn.GhiChuAdmin
                        </div>
                    }
                    <div class="kn-actions">
                        <form method="post" action="/Admin/XuLyKhieuNai"
                              onsubmit="return confirm('Xác nhận hoàn tiền @((kn.SoTienHoan ?? 0).ToString("N0"))đ cho @(kn.User?.HoTen)?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@kn.Id" />
                            <input type="hidden" name="action" value="HoanTien" />
                            <button type="submit" class="btn btn-success">💰 Chấp nhận hoàn tiền</button>
                        </form>
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="collapse"
                                data-bs-target="#ghiChu_@kn.Id">
                            📝 Ghi chú
                        </button>
                        <form method="post" action="/Admin/XuLyKhieuNai"
                              onsubmit="return confirm('Từ chối khiếu nại của @(kn.User?.HoTen)?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@kn.Id" />
                            <input type="hidden" name="action" value="TuChoi" />
                            <button type="submit" class="btn btn-outline-danger">✕ Từ chối</button>
                        </form>
                    </div>
                    <div class="collapse mt-3" id="ghiChu_@kn.Id">
                        <form method="post" action="/Admin/GhiChuKhieuNai">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@kn.Id" />
                            <div style="display:flex;gap:8px;">
                                <input type="text" name="ghiChu" class="form-control"
                                       placeholder="Nội dung ghi chú..."
                                       value="@kn.GhiChuAdmin" />
                                <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
