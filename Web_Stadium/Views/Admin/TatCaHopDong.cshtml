@model List<Web_Stadium.EFCore.SanBong>
@{
    ViewData["Title"] = "Tất cả hợp đồng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tuKhoa = ViewBag.TuKhoa as string ?? "";
    var sapXep = ViewBag.SapXep as string ?? "gan_nhat";
    var tongHD = (int)(ViewBag.TongHD ?? Model.Count);
}

@section Styles {
    <style>
        .hd-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            transition: border-color .2s,transform .2s;
            margin-bottom: 14px;
        }

            .hd-card:hover {
                border-color: rgba(0,212,126,.22);
                transform: translateY(-1px);
            }

        .hd-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,.02);
            flex-wrap: wrap;
        }

        .hd-body {
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hd-stat {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 100px;
        }

        .hd-stat-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: var(--muted2);
            text-transform: uppercase;
        }

        .hd-stat-val {
            font-size: 15px;
            font-weight: 700;
        }

        .hd-divider {
            width: 1px;
            height: 36px;
            background: var(--border);
            flex-shrink: 0;
        }

        .hd-actions {
            margin-left: auto;
            display: flex;
            gap: 8px;
        }
    </style>
}

<div style="padding:0 0 40px;">

    <div class="pg-header">
        <div class="pg-label">Admin · Hợp đồng</div>
        <h2>Hợp đồng <span class="pg-accent">đã ký</span></h2>
        <p>Tất cả hợp đồng hợp tác kinh doanh với chủ sân trong hệ thống</p>
    </div>

    <!-- BỘ LỌC -->
    <div class="section-card mb-4">
        <form method="get" class="ph-panel-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="tuKhoa" class="form-control"
                           placeholder="Tên sân hoặc chủ sân..." value="@tuKhoa" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sắp xếp</label>
                    <select name="sapXep" class="form-select">
                        <option value="gan_nhat" selected="@(sapXep == "gan_nhat")">Gần nhất</option>
                        <option value="cu_nhat" selected="@(sapXep == "cu_nhat")">Cũ nhất</option>
                        <option value="ten_san" selected="@(sapXep == "ten_san")">Tên sân A–Z</option>
                        <option value="chu_san" selected="@(sapXep == "chu_san")">Chủ sân A–Z</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="bi bi-search me-1"></i>Tìm
                    </button>
                    <a href="/Admin/TatCaHopDong" class="btn btn-outline-secondary flex-fill">Reset</a>
                </div>
            </div>
        </form>
        <div style="padding:12px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;">
            <span style="font-size:13px;color:var(--muted);">Hiển thị:</span>
            <strong style="color:var(--text);">@Model.Count</strong>
            <span style="font-size:13px;color:var(--muted);">/ tổng</span>
            <strong style="color:var(--green2);">@tongHD</strong>
            <span style="font-size:13px;color:var(--muted);">hợp đồng</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 0;color:var(--muted);">
            <div style="font-size:2.5rem;margin-bottom:12px;">📄</div>
            <div style="font-size:16px;">Không tìm thấy hợp đồng nào.</div>
        </div>
    }
    else
    {
        @foreach (var san in Model)
        {
            if (san.NgayKyHopDong == null) { continue; }
            <div class="hd-card">
                <div class="hd-head">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:40px;height:40px;border-radius:11px;background:rgba(0,212,126,.1);border:1px solid rgba(0,212,126,.2);display:flex;align-items:center;justify-content:center;font-size:18px;">📄</div>
                        <div>
                            <div style="font-weight:800;font-size:15px;">@san.TenSan</div>
                            <div style="font-size:12px;color:var(--muted);">@san.DiaChi, @san.Quan</div>
                        </div>
                    </div>
                    <span class="status-pill ok">✅ Có hiệu lực</span>
                </div>
                <div class="hd-body">
                    <div class="hd-stat">
                        <span class="hd-stat-label">👤 Chủ sân</span>
                        <span class="hd-stat-val">@(san.Owner?.HoTen ?? "—")</span>
                        <span style="font-size:11.5px;color:var(--muted);">@(san.Owner?.Email ?? "")</span>
                    </div>
                    <div class="hd-divider"></div>
                    <div class="hd-stat">
                        <span class="hd-stat-label">📅 Ngày ký</span>
                        <span class="hd-stat-val" style="color:var(--green2);">@san.NgayKyHopDong?.ToString("dd/MM/yyyy")</span>
                        <span style="font-size:11.5px;color:var(--muted);">@san.NgayKyHopDong?.ToString("HH:mm")</span>
                    </div>
                    <div class="hd-divider"></div>
                    <div class="hd-stat">
                        <span class="hd-stat-label">⚽ Loại sân</span>
                        <span class="hd-stat-val">@san.LoaiSan · @san.LoaiCo</span>
                    </div>
                    <div class="hd-actions">
                        <a href="/Admin/XemHopDong/@san.Id" class="btn btn-outline-success btn-sm rounded-pill">
                            👁 Xem HĐ
                        </a>
                        <a href="/Admin/XuatWordHopDong?sanId=@san.Id" class="btn btn-outline-primary btn-sm rounded-pill">
                            📄 Xuất Word
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
