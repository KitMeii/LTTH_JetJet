@{
    ViewData["Title"] = "Báo cáo giải đấu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bieu = ViewBag.Bieu6Thang as List<object> ?? new();
    var topOwner = ViewBag.TopOwner as List<dynamic> ?? new();
}

@section Styles {
    <style>
        .kpi-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 22px;
            text-align: center;
            box-shadow: var(--shadow-sm);
        }

        .kpi-val {
            font-family: var(--ff-h);
            font-size: 2rem;
            font-weight: 800;
            color: var(--green);
        }

        .kpi-lbl {
            font-size: 12px;
            color: var(--muted);
            letter-spacing: .5px;
            margin-top: 4px;
        }

        .chart-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 22px;
        }

        .chart-title {
            font-family: var(--ff-h);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 18px;
        }

        .owner-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

            .owner-row:last-child {
                border-bottom: none;
            }

        .owner-rank {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--bg3);
            color: var(--text);
            font-family: var(--ff-h);
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .owner-rank-1 {
            background: rgba(255,215,0,.15);
            color: #FFD700;
        }

        .owner-rank-2 {
            background: rgba(192,192,192,.15);
            color: #C0C0C0;
        }

        .owner-rank-3 {
            background: rgba(205,127,50,.15);
            color: #CD7F32;
        }
    </style>
}


</div>

<div class="container" style="padding-top:24px;padding-bottom:40px;">

    <!-- KPI row -->
    <div class="row g-3 mb-5">
        @foreach (var (ico, val, lbl) in new[]{
                ("🏆", ((int)(ViewBag.TongGiaiDau ?? 0)).ToString(), "Tổng giải đấu"),
                ("🏁", ((int)(ViewBag.GiaiHoanThanh ?? 0)).ToString(), "Đã hoàn thành"),
                ("⚽", ((int)(ViewBag.TongDoi ?? 0)).ToString(), "Tổng đội tham dự"),
                ("📋", ((int)(ViewBag.TongTranDau ?? 0)).ToString(), "Trận đã diễn ra"),
                ("💰", ((decimal)(ViewBag.TongDoanhThu ?? 0m)).ToString("N0") + "đ", "Tổng lệ phí thu"),
                })
        {
            <div class="col-6 col-md">
                <div class="kpi-card">
                    <div style="font-size:1.5rem;margin-bottom:8px">@ico</div>
                    <div class="kpi-val">@val</div>
                    <div class="kpi-lbl">@lbl</div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Biểu đồ doanh thu 6 tháng -->
        <div class="col-12 col-lg-8">
            <div class="chart-card">
                <div class="chart-title">📈 DOANH THU LỆ PHÍ 6 THÁNG GẦN NHẤT</div>
                <canvas id="chartDoanhThu" height="180"></canvas>
            </div>

            <div class="chart-card mt-3">
                <div class="chart-title">🏆 SỐ GIẢI ĐẤU & ĐỘI THAM DỰ</div>
                <canvas id="chartGiai" height="120"></canvas>
            </div>
        </div>

        <!-- Top Owner -->
        <div class="col-12 col-lg-4">
            <div class="chart-card" style="height:100%">
                <div class="chart-title">🥇 TOP OWNER TỔ CHỨC GIẢI</div>
                @foreach (var (o, i) in topOwner.Select((x, i) => (x, i)))
                {
                    var rankClass = i == 0 ? "owner-rank-1" : i == 1 ? "owner-rank-2" : i == 2 ? "owner-rank-3" : "";
                    <div class="owner-row">
                        <div class="owner-rank @rankClass">@(i + 1)</div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:700;font-size:13px;
                                                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                @o.HoTen
                            </div>
                            <div style="font-size:11px;color:var(--muted)">@o.Email</div>
                        </div>
                        <div style="text-align:right;flex-shrink:0">
                            <div style="font-family:var(--ff-h);font-size:1.1rem;color:var(--green)">
                                @o.SoGiai
                            </div>
                            <div style="font-size:10px;color:var(--muted)">giải</div>
                        </div>
                    </div>
                }
                @if (!topOwner.Any())
                {
                    <p style="color:var(--muted);text-align:center;padding:30px 0">Chưa có dữ liệu.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        var bieuData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bieu));

        var labels   = bieuData.map(function(d) { return d.thang; });
        var doanhThu = bieuData.map(function(d) { return d.doanhThu; });
        var soGiai   = bieuData.map(function(d) { return d.soGiai; });
        var soDoi    = bieuData.map(function(d) { return d.soDoiThanhToan; });

        // Chart 1: Doanh thu
        new Chart(document.getElementById('chartDoanhThu'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu lệ phí (đ)',
                    data: doanhThu,
                    backgroundColor: 'rgba(14,168,106,.7)',
                    borderColor: '#0EA86A',
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.raw.toLocaleString('vi-VN') + 'đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        grid: { color: 'rgba(255,255,255,.05)' },
                        ticks: {
                            color: '#888',
                            callback: function(v) { return (v/1000000).toFixed(1) + 'M'; }
                        }
                    },
                    x: { grid: { display: false }, ticks: { color: '#888' } }
                }
            }
        });

        // Chart 2: Số giải & đội
        new Chart(document.getElementById('chartGiai'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Số giải',
                        data: soGiai,
                        borderColor: '#0EA5E9',
                        backgroundColor: 'rgba(14,165,233,.1)',
                        borderWidth: 2,
                        tension: .4,
                        fill: true,
                        pointRadius: 4
                    },
                    {
                        label: 'Số đội',
                        data: soDoi,
                        borderColor: '#F59E0B',
                        backgroundColor: 'rgba(245,158,11,.08)',
                        borderWidth: 2,
                        tension: .4,
                        fill: true,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: '#aaa', font: { size: 12 } }
                    }
                },
                scales: {
                    y: { grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: '#888' } },
                    x: { grid: { display: false }, ticks: { color: '#888' } }
                }
            }
        });
    </script>
}
