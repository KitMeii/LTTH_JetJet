@model Web_Stadium.EFCore.User
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var tab = ViewBag.Tab as string ?? "thongtin";
    var lichSu = ViewBag.LichSu as List<Web_Stadium.EFCore.DatSan> ?? new();
    var diemLogs = ViewBag.DiemLogs as List<Web_Stadium.EFCore.DiemThuongLog> ?? new();
    var vouchers = ViewBag.Vouchers as List<Web_Stadium.EFCore.UserVoucher> ?? new();
    var vouchersCoTheDoi = ViewBag.VouchersCoTheDoi as List<Web_Stadium.EFCore.Voucher> ?? new();

    string TrangThaiClass(string t) => t switch
    {
        "ChoDuyet" => "badge bg-warning text-dark",
        "DaXacNhan" => "badge bg-success",
        "DangSuDung" => "badge bg-primary",
        "HoanThanh" => "badge bg-secondary",
        "DaHuy" => "badge bg-danger",
        _ => "badge bg-light text-dark"
    };
    string TrangThaiText(string t) => t switch
    {
        "ChoDuyet" => "⏳ Chờ xác nhận",
        "DaXacNhan" => "✅ Đã xác nhận",
        "DangSuDung" => "⚽ Đang đá",
        "HoanThanh" => "🏁 Hoàn thành",
        "DaHuy" => "❌ Đã hủy",
        _ => t
    };
}

@section Styles {
    <style>
        /* ── HoSo — Light theme khớp custom.css ── */
        .profile-wrapper {
            max-width: 960px;
            margin: 100px auto 60px;
            padding: 0 16px;
        }

        /* Avatar card — dùng gradient xanh thương hiệu */
        .profile-avatar-card {
            background: linear-gradient(135deg,#0a4a2a,#0EA86A);
            border-radius: 20px;
            padding: 30px 28px;
            display: flex;
            align-items: center;
            gap: 22px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(14,168,106,.25);
        }

        .avatar-circle {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            border: 3px solid rgba(255,255,255,.35);
        }

        .avatar-info h4 {
            color: #fff;
            margin: 0 0 4px;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .avatar-info .badge-role {
            font-size: .73rem;
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(255,255,255,.2);
            color: #fff;
            border: 1px solid rgba(255,255,255,.3);
        }

        .avatar-info .diem-badge {
            margin-left: 8px;
            font-size: .73rem;
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(255,255,255,.15);
            color: #fff;
        }

        .avatar-info .info-sub {
            color: rgba(255,255,255,.75);
            font-size: .8rem;
            margin-top: 4px;
        }

        /* Tab navigation */
        .profile-tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .profile-tab-btn {
            padding: 8px 16px;
            border-radius: 999px;
            font-size: .84rem;
            text-decoration: none;
            transition: all .2s;
            border: 1px solid var(--border);
            color: var(--muted);
            background: #fff;
            cursor: pointer;
        }

            .profile-tab-btn:hover {
                border-color: var(--green);
                color: var(--green);
            }

            .profile-tab-btn.active {
                background: var(--green);
                color: #fff;
                border-color: var(--green);
                font-weight: 600;
            }

        /* Card chung */
        .profile-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 18px;
            box-shadow: 0 2px 12px rgba(15,23,42,.06);
        }

            .profile-card h5 {
                color: var(--text);
                font-size: .95rem;
                font-weight: 700;
                margin-bottom: 18px;
                padding-bottom: 12px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 8px;
            }

        /* Form fields */
        .form-label {
            color: var(--text-muted);
            font-size: .8rem;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .form-control-dark {
            background: #f8fafc;
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 10px 14px;
            width: 100%;
            font-size: .9rem;
            transition: border-color .2s;
        }

            .form-control-dark:focus {
                outline: none;
                border-color: var(--green);
                background: #fff;
            }

            .form-control-dark::placeholder {
                color: var(--muted2);
            }

            .form-control-dark:disabled {
                background: #f0f4f8;
                color: var(--muted);
            }

        .btn-green {
            background: var(--green);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 22px;
            font-weight: 600;
            font-size: .9rem;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-green:hover {
                background: var(--green-hover);
            }

        .btn-outline-green {
            background: transparent;
            color: var(--green);
            border: 1px solid var(--green);
            border-radius: 10px;
            padding: 7px 16px;
            font-size: .84rem;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-outline-green:hover {
                background: var(--green);
                color: #fff;
            }

        /* Booking item */
        .booking-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: #f8fafc;
            margin-bottom: 10px;
            transition: border-color .2s;
        }

            .booking-item:hover {
                border-color: var(--green);
            }

        .booking-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: rgba(14,168,106,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .booking-info .san-name {
            color: var(--text);
            font-weight: 600;
            font-size: .92rem;
        }

        .booking-info .booking-meta {
            color: var(--muted);
            font-size: .78rem;
            margin-top: 2px;
        }

        /* Venue fav card */
        .venue-fav-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: #f8fafc;
            margin-bottom: 10px;
            transition: border-color .2s;
        }

            .venue-fav-card:hover {
                border-color: var(--green);
            }

        .venue-fav-img {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            object-fit: cover;
            background: #e8f5ee;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .venue-fav-info .vname {
            color: var(--text);
            font-weight: 600;
            font-size: .88rem;
        }

        .venue-fav-info .vmeta {
            color: var(--muted);
            font-size: .76rem;
            margin-top: 2px;
        }

        /* Điểm & Voucher */
        .diem-summary {
            display: flex;
            gap: 14px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .diem-box {
            flex: 1;
            min-width: 130px;
            padding: 16px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid var(--border);
            background: #f8fafc;
        }

            .diem-box .diem-val {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--green);
            }

            .diem-box .diem-label {
                color: var(--muted);
                font-size: .78rem;
                margin-top: 2px;
            }

        .voucher-card {
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 10px;
            border: 1px dashed rgba(14,168,106,.4);
            background: rgba(14,168,106,.04);
        }

            .voucher-card .v-name {
                color: var(--text);
                font-weight: 600;
                font-size: .88rem;
            }

            .voucher-card .v-meta {
                color: var(--muted);
                font-size: .76rem;
                margin-top: 3px;
            }

            .voucher-card .v-code {
                font-family: monospace;
                font-size: .82rem;
                background: rgba(14,168,106,.1);
                color: var(--green);
                padding: 3px 10px;
                border-radius: 6px;
                display: inline-block;
                margin-top: 5px;
            }

        .log-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            border-bottom: 1px solid var(--border);
            font-size: .84rem;
        }

            .log-item .log-desc {
                color: var(--text);
            }

            .log-item .log-time {
                color: var(--muted);
                font-size: .74rem;
            }

            .log-item .log-diem {
                font-weight: 700;
            }

                .log-item .log-diem.plus {
                    color: var(--green);
                }

                .log-item .log-diem.minus {
                    color: var(--danger);
                }

        /* OTP badge */
        .otp-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .76rem;
            font-weight: 600;
        }

            .otp-badge.verified {
                background: rgba(14,168,106,.1);
                color: var(--green);
            }

            .otp-badge.unverified {
                background: rgba(245,158,11,.1);
                color: #f59e0b;
            }

        /* Review */
        .star-display {
            color: #f59e0b;
        }

        .review-card {
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 10px;
            border: 1px solid var(--border);
            background: #f8fafc;
        }

            .review-card .r-san {
                color: var(--text);
                font-weight: 600;
                font-size: .88rem;
            }

            .review-card .r-meta {
                color: var(--muted);
                font-size: .76rem;
            }

            .review-card .r-text {
                color: var(--text-muted);
                font-size: .84rem;
                margin-top: 5px;
                font-style: italic;
            }

        /* Star picker */
        .star-picker {
            display: flex;
            gap: 6px;
            cursor: pointer;
        }

            .star-picker .star {
                font-size: 1.8rem;
                color: #ddd;
                transition: color .15s;
                user-select: none;
            }

                .star-picker .star.active {
                    color: #f59e0b;
                }

                .star-picker .star:hover {
                    color: #fcd34d;
                }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--muted);
        }

            .empty-state i {
                font-size: 2.5rem;
                margin-bottom: 10px;
                display: block;
                opacity: .4;
            }
    </style>
}

<div class="profile-wrapper">

    <!-- ── Avatar Card ─────────────────────────────────────── -->
    <div class="profile-avatar-card">
        <div class="avatar-circle">@Model.HoTen[0].ToString().ToUpper()</div>
        <div class="avatar-info">
            <h4>@Model.HoTen</h4>
            <span class="badge-role">@Model.VaiTro</span>
            <span class="diem-badge">⭐ @Model.DiemHienTai điểm</span>
            <div style="color:#888; font-size:.8rem; margin-top:6px;">
                @Model.Email &nbsp;·&nbsp; Tham gia @Model.NgayTao.ToString("MM/yyyy")
            </div>
        </div>
    </div>

    <!-- ── Tab Navigation ─────────────────────────────────── -->
    <div class="profile-tabs">
        <a href="/User/HoSo?tab=thongtin" class="profile-tab-btn @(tab == "thongtin" ? "active" : "")">
            <i class="bi bi-person me-1"></i> Thông tin
        </a>
        <a href="/User/HoSo?tab=yeuthich" class="profile-tab-btn @(tab == "yeuthich" ? "active" : "")">
            <i class="bi bi-heart me-1"></i> Sân yêu thích
            @if (Model.SanYeuThiches.Any())
            {
                <span class="ms-1 badge bg-success" style="font-size:.7rem;">@Model.SanYeuThiches.Count</span>
            }
        </a>
        <a href="/User/HoSo?tab=lichsu" class="profile-tab-btn @(tab == "lichsu" ? "active" : "")">
            <i class="bi bi-clock-history me-1"></i> Lịch sử
            @if (lichSu.Any())
            {
                <span class="ms-1 badge bg-secondary" style="font-size:.7rem;">@lichSu.Count</span>
            }
        </a>
        <a href="/User/HoSo?tab=danhgia" class="profile-tab-btn @(tab == "danhgia" ? "active" : "")">
            <i class="bi bi-star me-1"></i> Đánh giá
        </a>
        <a href="/User/HoSo?tab=diem" class="profile-tab-btn @(tab == "diem" ? "active" : "")">
            <i class="bi bi-gift me-1"></i> Điểm thưởng
        </a>
        <a href="/User/HoSo?tab=baomat" class="profile-tab-btn @(tab == "baomat" ? "active" : "")">
            <i class="bi bi-shield-lock me-1"></i> Bảo mật
        </a>
    </div>

    <!-- ══════════════════════════════════════════════════════
         TAB 1: THÔNG TIN CÁ NHÂN
    ══════════════════════════════════════════════════════ -->
    @if (tab == "thongtin")
    {
        <div class="profile-card">
            <h5><i class="bi bi-person-fill me-2" style="color:var(--green)"></i>Thông tin cá nhân</h5>
            <form method="post" action="/User/CapNhatThongTin">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ và tên</label>
                        <input name="hoTen" class="form-control-dark" value="@Model.HoTen" placeholder="Nhập họ tên" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email <span style="color:#555">(không thể thay đổi)</span></label>
                        <input class="form-control-dark" value="@Model.Email" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Số điện thoại
                            @if (Model.DaXacThucSdt)
                            {
                                <span class="otp-badge verified ms-2">
                                    <i class="bi bi-check-circle-fill"></i> Đã xác thực
                                </span>
                            }
                            else
                            {
                                <span class="otp-badge unverified ms-2">
                                    <i class="bi bi-exclamation-circle"></i> Chưa xác thực
                                </span>
                            }
                        </label>
                        <input name="soDienThoai" class="form-control-dark"
                               value="@Model.SoDienThoai" placeholder="0912 345 678" />
                        @if (!Model.DaXacThucSdt)
                        {
                            <small style="color:#ffc107; font-size:.75rem;">
                                ⚠ Cần xác thực OTP qua <strong>Email</strong> trước khi đặt sân lần đầu.
                                Mã sẽ gửi đến <strong style="color:#fff;">@Model.Email</strong>
                            </small>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Vai trò</label>
                        <input class="form-control-dark" value="@Model.VaiTro" disabled />
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn-green">
                            <i class="bi bi-check2 me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════
         TAB 2: SÂN YÊU THÍCH
    ══════════════════════════════════════════════════════ -->
    @if (tab == "yeuthich")
    {
        <div class="profile-card">
            <h5><i class="bi bi-heart-fill me-2" style="color:#e74c3c"></i>Sân yêu thích (@Model.SanYeuThiches.Count)</h5>

            @if (!Model.SanYeuThiches.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-heart"></i>
                    <div>Bạn chưa lưu sân nào.</div>
                    <a href="/Venues" class="btn-outline-green mt-3">Khám phá sân ngay</a>
                </div>
            }
            else
            {
                foreach (var yeuThich in Model.SanYeuThiches.OrderByDescending(y => y.NgayThem))
                {
                    var san = yeuThich.SanBong;
                    if (san == null) continue;
                    <div class="venue-fav-card">
                        @if (!string.IsNullOrEmpty(san.HinhAnh))
                        {
                            <img src="@san.HinhAnh" class="venue-fav-img" alt="@san.TenSan" />
                        }
                        else
                        {
                            <div class="venue-fav-img d-flex align-items-center justify-content-center" style="font-size:1.5rem;">⚽</div>
                        }
                        <div class="venue-fav-info flex-grow-1">
                            <div class="vname">@san.TenSan</div>
                            <div class="vmeta">
                                <i class="bi bi-geo-alt"></i> @san.Quan &nbsp;·&nbsp;
                                Sân @san.LoaiSan người &nbsp;·&nbsp;
                                ⭐ @san.DanhGiaTrungBinh.ToString("0.0")
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/Venues/Details/@san.Id" class="btn-outline-green">Xem</a>
                            <button onclick="boYeuThich(@san.Id, this)" class="btn-outline-green" style="border-color:#e74c3c; color:#e74c3c;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════════════
         TAB 3: LỊCH SỬ ĐẶT SÂN
    ══════════════════════════════════════════════════════ -->
    @if (tab == "lichsu")
    {
        <div class="profile-card">
            <h5><i class="bi bi-clock-history me-2" style="color:var(--green)"></i>Lịch sử đặt sân (@lichSu.Count đơn)</h5>

            @if (!lichSu.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <div>Bạn chưa có đơn đặt sân nào.</div>
                    <a href="/Venues" class="btn-outline-green mt-3">Đặt sân ngay</a>
                </div>
            }
            else
            {
                foreach (var don in lichSu)
                {
                    var tenSan = don.KhungGio?.SanBong?.TenSan ?? "Không rõ";
                    var quan = don.KhungGio?.SanBong?.Quan ?? "";
                    var gio = don.KhungGio != null
                    ? $"{don.KhungGio.GioBatDau:hh\\:mm} – {don.KhungGio.GioKetThuc:hh\\:mm}"
                    : "";
                    <div class="booking-item">
                        <div class="booking-icon">⚽</div>
                        <div class="booking-info">
                            <div class="san-name">@tenSan</div>
                            <div class="booking-meta">
                                <i class="bi bi-calendar3"></i> @don.NgayThiDau.ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrEmpty(gio))
                                {
                                    <span>&nbsp;·&nbsp;<i class="bi bi-clock"></i> @gio</span>
                                }
                                @if (!string.IsNullOrEmpty(quan))
                                {
                                    <span>&nbsp;·&nbsp;<i class="bi bi-geo-alt"></i> @quan</span>
                                }
                            </div>
                            <div style="margin-top:4px; font-size:.78rem; color:#666;">
                                Mã: <span style="color:var(--green); font-family:monospace;">@don.MaXacNhan</span>
                                &nbsp;·&nbsp; Cọc: @don.TienCoc.ToString("N0")đ
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="@TrangThaiClass(don.TrangThai)" style="font-size:.75rem;">
                                @TrangThaiText(don.TrangThai)
                            </span>
                            @if (don.TrangThai == "HoanThanh" || don.TrangThai == "DaXacNhan")
                            {
                                <div class="mt-2 d-flex flex-wrap gap-1 justify-content-end">
                                    <a href="/Booking/Details/@don.Id" class="btn-outline-green" style="font-size:.72rem; padding:4px 10px;">Chi tiết</a>
                                    @if (don.TrangThai == "DaXacNhan")
                                    {
                                        <a href="/User/TaoYeuCauDoiGio?datSanId=@don.Id" class="btn btn-sm btn-outline-primary" style="font-size:.72rem; padding:4px 10px;">🕐 Đổi giờ</a>
                                        <a href="/User/TaoYeuCauDoiSan?datSanId=@don.Id" class="btn btn-sm btn-outline-info" style="font-size:.72rem; padding:4px 10px;">🔁 Đổi sân</a>
                                        <a href="/User/TaoChuyenNhuong?datSanId=@don.Id" class="btn btn-sm btn-outline-warning" style="font-size:.72rem; padding:4px 10px;">👥 Chuyển nhượng</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════════════
         TAB 4: ĐÁNH GIÁ
    ══════════════════════════════════════════════════════ -->
    @if (tab == "danhgia")
    {
        <div class="profile-card">
            <h5><i class="bi bi-star-fill me-2" style="color:#ffc107"></i>Đánh giá đã viết (@Model.DanhGia.Count)</h5>

            @if (!Model.DanhGia.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-star"></i>
                    <div>Bạn chưa có đánh giá nào.</div>
                    <small style="color:#555;">Sau khi hoàn thành trận đấu, bạn có thể đánh giá sân để nhận điểm thưởng.</small>
                </div>
            }
            else
            {
                foreach (var dg in Model.DanhGia.OrderByDescending(d => d.NgayDanhGia))
                {
                    <div class="review-card">
                        <div class="r-san">@(dg.SanBong?.TenSan ?? "Sân không xác định")</div>
                        <div class="r-meta">@dg.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="mt-2 d-flex gap-3" style="font-size:.82rem;">
                            <span>🌿 Cỏ: <span class="star-display">@string.Concat(Enumerable.Repeat("★", dg.SoSao))@string.Concat(Enumerable.Repeat("☆", 5 - dg.SoSao))</span></span>
                            @if (dg.SoSaoCoSoVatChat.HasValue)
                            {
                                <span>🏟 CSVC: <span class="star-display">@string.Concat(Enumerable.Repeat("★", dg.SoSaoCoSoVatChat.Value))@string.Concat(Enumerable.Repeat("☆", 5 - dg.SoSaoCoSoVatChat.Value))</span></span>
                            }
                            @if (dg.SoSaoNhanVien.HasValue)
                            {
                                <span>👤 NV: <span class="star-display">@string.Concat(Enumerable.Repeat("★", dg.SoSaoNhanVien.Value))@string.Concat(Enumerable.Repeat("☆", 5 - dg.SoSaoNhanVien.Value))</span></span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(dg.NhanXet))
                        {
                            <div class="r-text">"@dg.NhanXet"</div>
                        }
                    </div>
                }
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════════════
         TAB 5: ĐIỂM THƯỞNG & VOUCHER
    ══════════════════════════════════════════════════════ -->
    @if (tab == "diem")
    {
        <!-- Tổng điểm -->
        <div class="diem-summary">
            <div class="diem-box" style="background:rgba(30,215,96,.05); border-color:rgba(30,215,96,.2);">
                <div class="diem-val">@Model.DiemHienTai</div>
                <div class="diem-label">Điểm hiện có</div>
            </div>
            <div class="diem-box" style="background:rgba(255,193,7,.05); border-color:rgba(255,193,7,.2);">
                <div class="diem-val" style="color:#ffc107;">@vouchers.Count</div>
                <div class="diem-label">Voucher chưa dùng</div>
            </div>
            <div class="diem-box" style="background:rgba(255,255,255,.03);">
                <div class="diem-val" style="color:#aaa;">@diemLogs.Where(d => d.SoDiem > 0).Sum(d => d.SoDiem)</div>
                <div class="diem-label">Tổng điểm tích lũy</div>
            </div>
        </div>

        <!-- Đổi điểm lấy voucher -->
        @if (vouchersCoTheDoi.Any())
        {
            <div class="profile-card">
                <h5><i class="bi bi-arrow-left-right me-2" style="color:var(--green)"></i>Đổi điểm lấy voucher</h5>
                <div class="row g-3">
                    @foreach (var v in vouchersCoTheDoi)
                    {
                        <div class="col-md-6">
                            <div class="voucher-card" style="border-style:solid; border-color:rgba(30,215,96,.4);">
                                <div class="v-name">@v.TenVoucher</div>
                                <div class="v-meta">
                                    @(v.LoaiGiam == "PhanTram" ? $"Giảm {v.GiaTriGiam:0}%" : $"Giảm {v.GiaTriGiam:N0}đ")
                                    @if (v.GiamToiDa.HasValue)
                                    {
                                        <span> (tối đa @v.GiamToiDa.Value.ToString("N0")đ)</span>
                                    }
                                    &nbsp;·&nbsp; Hiệu lực @v.SoNgayHieuLuc ngày
                                </div>
                                <div style="margin-top:10px; display:flex; align-items:center; justify-content:space-between;">
                                    <span style="color:#ffc107; font-weight:700;">⭐ @v.DiemCanDoi điểm</span>
                                    <form method="post" action="/User/DoiDiem" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="voucherId" value="@v.Id" />
                                        <button type="submit" class="btn-green" style="padding:6px 16px; font-size:.82rem;">
                                            Đổi ngay
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Voucher đang có -->
        <div class="profile-card">
            <h5><i class="bi bi-ticket-perforated me-2" style="color:#ffc107"></i>Voucher của bạn (@vouchers.Count)</h5>
            @if (!vouchers.Any())
            {
                <div class="empty-state" style="padding:24px;">
                    <i class="bi bi-ticket" style="font-size:2rem;"></i>
                    <div style="margin-top:8px;">Chưa có voucher nào. Đổi điểm để nhận ngay!</div>
                </div>
            }
            else
            {
                foreach (var uv in vouchers)
                {
                    var soNgay = (uv.NgayHetHan - DateTime.Now).Days;
                    <div class="voucher-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="v-name">@uv.Voucher?.TenVoucher</div>
                                <div class="v-meta">
                                    @(uv.Voucher?.LoaiGiam == "PhanTram"
                                                            ? $"Giảm {uv.Voucher.GiaTriGiam:0}%"
                                                            : $"Giảm {uv.Voucher?.GiaTriGiam:N0}đ")
                        &nbsp;·&nbsp; Hết hạn @uv.NgayHetHan.ToString("dd/MM/yyyy")
                        @if (soNgay <= 3)
                                    {
                                        <span class="ms-1" style="color:#e74c3c; font-weight:600;">⚠ Còn @soNgay ngày!</span>
                                    }
                                </div>
                                <div class="v-code">@uv.MaSuDung</div>
                            </div>
                            <span class="badge bg-success" style="font-size:.72rem;">Còn dùng được</span>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Lịch sử giao dịch điểm -->
        <div class="profile-card">
            <h5><i class="bi bi-list-ul me-2" style="color:#aaa"></i>Lịch sử giao dịch điểm</h5>
            @if (!diemLogs.Any())
            {
                <div style="color:#555; text-align:center; padding:20px;">Chưa có giao dịch nào.</div>
            }
            else
            {
                foreach (var log in diemLogs)
                {
                    <div class="log-item">
                        <div>
                            <div class="log-desc">@log.GhiChu</div>
                            <div class="log-time">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="text-end">
                            <div class="log-diem @(log.SoDiem > 0 ? "plus" : "minus")">
                                @(log.SoDiem > 0 ? "+" : "")@log.SoDiem ⭐
                            </div>
                            <div style="color:#555; font-size:.75rem;">Số dư: @log.SoDuSauGd</div>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════════════
         TAB 6: BẢO MẬT
    ══════════════════════════════════════════════════════ -->
    @if (tab == "baomat")
    {
        <div class="profile-card">
            <h5><i class="bi bi-lock-fill me-2" style="color:var(--green)"></i>Đổi mật khẩu</h5>
            <form method="post" action="/User/DoiMatKhau">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu hiện tại</label>
                        <input type="password" name="matKhauCu" class="form-control-dark" placeholder="••••••••" required />
                    </div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="matKhauMoi" class="form-control-dark" placeholder="Tối thiểu 6 ký tự" required minlength="6" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <input type="password" name="xacNhanMatKhau" class="form-control-dark" placeholder="Nhập lại mật khẩu mới" required />
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn-green">
                            <i class="bi bi-shield-check me-1"></i> Đổi mật khẩu
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="profile-card">
            <h5><i class="bi bi-door-open me-2" style="color:#e74c3c"></i>Phiên đăng nhập</h5>
            <div style="color:#aaa; font-size:.9rem; margin-bottom:16px;">
                Đăng xuất khỏi tất cả thiết bị sẽ xóa toàn bộ phiên đăng nhập hiện tại.
            </div>
            <a href="/Auth/Logout" class="btn-outline-green" style="border-color:#e74c3c; color:#e74c3c;">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất thiết bị này
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Bỏ yêu thích từ tab Sân yêu thích
        async function boYeuThich(sanId, btn) {
            if (!confirm('Bỏ sân này khỏi danh sách yêu thích?')) return;
            const res = await fetch('/User/ToggleYeuThich', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `sanBongId=${sanId}&__RequestVerificationToken=${getAntiForgery()}`
            });
            const data = await res.json();
            if (!data.liked) {
                // Xóa card khỏi DOM
                btn.closest('.venue-fav-card').remove();
                if (window.reloadHeartDD) window.reloadHeartDD();
            }
        }

        // Toggle tim từ trang Venues (dùng chung)
        async function toggleYeuThich(sanId, heartBtn) {
            const res = await fetch('/User/ToggleYeuThich', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `sanBongId=${sanId}&__RequestVerificationToken=${getAntiForgery()}`
            });
            const data = await res.json();
            if (heartBtn) {
                heartBtn.innerHTML = data.liked ? '❤️' : '🤍';
                heartBtn.title = data.liked ? 'Bỏ yêu thích' : 'Thêm vào yêu thích';
            }
        }

        function getAntiForgery() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || document.cookie.split(';').find(c => c.includes('CSRF'))?.split('=')[1] || '';
        }
    </script>
}
