@{
    ViewData["Title"] = "Yêu cầu đổi giờ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var don = (Web_Stadium.EFCore.DatSan)ViewBag.Don;
    var khungTrong = (List<Web_Stadium.EFCore.KhungGio>)ViewBag.KhungTrong;
}

<div class="container py-4">
    <h3>🕐 Yêu cầu đổi giờ</h3>

    @if (TempData["Error"] != null)
    { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card mb-3">
        <div class="card-body">
            <strong>Đơn:</strong> @don.MaXacNhan<br />
            <strong>Sân:</strong> @don.KhungGio.SanBong.TenSan<br />
            <strong>Khung giờ hiện tại:</strong> @don.KhungGio.GioBatDau – @don.KhungGio.GioKetThuc, ngày @don.NgayThiDau.ToString("dd/MM/yyyy")
        </div>
    </div>

    <form asp-action="TaoYeuCauDoiGio" method="post" class="card">
        <div class="card-body">
            <input type="hidden" name="datSanId" value="@don.Id" />

            <div class="mb-3">
                <label class="form-label">Khung giờ mới *</label>
                <select name="khungGioMoiId" class="form-select" required>
                    <option value="">-- Chọn khung giờ trống --</option>
                    @foreach (var k in khungTrong)
                    {
                        <option value="@k.Id">@k.GioBatDau – @k.GioKetThuc (@k.Gia.ToString("N0")đ)</option>
                    }
                </select>
                @if (khungTrong.Count == 0)
                { <small class="text-danger">Sân này hiện không còn khung trống nào.</small> }
            </div>

            <div class="mb-3">
                <label class="form-label">Ngày thi đấu mới *</label>
                <input type="date" name="ngayThiDauMoi" class="form-control" required
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       value="@don.NgayThiDau.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label class="form-label">Lý do *</label>
                <textarea name="lyDo" class="form-control" rows="3" maxlength="500" required></textarea>
            </div>

            <button type="submit" class="btn btn-success">Gửi yêu cầu</button>
            <a href="/User/HoSo?tab=lichsu" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div>
