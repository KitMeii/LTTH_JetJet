@model Web_Stadium.EFCore.GiaiDau
@{
    ViewData["Title"] = "Đăng ký — " + Model.TenGiai;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var slotConLai = (int)(ViewBag.SlotConLai ?? 0);
    var soDoiDK = Model.DoiBongs?.Count(d => d.DaThanhToan) ?? 0;
    var pct = Model.SoDoiToiDa > 0
                     ? (int)((double)soDoiDK / Model.SoDoiToiDa * 100) : 0;
}

@section Styles {
    <style>
        .dk-wrap {
            max-width: 620px;
            margin: 0 auto;
            padding: 0 16px 60px;
        }

        .dk-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .dk-header {
            background: linear-gradient(135deg,#0a2a1a,#0EA86A);
            padding: 28px 28px 22px;
        }

        .dk-body {
            padding: 28px;
        }

        .dk-lbl {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .dk-inp {
            width: 100%;
            background: var(--bg3);
            border: 1.5px solid var(--border);
            color: var(--text);
            border-radius: var(--r);
            padding: 12px 16px;
            font-size: 15px;
            font-family: var(--ff-b);
            transition: border-color .2s, box-shadow .2s;
        }

            .dk-inp:focus {
                outline: none;
                border-color: var(--green);
                box-shadow: 0 0 0 3px rgba(14,168,106,.1);
            }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-lbl {
            color: var(--muted);
        }

        .info-val {
            font-weight: 700;
            color: var(--text);
        }

        .prog-bar {
            height: 6px;
            background: var(--bg3);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 6px;
        }

        .prog-fill {
            height: 100%;
            background: var(--green);
            border-radius: 4px;
            transition: width .5s ease;
        }

        .warning-box {
            background: rgba(245,158,11,.08);
            border: 1px solid rgba(245,158,11,.25);
            border-radius: var(--r);
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: var(--muted);
            line-height: 1.7;
        }
    </style>
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Đăng ký tham dự</div>
        <h1 style="font-style:italic;line-height:.9;margin:0">
            @Model.TenGiai.ToUpper()
        </h1>
        <p style="color:var(--muted);margin-top:8px">
            🏟️ @Model.SanBong?.TenSan &nbsp;·&nbsp;
            📅 @Model.NgayBatDau.ToString("dd/MM") – @Model.NgayKetThuc.ToString("dd/MM/yyyy")
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="dk-wrap">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4">
                ❌ @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Slot còn lại -->
        @if (slotConLai <= 3)
        {
            <div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);
                            border-radius:var(--r);padding:12px 16px;margin-bottom:20px;
                            font-size:13px;font-weight:600;color:var(--danger)">
                ⚡ Chỉ còn @slotConLai slot! Đăng ký ngay để không bỏ lỡ.
            </div>
        }

        <div class="dk-card">
            <!-- Header info giải -->
            <div class="dk-header">
                <div style="color:rgba(255,255,255,.7);font-size:11px;
                            letter-spacing:2px;text-transform:uppercase;margin-bottom:12px">
                    THÔNG TIN GIẢI ĐẤU
                </div>
                <!-- Progress slot -->
                <div style="display:flex;justify-content:space-between;
                            font-size:13px;color:rgba(255,255,255,.8);margin-bottom:5px">
                    <span>Đội đã đăng ký</span>
                    <span style="font-weight:700;color:#fff">
                        @soDoiDK / @Model.SoDoiToiDa đội
                    </span>
                </div>
                <div class="prog-bar" style="background:rgba(255,255,255,.2)">
                    <div class="prog-fill" style="width:@pct%"></div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;
                            gap:8px;margin-top:16px">
                    @foreach (var (ico, val, lbl) in new[]{
                                        ("💰", Model.LePhiGiai.ToString("N0") + "đ", "Lệ phí"),
                                        ("🔒", Model.TienKyQuy.ToString("N0") + "đ", "Ký quỹ hành vi"),
                                        })
                    {
                        <div style="background:rgba(255,255,255,.12);border-radius:var(--r);
                                        padding:12px;text-align:center;">
                            <div style="font-size:1.1rem;margin-bottom:4px">@ico</div>
                            <div style="font-weight:800;color:#fff;font-size:.95rem">@val</div>
                            <div style="color:rgba(255,255,255,.65);font-size:11px">@lbl</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Form đăng ký -->
            <div class="dk-body">
                <!-- Cảnh báo ký quỹ -->
                <div class="warning-box">
                    <strong style="color:var(--text)">⚠️ Lưu ý về tiền ký quỹ:</strong><br>
                    Số tiền <strong>@Model.TienKyQuy.ToString("N0")đ</strong> sẽ được hoàn trả
                    sau khi giải kết thúc, <em>trừ đi tiền phạt thẻ</em> (nếu có).<br>
                    Thẻ vàng: <strong>@Model.TienPhatTheVang.ToString("N0")đ</strong> &nbsp;·&nbsp;
                    Thẻ đỏ: <strong>@Model.TienPhatTheDo.ToString("N0")đ</strong>
                </div>

                <form method="post" action="/TournamentPublic/XacNhanDangKy" id="formDK">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="giaiDauId" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="dk-lbl">Tên đội bóng *</label>
                        <input name="tenDoi" class="dk-inp" required maxlength="100"
                               placeholder="VD: FC Cầu Giấy Xanh"
                               oninput="previewTen(this.value)" />
                        <div style="font-size:12px;color:var(--muted2);margin-top:5px">
                            Tên sẽ hiển thị trên bảng xếp hạng và lịch thi đấu
                        </div>
                    </div>

                    <!-- Preview tên đội -->
                    <div id="tenPreview" style="display:none;background:rgba(14,168,106,.06);
                         border:1px solid rgba(14,168,106,.2);border-radius:var(--r);
                         padding:12px 16px;margin-bottom:20px">
                        <div style="font-size:11px;color:var(--muted);margin-bottom:6px">
                            Preview bảng xếp hạng
                        </div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <div style="width:36px;height:36px;border-radius:50%;
                                        background:var(--green);color:#fff;
                                        font-family:var(--ff-h);font-size:16px;
                                        display:flex;align-items:center;justify-content:center"
                                 id="tenAva">
                                ?
                            </div>
                            <div style="font-weight:700;color:var(--text)" id="tenLabel">—</div>
                        </div>
                    </div>

                    <!-- Tổng thanh toán -->
                    <div style="background:var(--bg3);border:1px solid var(--border);
                                border-radius:var(--r);padding:16px 18px;margin-bottom:22px">
                        <div class="info-row">
                            <span class="info-lbl">Lệ phí đăng ký</span>
                            <span class="info-val">@Model.LePhiGiai.ToString("N0")đ</span>
                        </div>
                        <div class="info-row">
                            <span class="info-lbl">Tiền ký quỹ (hoàn lại)</span>
                            <span class="info-val">@Model.TienKyQuy.ToString("N0")đ</span>
                        </div>
                        <div class="info-row" style="margin-top:4px;padding-top:12px;
                             border-top:1px solid var(--border)!important;">
                            <span style="font-weight:700;font-size:15px;color:var(--text)">
                                Tổng thanh toán
                            </span>
                            <span style="font-family:var(--ff-h);font-size:1.3rem;color:var(--green)">
                                @((Model.LePhiGiai + Model.TienKyQuy).ToString("N0"))đ
                            </span>
                        </div>
                    </div>

                    <div style="font-size:12px;color:var(--muted2);margin-bottom:16px">
                        ⏱ Sau khi bấm đăng ký, bạn có <strong style="color:var(--danger)">15 phút</strong>
                        để hoàn tất thanh toán. Quá thời gian, slot sẽ bị giải phóng.
                    </div>

                    <button type="submit" class="btn-primary-glow w-100" id="submitBtn"
                            style="font-size:16px;padding:15px;border-radius:var(--r)">
                        🏆 Đăng ký tham dự
                    </button>
                </form>

                <div style="text-align:center;margin-top:14px">
                    <a href="/TournamentPublic/Details/@Model.Id"
                       style="font-size:13px;color:var(--muted);text-decoration:none">
                        ← Quay lại trang giải đấu
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewTen(val) {
            var box = document.getElementById('tenPreview');
            var ava = document.getElementById('tenAva');
            var lbl = document.getElementById('tenLabel');
            if (val.trim()) {
                box.style.display = 'block';
                ava.textContent   = val.trim()[0].toUpperCase();
                lbl.textContent   = val.trim();
            } else {
                box.style.display = 'none';
            }
        }

        document.getElementById('formDK').addEventListener('submit', function() {
            var btn = document.getElementById('submitBtn');
            btn.disabled    = true;
            btn.textContent = '⏳ Đang xử lý...';
        });
    </script>
}
