<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ⚽ PitchHub.vn</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/support.css" />

    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* ── HEART DROPDOWN ─────────────────────────── */
        .heart-btn-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .heart-nav-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
            padding: 5px 9px;
            border-radius: 999px;
            transition: all .2s;
            position: relative;
            display: flex;
            align-items: center;
            line-height: 1;
        }

            .heart-nav-btn:hover {
                background: rgba(255,255,255,.15);
            }

        .heart-count-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--green);
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .heart-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 300px;
            min-width: 280px;
            background: #fff;
            border: 1px solid rgba(14,168,106,.2);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(15,23,42,.15);
            z-index: 9999;
            overflow: hidden;
        }

            .heart-dropdown.open {
                display: block;
            }

        .heart-dd-header {
            padding: 12px 16px 10px;
            border-bottom: 1px solid rgba(15,23,42,.07);
            font-size: .78rem;
            font-weight: 700;
            color: var(--text);
            letter-spacing: .5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .heart-dd-header span {
                color: var(--green);
                font-size: .9rem;
            }

        .heart-dd-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .heart-dd-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            text-decoration: none;
            transition: background .15s;
            border-bottom: 1px solid rgba(15,23,42,.05);
        }

            .heart-dd-item:last-child {
                border-bottom: none;
            }

            .heart-dd-item:hover {
                background: rgba(14,168,106,.06);
            }

        .heart-dd-img {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            object-fit: cover;
            background: #f0f4f8;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border: 1px solid rgba(15,23,42,.08);
        }

            .heart-dd-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 10px;
            }

        .heart-dd-info .hd-name {
            color: var(--text);
            font-weight: 600;
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 180px;
        }

        .heart-dd-info .hd-meta {
            color: var(--muted);
            font-size: .74rem;
            margin-top: 2px;
        }

        .heart-dd-info .hd-rating {
            color: #f59e0b;
            font-size: .75rem;
        }

        .heart-dd-empty {
            padding: 24px 16px;
            text-align: center;
            color: var(--muted);
            font-size: .85rem;
        }

            .heart-dd-empty i {
                font-size: 1.8rem;
                display: block;
                margin-bottom: 8px;
                opacity: .4;
            }

        .heart-dd-footer {
            padding: 10px 16px;
            border-top: 1px solid rgba(15,23,42,.07);
            text-align: center;
        }

            .heart-dd-footer a {
                color: var(--green);
                font-size: .8rem;
                font-weight: 600;
                text-decoration: none;
            }

                .heart-dd-footer a:hover {
                    text-decoration: underline;
                }
    </style>

</head>
<body>

    <nav class="navbar-custom">
        <div class="container nav-wrapper">
            <div class="nav-left">
                <div class="brand-wrapper">
                    <a class="nav-logo" href="/">
                        PITCH<span>HUB</span>
                        <i class="bi bi-dribbble" style="font-size:22px; color:white;"></i>
                    </a>
                </div>
            </div>

            <div class="nav-center">
                <ul class="nav-links">
                    <li><a href="/">Trang Chủ</a></li>
                    <li><a href="/Venues">Tìm Sân</a></li>
                    <li><a href="/Matchmaking">Tìm Đối Thủ</a></li>
                    @using Web_Stadium.Controllers
                    @using System.Security.Claims
                    @inject IConfiguration Config
                    @{
                        var token = Context.Request.Cookies["jwt"];
                        string? role = null;
                        string? userName = null;

                        if (!string.IsNullOrEmpty(token))
                        {
                            var principal = TokenHelper.DocToken(token, Config);
                            if (principal != null)
                            {
                                role = principal.FindFirst(ClaimTypes.Role)?.Value;
                                userName = principal.FindFirst(ClaimTypes.Name)?.Value;
                            }
                        }
                    }
                    @if (!string.IsNullOrEmpty(role))
                    {
                        <li><a href="/Booking/MyBookings">Lịch Đặt</a></li>

                        @if (role == "Admin")
                        {
                            <li><a href="/Admin">Quản trị</a></li>
                            <li><a href="/Admin/HoSo">Hồ Sơ</a></li>
                        }
                        else if (role == "Owner")
                        {
                            <li><a href="/Owner">Chủ sân</a></li>                       
                            <li><a href="/Owner/HoSo">Hồ Sơ</a></li>
                        }
                        else if (role == "Staff")
                        {
                            <li><a href="/TournamentStaff/DanhSach">Giải Đấu</a></li>
                            <li><a href="/Staff">Nhân viên</a></li>                          
                            <li><a href="/Staff/HoSo">Hồ Sơ</a></li>
                        }
                        else
                        {
                            @* User thường *@
                            <li><a href="/TournamentPublic">Giải Đấu</a></li>
                            <li><a href="/User/HoSo">Hồ Sơ</a></li>
                        }
                    }
                </ul>
            </div>

            <div class="nav-right">
                @if (!string.IsNullOrEmpty(role))
                {
                    @if (role == "User")
                    {
                        <a href="/Venues" class="heart-nav-btn" title="Tìm sân" style="text-decoration:none;">
                            <svg width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="white" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                        </a>

                        <a href="/Booking/MyBookings" class="heart-nav-btn" title="Lịch đặt" style="text-decoration:none;">
                            <svg width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="white" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1" />
                                <circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                            </svg>
                        </a>

                        <div class="heart-btn-wrap" id="heartWrap">
                            <button class="heart-nav-btn" id="heartNavBtn"
                                    onclick="toggleHeartDD(event)"
                                    title="Sân yêu thích">
                                <svg width="22" height="22" viewBox="0 0 24 24"
                                     fill="none" stroke="white" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                </svg>
                                <span class="heart-count-badge" id="heartCount" style="display:none;">0</span>
                            </button>
                            <div class="heart-dropdown" id="heartDropdown">
                                <div class="heart-dd-header">
                                    Sân yêu thích &nbsp;<span id="heartCountLabel">0</span>
                                </div>
                                <div class="heart-dd-list" id="heartDDList">
                                    <div class="heart-dd-empty">Đang tải...</div>
                                </div>
                                <div class="heart-dd-footer">
                                    <a href="/User/HoSo?tab=yeuthich">Xem tất cả→</a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="user-info-box">
                        <div class="badge">
                            @if (role == "Admin")
                            {
                                <span class="text-admin">⚡@userName</span>
                            }
                            else if (role == "Owner")
                            {
                                <span class="text-owner">🏟️@userName</span>
                            }
                            else if (role == "Staff")
                            {
                                <span class="text-staff">👷@userName</span>
                            }
                            else
                            {
                                <span class="text-user">⚽@userName</span>
                            }
                        </div>
                        <a href="/Auth/Logout" class="btn-logout">Đăng xuất</a>
                    </div>
                }
                else
                {
                    <a href="/Venues" class="heart-nav-btn" title="Tìm sân" style="text-decoration:none;">
                        <svg width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="white" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </a>

                    <a href="/Auth/Login" class="heart-nav-btn" title="Lịch đặt" style="text-decoration:none;">
                        <svg width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="white" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1" />
                            <circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>
                    </a>

                    <a href="/Auth/Login" class="heart-nav-btn" title="Yêu thích" style="text-decoration:none;">
                        <svg width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="white" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </a>

                    <div class="user-info-box" style="display:flex; align-items:center; gap:6px;">
                        <a href="/Auth/Login" class="heart-nav-btn" title="Đăng nhập" style="text-decoration:none;">
                            <svg width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="white" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </a>
                        <a href="/Auth/Login" class="btn-logout" style="background:var(--green);color:#fff;white-space:nowrap;"></a>
                    </div>
                }
            </div>
        </div>
    </nav>

    @* Toast thông báo Success *@
    @if (TempData["Success"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:70px">
            <div class="toast show align-items-center text-bg-success border-0">
                <div class="d-flex">
                    <div class="toast-body">✅ @TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    @* Toast thông báo Error *@
    @if (TempData["Error"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:70px">
            <div class="toast show align-items-center text-bg-danger border-0">
                <div class="d-flex">
                    <div class="toast-body">❌ @TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }


    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>


    @* Tự động ẩn toast sau 4 giây *@
    <script>
        document.querySelectorAll('.toast').forEach(function(el) {
            setTimeout(function() { el.style.display = 'none'; }, 4000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ════ FOOTER ════ -->
    <footer class="footer-premium">
        <div class="container">

            <div class="row g-5">

                <!-- Brand -->
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <h3 class="mb-3">
                            <span class="text-green">PITCH</span><span style="color:#fff">HUB</span>
                        </h3>

                        <p class="footer-desc">
                            Nền tảng đặt sân bóng hiện đại giúp người chơi
                            kết nối, đặt sân và tìm đối thủ nhanh chóng trên
                            toàn quốc.
                        </p>

                        <div class="footer-socials mt-4">
                            <a href="#"><i class="bi bi-facebook"></i></a>
                            <a href="#"><i class="bi bi-instagram"></i></a>
                            <a href="#"><i class="bi bi-youtube"></i></a>
                            <a href="#"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Liên kết -->
                <div class="col-lg-2 col-md-4">
                    <h5 class="footer-title">Khám phá</h5>

                    <ul class="footer-links">
                        <li><a href="/Venues">Danh sách sân</a></li>
                        <li><a href="/Matchmaking">Tìm đối thủ</a></li>
                        <li><a href="/Booking/MyBookings">Lịch đặt</a></li>
                        <li><a href="/Auth/Register">Đăng ký</a></li>
                    </ul>
                </div>

                <!-- Hỗ trợ -->
                <div class="col-lg-3 col-md-4">
                    <h5 class="footer-title">Hỗ trợ</h5>

                    <ul class="footer-links">
                        <li><a href="/Support">Trung tâm hỗ trợ</a></li>
                        <li><a href="/Support/Terms">Điều khoản</a></li>
                        <li><a href="/Support/Privacy">Chính sách bảo mật</a></li>
                        <li><a href="/Support/Contact">Liên hệ</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-3 col-md-4">
                    <h5 class="footer-title">Liên hệ</h5>

                    <ul class="footer-contact">
                        <li>📍 TP. Hồ Chí Minh, Việt Nam</li>
                        <li>📞 0123 456 789</li>
                        <li>✉ support@pitchhub.vn</li>
                    </ul>
                </div>

            </div>

            <!-- Bottom -->
            <div class="footer-bottom">
                <p>
                    © @DateTime.Now.Year PITCHHUB.
                    All rights reserved.
                </p>
            </div>

        </div>
    </footer>

    <script>
        // ── HEART DROPDOWN ─────────────────────────────────────────
        (function() {
            var loaded = false;

            function toggleHeartDD(e) {
                e.stopPropagation();
                var dd = document.getElementById('heartDropdown');
                var isOpen = dd.classList.contains('open');
                if (isOpen) {
                    dd.classList.remove('open');
                } else {
                    dd.classList.add('open');
                    if (!loaded) loadYeuThich();
                }
            }

            function loadYeuThich() {
                fetch('/User/GetSanYeuThich')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        loaded = true;
                        var list  = document.getElementById('heartDDList');
                        var count = document.getElementById('heartCount');
                        var label = document.getElementById('heartCountLabel');

                        if (!data || data.length === 0) {
                            list.innerHTML = '<div class="heart-dd-empty"><i class="bi bi-heart"></i>Chưa có sân yêu thích nào.<br><a href="/Venues" style="color:var(--green);text-decoration:none;font-size:.8rem;">Khám phá sân ngay →</a></div>';
                            count.style.display = 'none';
                            label.textContent = '0';
                            return;
                        }

                        count.textContent = data.length;
                        count.style.display = 'flex';
                        label.textContent = data.length;

                        list.innerHTML = data.map(function(s) {
                            var img = s.hinhAnh
                                ? '<img src="' + s.hinhAnh + '" class="heart-dd-img" alt="' + s.tenSan + '" />'
                                : '<div class="heart-dd-img">⚽</div>';
                            return '<a href="/Venues/Details/' + s.id + '" class="heart-dd-item">'
                                + img
                                + '<div class="heart-dd-info">'
                                + '<div class="hd-name">' + s.tenSan + '</div>'
                                + '<div class="hd-meta">📍 ' + s.quan + ' &nbsp;·&nbsp; ⭐ ' + s.danhGia + '</div>'
                                + '</div>'
                                + '</a>';
                        }).join('');
                    })
                    .catch(function() {
                        document.getElementById('heartDDList').innerHTML =
                            '<div class="heart-dd-empty">Không thể tải danh sách.</div>';
                    });
            }

            // Đóng khi click ra ngoài
            document.addEventListener('click', function(e) {
                var wrap = document.getElementById('heartWrap');
                if (wrap && !wrap.contains(e.target)) {
                    var dd = document.getElementById('heartDropdown');
                    if (dd) dd.classList.remove('open');
                }
            });

            // Expose ra global để các trang khác gọi reload sau khi toggle tim
            window.reloadHeartDD = function() { loaded = false; };
            window.toggleHeartDD = toggleHeartDD;
        })();
    </script>
</body>
</html>