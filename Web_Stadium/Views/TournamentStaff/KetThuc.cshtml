@model Web_Stadium.EFCore.TranDau
@{
    ViewData["Title"] = "Kết thúc trận";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tysoNha = (int)(ViewBag.TysoNha ?? 0);
    var tysoKhach = (int)(ViewBag.TysoKhach ?? 0);
    var skBanThang = Model.SuKiens?.Where(s => s.LoaiSuKien == "BanThang").ToList() ?? new List<Web_Stadium.EFCore.SuKienTran>();
    var skThe = Model.SuKiens?.Where(s => s.LoaiSuKien is "TheVang" or "TheDo" or "TheVangLan2")
                         .ToList() ?? new List<Web_Stadium.EFCore.SuKienTran>();
}

@section Styles {
    <style>
        .kt-wrap {
            max-width: 680px;
            margin: 0 auto;
            padding: 0 16px 60px;
        }

        .result-box {
            background: linear-gradient(135deg,#0a2a1a,#0f3d2a);
            border-radius: var(--r-lg);
            padding: 32px;
            text-align: center;
            margin-bottom: 24px;
            box-shadow: var(--shadow-md);
        }

        .result-score {
            font-family: var(--ff-h);
            font-size: 4rem;
            font-weight: 900;
            color: #fff;
            line-height: 1;
            margin: 10px 0;
        }

        .result-team {
            font-family: var(--ff-h);
            font-size: .8rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(255,255,255,.6);
        }

        .winner-badge {
            display: inline-block;
            background: var(--green);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            padding: 3px 12px;
            border-radius: 999px;
            margin-top: 6px;
        }

        .summary-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .summary-header {
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            font-family: var(--ff-h);
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            display: flex;
            justify-content: space-between;
        }

        .sk-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 18px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }

            .sk-row:last-child {
                border-bottom: none;
            }

        .sk-phut {
            font-family: var(--ff-h);
            color: var(--green);
            min-width: 32px;
            font-weight: 700;
        }

        .confirm-box {
            background: rgba(14,168,106,.06);
            border: 1.5px solid rgba(14,168,106,.25);
            border-radius: var(--r-lg);
            padding: 22px;
            text-align: center;
        }
    </style>
}

<div style="background:var(--bg2);padding:100px 0 32px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Staff — Kết thúc trận đấu</div>
        <h1 style="font-style:italic;line-height:.9;margin:0">
            KẾT THÚC<br><span class="text-green">TRẬN ĐẤU</span>
        </h1>
    </div>
</div>
<div style="background:var(--bg3);border-bottom:1px solid var(--border);
            padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2 flex-wrap justify-content-between align-items-center">
        <a href="/TournamentStaff/SuKien/@Model.Id"
           class="btn btn-outline-secondary rounded-pill">← Quay lại ghi sự kiện</a>
        <div style="font-size:12px;color:var(--muted)">
            🏆 @Model.GiaiDau?.TenGiai &nbsp;·&nbsp; Vòng @Model.VongDau
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="kt-wrap">

        <!-- KẾT QUẢ CUỐI -->
        <div class="result-box">
            <div style="color:rgba(255,255,255,.5);font-size:11px;letter-spacing:3px;
                        text-transform:uppercase;margin-bottom:12px">
                KẾT QUẢ TRẬN ĐẤU
            </div>
            <div style="display:flex;align-items:center;justify-content:center;gap:20px">
                <div style="flex:1">
                    <div class="result-team">@Model.DoiNha?.TenDoi</div>
                    @if (tysoNha > tysoKhach)
                    {
                        <div class="winner-badge">THẮNG</div>
                    }
                </div>
                <div>
                    <div class="result-score">@tysoNha — @tysoKhach</div>
                </div>
                <div style="flex:1">
                    <div class="result-team">@Model.DoiKhach?.TenDoi</div>
                    @if (tysoKhach > tysoNha)
                    {
                        <div class="winner-badge">THẮNG</div>
                    }
                </div>
            </div>
            @if (tysoNha == tysoKhach)
            {
                <div style="color:rgba(255,255,255,.6);font-size:13px;margin-top:10px">
                    🤝 Hòa
                </div>
            }
        </div>

        <!-- TỔNG KẾT BÀN THẮNG -->
        @if (skBanThang.Any())
        {
            <div class="summary-card">
                <div class="summary-header">
                    ⚽ BÀN THẮNG
                    <span>@skBanThang.Count bàn</span>
                </div>
                @foreach (var sk in skBanThang.OrderBy(s => s.Phut))
                {
                    <div class="sk-row">
                        <span class="sk-phut">@(sk.Phut)'</span>
                        <span style="font-size:1rem">⚽</span>
                        <span style="font-weight:600;flex:1">@sk.ThanhVien?.HoTen</span>
                        <span style="color:var(--muted);font-size:12px">@sk.Doi?.TenDoi</span>
                    </div>
                }
            </div>
        }

        <!-- TỔNG KẾT THẺ PHẠT -->
        @if (skThe.Any())
        {
            <div class="summary-card">
                <div class="summary-header">
                    💛🟥 THẺ PHẠT
                    <span>@skThe.Count thẻ</span>
                </div>
                @foreach (var sk in skThe.OrderBy(s => s.Phut))
                {
                    var ico = sk.LoaiSuKien switch
                    {
                        "TheVang" => "💛",
                        "TheDo" => "🟥",
                        "TheVangLan2" => "🟥",
                        _ => "📋"
                    };
                    <div class="sk-row">
                        <span class="sk-phut">@(sk.Phut)'</span>
                        <span style="font-size:1rem">@ico</span>
                        <span style="font-weight:600;flex:1">@sk.ThanhVien?.HoTen</span>
                        <span style="color:var(--muted);font-size:12px">@sk.Doi?.TenDoi</span>
                    </div>
                }
            </div>
        }

        <!-- CẢNH BÁO TREO GIÒ -->
        @{
            var coTheTreoGio = (Model.DoiNha?.ThanhViens ?? new List<Web_Stadium.EFCore.ThanhVienDoi>())
            .Concat(Model.DoiKhach?.ThanhViens ?? new List<Web_Stadium.EFCore.ThanhVienDoi>())
            .Where(tv =>
            {
                var soVang = Model.SuKiens?.Count(s =>
                    s.ThanhVienId == tv.Id &&
                    (s.LoaiSuKien == "TheVang" || s.LoaiSuKien == "TheVangLan2")) ?? 0;
                var soDo = Model.SuKiens?.Count(s =>
                    s.ThanhVienId == tv.Id && s.LoaiSuKien == "TheDo") ?? 0;
                return soVang >= 2 || soDo >= 1;
            }).ToList();
        }
        @if (coTheTreoGio.Any())
        {
            <div style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);
                                border-radius:var(--r);padding:14px 18px;margin-bottom:20px">
                <div style="font-weight:700;color:var(--danger);margin-bottom:8px">
                    ⛔ Sau trận này — tự động treo giò
                </div>
                @foreach (var tv in coTheTreoGio)
                {
                    <div style="font-size:13px;color:var(--muted);margin-top:4px">
                        • <strong>@tv.HoTen</strong> (số @tv.SoAo — @tv.Doi?.TenDoi)
                    </div>
                }
                <div style="font-size:12px;color:var(--muted2);margin-top:8px">
                    Hệ thống sẽ tự động áp dụng treo giò khi bấm Chốt kết quả.
                </div>
            </div>
        }

        <!-- XÁC NHẬN CHỐT -->
        <div class="confirm-box">
            <div style="font-family:var(--ff-h);font-size:13px;letter-spacing:2px;
                        text-transform:uppercase;color:var(--green);margin-bottom:10px">
                ✅ XÁC NHẬN KẾT QUẢ
            </div>
            <p style="color:var(--muted);font-size:13px;margin-bottom:18px">
                Đọc kết quả cho <strong>2 đội trưởng</strong> xác nhận trước khi bấm Chốt.
                <strong style="color:var(--danger)">Thao tác này không thể hoàn tác.</strong>
            </p>
            <div style="font-size:1.3rem;font-weight:800;color:var(--text);margin-bottom:18px">
                @Model.DoiNha?.TenDoi
                <span style="font-family:var(--ff-h);color:var(--green);font-size:1.6rem;margin:0 10px">
                    @tysoNha — @tysoKhach
                </span>
                @Model.DoiKhach?.TenDoi
            </div>
            <form method="post" action="/TournamentStaff/XacNhanKetThuc" id="formChot">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tranDauId" value="@Model.Id" />
                <button type="submit" class="btn-primary-glow"
                        style="font-size:15px;padding:14px 40px;border-radius:var(--r)"
                        id="btnChot"
                        onclick="return confirm('Chốt kết quả @Model.DoiNha?.TenDoi @tysoNha–@tysoKhach @Model.DoiKhach?.TenDoi?')">
                    🏁 Chốt kết quả chính thức
                </button>
            </form>
        </div>
    </div>
</div>
