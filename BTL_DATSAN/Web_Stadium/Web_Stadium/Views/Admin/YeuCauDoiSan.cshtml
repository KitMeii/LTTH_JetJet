@model List<Web_Stadium.EFCore.YeuCauDoiSan>
@{
    ViewData["Title"] = "Giám sát Yêu cầu đổi sân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = ViewBag.TrangThaiFilter as string;
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container d-flex justify-content-between align-items-end">
        <div>
            <div class="section-label">Admin</div>
            <h1 style="font-style:italic;line-height:0.9;margin:0">
                GIÁM SÁT<br><span class="text-green">ĐỔI SÂN</span>
            </h1>
        </div>
        <div style="font-size:13px;color:var(--muted)">@Model.Count yêu cầu</div>
    </div>
</div>

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">✅ @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">❌ @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- Bộ lọc trạng thái -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <a href="/Admin/YeuCauDoiSan"
           class="btn btn-sm rounded-pill @(filter == null ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
        <a href="/Admin/YeuCauDoiSan?trangThai=ChoXuLy"
           class="btn btn-sm rounded-pill @(filter == "ChoXuLy" ? "btn-warning" : "btn-outline-warning")">⏳ Chờ xử lý</a>
        <a href="/Admin/YeuCauDoiSan?trangThai=DaPheDuyet"
           class="btn btn-sm rounded-pill @(filter == "DaPheDuyet" ? "btn-success" : "btn-outline-success")">✅ Đã phê duyệt</a>
        <a href="/Admin/YeuCauDoiSan?trangThai=TuChoi"
           class="btn btn-sm rounded-pill @(filter == "TuChoi" ? "btn-danger" : "btn-outline-danger")">❌ Từ chối</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 0;color:var(--muted)">
            <div style="font-size:3rem;margin-bottom:16px">🏟️</div>
            <div style="font-family:var(--ff-h);font-size:1.2rem">Không có dữ liệu</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="font-size:13px">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Khách</th>
                        <th>Sân cũ → Sân mới</th>
                        <th>Khung giờ mới</th>
                        <th>Chênh lệch</th>
                        <th>Trạng thái</th>
                        <th>Owner XL</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var yc in Model)
                    {
                        <tr>
                            <td>@yc.Id</td>
                            <td>
                                <strong>@yc.DatSan?.User?.HoTen</strong><br/>
                                <small style="color:var(--muted)">@yc.DatSan?.User?.Email</small>
                            </td>
                            <td>
                                <span style="color:var(--muted)">@yc.DatSan?.KhungGio?.SanBong?.TenSan</span>
                                <span style="color:var(--muted)"> → </span>
                                <strong style="color:#3b82f6">@yc.SanMoi?.TenSan</strong>
                            </td>
                            <td>
                                @yc.KhungGioMoi?.GioBatDau.ToString("HH:mm") – @yc.KhungGioMoi?.GioKetThuc.ToString("HH:mm")
                                <br/><small style="color:var(--muted)">@yc.NgayThiDau.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                @if (yc.ChenhLechGia > 0)
                                {
                                    <span style="color:#ef4444">+@yc.ChenhLechGia.ToString("N0")đ</span>
                                }
                                else if (yc.ChenhLechGia < 0)
                                {
                                    <span style="color:var(--green)">@yc.ChenhLechGia.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span style="color:var(--muted)">0đ</span>
                                }
                            </td>
                            <td>
                                @if (yc.TrangThai == "ChoXuLy")
                                {
                                    <span class="badge bg-warning text-dark">⏳ Chờ xử lý</span>
                                }
                                else if (yc.TrangThai == "DaPheDuyet")
                                {
                                    <span class="badge bg-success">✅ Phê duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">❌ Từ chối</span>
                                }
                            </td>
                            <td>@(yc.OwnerXuLy?.HoTen ?? "—")</td>
                            <td>@yc.ThoiGianTao.ToString("dd/MM HH:mm")</td>
                            <td>
                                <button class="btn btn-xs btn-outline-info rounded-pill"
                                        style="font-size:11px;padding:2px 8px"
                                        onclick="moModal(@yc.Id)">
                                    Chi tiết / Override
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Override -->
@foreach (var yc in Model)
{
    <div class="modal fade" id="modal-@yc.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:var(--bg2);border:1px solid var(--border)">
                <div class="modal-header" style="border-color:var(--border)">
                    <h5 class="modal-title" style="font-size:14px">Admin Override — YC đổi sân #@yc.Id</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="font-size:13px">
                    <div class="mb-2"><strong>Khách:</strong> @yc.DatSan?.User?.HoTen</div>
                    <div class="mb-2"><strong>Sân cũ:</strong> @yc.DatSan?.KhungGio?.SanBong?.TenSan</div>
                    <div class="mb-2"><strong>Sân mới:</strong> @yc.SanMoi?.TenSan</div>
                    <div class="mb-2">
                        <strong>Khung giờ mới:</strong>
                        @yc.KhungGioMoi?.GioBatDau.ToString("HH:mm") – @yc.KhungGioMoi?.GioKetThuc.ToString("HH:mm")
                    </div>
                    <div class="mb-2"><strong>Lý do:</strong> @yc.LyDo</div>
                    <div class="mb-3"><strong>Trạng thái hiện tại:</strong>
                        <span class="badge @(yc.TrangThai == "DaPheDuyet" ? "bg-success" : yc.TrangThai == "TuChoi" ? "bg-danger" : "bg-warning text-dark")">
                            @yc.TrangThai
                        </span>
                    </div>
                    <form method="post" action="/Admin/GhiDeDoiSan">
                        <input type="hidden" name="yeuCauId" value="@yc.Id" />
                        <div class="mb-3">
                            <label style="font-size:12px;color:var(--muted)">Ghi chú Admin:</label>
                            <textarea name="ghiChuAdmin" class="form-control mt-1" rows="2"
                                      placeholder="Ghi chú override..."
                                      style="background:var(--bg3);border-color:var(--border);color:var(--text);font-size:12px"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" name="hanhDong" value="PheDuyet" class="btn btn-sm btn-success rounded-pill">
                                ✅ Override Phê duyệt
                            </button>
                            <button type="submit" name="hanhDong" value="TuChoi" class="btn btn-sm btn-danger rounded-pill">
                                ❌ Override Từ chối
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function moModal(id) {
        new bootstrap.Modal(document.getElementById('modal-' + id)).show();
    }
</script>
}
