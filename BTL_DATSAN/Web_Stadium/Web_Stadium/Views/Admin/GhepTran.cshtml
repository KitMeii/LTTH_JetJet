@model List<Web_Stadium.EFCore.GhepTran>
@{
    ViewData["Title"] = "Giám sát Ghép trận";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = ViewBag.TrangThaiFilter as string;
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container d-flex justify-content-between align-items-end">
        <div>
            <div class="section-label">Admin</div>
            <h1 style="font-style:italic;line-height:0.9;margin:0">
                GIÁM SÁT<br><span class="text-green">GHÉP TRẬN</span>
            </h1>
        </div>
        <div style="font-size:13px;color:var(--muted)">@Model.Count bản ghi</div>
    </div>
</div>

<div class="container py-4">

    <!-- Bộ lọc -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <a href="/Admin/GhepTran"
           class="btn btn-sm rounded-pill @(filter == null ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
        <a href="/Admin/GhepTran?trangThai=ChoXacNhan"
           class="btn btn-sm rounded-pill @(filter == "ChoXacNhan" ? "btn-warning" : "btn-outline-warning")">⏳ Chờ xác nhận</a>
        <a href="/Admin/GhepTran?trangThai=DaXacNhan"
           class="btn btn-sm rounded-pill @(filter == "DaXacNhan" ? "btn-info" : "btn-outline-info")">✅ Đã xác nhận</a>
        <a href="/Admin/GhepTran?trangThai=HoanTat"
           class="btn btn-sm rounded-pill @(filter == "HoanTat" ? "btn-success" : "btn-outline-success")">🎉 Hoàn tất</a>
        <a href="/Admin/GhepTran?trangThai=TuChoi"
           class="btn btn-sm rounded-pill @(filter == "TuChoi" ? "btn-danger" : "btn-outline-danger")">❌ Từ chối</a>
        <a href="/Admin/GhepTran?trangThai=DaHuy"
           class="btn btn-sm rounded-pill @(filter == "DaHuy" ? "btn-secondary" : "btn-outline-secondary")">🚫 Đã hủy</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 0;color:var(--muted)">
            <div style="font-size:3rem;margin-bottom:16px">⚽</div>
            <div style="font-family:var(--ff-h);font-size:1.2rem">Không có dữ liệu</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="font-size:12px">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Đội A</th>
                        <th>Sân A</th>
                        <th>Đội B</th>
                        <th>Sân B</th>
                        <th>Hình thức</th>
                        <th>Sân chọn</th>
                        <th>Trạng thái</th>
                        <th>Lời nhắn</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.Id</td>
                            <td>
                                <strong>@g.UserA?.HoTen</strong>
                            </td>
                            <td>
                                @g.DatSanA?.KhungGio?.SanBong?.TenSan<br/>
                                <small style="color:var(--muted)">
                                    @g.DatSanA?.NgayThiDau.ToString("dd/MM")
                                    @g.DatSanA?.KhungGio?.GioBatDau.ToString("HH:mm")
                                </small>
                            </td>
                            <td>@(g.UserB?.HoTen ?? "—")</td>
                            <td>
                                @(g.DatSanB?.KhungGio?.SanBong?.TenSan ?? "—")
                            </td>
                            <td>
                                @if (g.HinhThuc == "SanA") { <span class="badge bg-success">Sân A</span> }
                                else if (g.HinhThuc == "SanB") { <span class="badge bg-primary">Sân B</span> }
                                else if (g.HinhThuc == "SanMoi") { <span class="badge bg-info text-dark">Sân mới</span> }
                                else { <span style="color:var(--muted)">—</span> }
                            </td>
                            <td>@(g.SanChon?.TenSan ?? "—")</td>
                            <td>
                                @{
                                    var (bgClass, label) = g.TrangThai switch {
                                        "ChoXacNhan" => ("bg-warning text-dark", "⏳ Chờ"),
                                        "DaXacNhan"  => ("bg-info text-dark",    "✅ Xác nhận"),
                                        "HoanTat"    => ("bg-success",           "🎉 Hoàn tất"),
                                        "TuChoi"     => ("bg-danger",            "❌ Từ chối"),
                                        "DaHuy"      => ("bg-secondary",         "🚫 Đã hủy"),
                                        _            => ("bg-secondary",          g.TrangThai)
                                    };
                                }
                                <span class="badge @bgClass">@label</span>
                            </td>
                            <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@g.LoiNhan">@g.LoiNhan</td>
                            <td>@g.ThoiGianTao.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
