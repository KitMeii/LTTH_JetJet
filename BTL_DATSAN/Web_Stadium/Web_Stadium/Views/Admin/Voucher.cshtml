@model IEnumerable<Web_Stadium.EFCore.Voucher>
@{
    ViewData["Title"] = "Quản lý Voucher Hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string filter = ViewBag.Filter ?? "";
    double tongTienGiam = (double)(ViewBag.TongTienGiam ?? 0m);
}

<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:10px 0;position:sticky;top:0;z-index:100;">
    <div class="container d-flex gap-2 flex-wrap justify-content-center">
        <a href="/Admin" class="btn btn-sm btn-outline-light rounded-pill">📊 Dashboard</a>
        <a href="/Admin/DuyetSan" class="btn btn-sm btn-outline-warning rounded-pill">🏟️ Duyệt sân</a>
        <a href="/Admin/QuanLySan" class="btn btn-sm btn-outline-success rounded-pill">📍 Quản lý sân</a>
        <a href="/Admin/KhieuNai" class="btn btn-sm btn-outline-danger rounded-pill">⚠️ Khiếu nại</a>
        <a href="/Admin/BaoCao" class="btn btn-sm btn-outline-info rounded-pill">📈 Báo cáo</a>
        <a href="/Admin/AuditLog" class="btn btn-sm btn-outline-secondary rounded-pill">🛡️ Audit Log</a>
        <a href="/Admin/QuanLyUser" class="btn btn-sm btn-outline-info rounded-pill">👥 Tài khoản</a>
        <a href="/Admin/Voucher" class="btn btn-sm btn-success rounded-pill">🎫 Voucher</a>
    </div>
</div>

<div class="container section" style="padding-top:30px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-family:var(--ff-h);font-size:2rem;margin:0;">VOUCHER HỆ THỐNG</h2>
        <a href="/Admin/TaoVoucher" class="btn btn-success rounded-pill">+ Tạo voucher mới</a>
    </div>

    <!-- KPI -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center p-3 border-0 shadow-sm" style="border-radius:16px;">
                <div style="font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;">Đã phát hành</div>
                <div style="font-size:2rem;font-weight:800;color:var(--green);">@(ViewBag.TongPhatHanh ?? 0)</div>
                <div style="font-size:12px;color:var(--muted);">lượt dùng</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-0 shadow-sm" style="border-radius:16px;">
                <div style="font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;">Tổng chiết khấu</div>
                <div style="font-size:2rem;font-weight:800;color:#ef4444;">@((tongTienGiam / 1000).ToString("F0"))K</div>
                <div style="font-size:12px;color:var(--muted);">đ PitchHub đã chịu</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-0 shadow-sm" style="border-radius:16px;">
                <div style="font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;">Đang hoạt động</div>
                <div style="font-size:2rem;font-weight:800;color:#3b82f6;">@Model.Count(v => v.IsActive && v.NgayHetHan > DateTime.Now)</div>
                <div style="font-size:12px;color:var(--muted);">voucher</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-0 shadow-sm" style="border-radius:16px;">
                <div style="font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;">Hết hạn / Tắt</div>
                <div style="font-size:2rem;font-weight:800;color:#f59e0b;">@Model.Count(v => !v.IsActive || v.NgayHetHan <= DateTime.Now)</div>
                <div style="font-size:12px;color:var(--muted);">voucher</div>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <a href="/Admin/Voucher" class="btn rounded-pill btn-sm @(filter == "" ? "btn-success" : "btn-outline-success")">Tất cả</a>
        <a href="/Admin/Voucher?filter=active" class="btn rounded-pill btn-sm @(filter == "active" ? "btn-success" : "btn-outline-success")">Đang hoạt động</a>
        <a href="/Admin/Voucher?filter=expired" class="btn rounded-pill btn-sm @(filter == "expired" ? "btn-success" : "btn-outline-success")">Hết hạn / Vô hiệu</a>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm" style="border-radius:20px;overflow:hidden;">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:var(--bg2);">
                    <tr>
                        <th>Mã</th>
                        <th>Tên Voucher</th>
                        <th>Loại giảm</th>
                        <th>Giá trị</th>
                        <th>Điều kiện</th>
                        <th>Đã dùng / Tổng</th>
                        <th>Hiệu lực</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        var conHan = v.NgayHetHan > DateTime.Now && v.IsActive;
                        var caoBon = v.LoaiGiam == "PhanTram" && v.GiaTriGiam > 50;
                        <tr>
                            <td><code style="font-size:11px;">@v.MaVoucher</code></td>
                            <td>
                                <div style="font-weight:700;">@v.TenVoucher</div>
                                @if (!string.IsNullOrEmpty(v.MoTa))
                                {
                                    <div style="font-size:12px;color:var(--muted);">@v.MoTa</div>
                                }
                                @if (caoBon)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size:10px;">⚠️ Giảm >50%</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(v.LoaiGiam == "PhanTram" ? "bg-info" : "bg-secondary")">
                                    @(v.LoaiGiam == "PhanTram" ? "%" : "VNĐ")
                                </span>
                            </td>
                            <td style="font-weight:700;color:var(--green);">
                                @if (v.LoaiGiam == "PhanTram")
                                {
                                    @($"{v.GiaTriGiam:F0}%")
                                    if (v.GiamToiDa.HasValue)
                                    {
                                        <div style="font-size:11px;color:var(--muted);">Max @v.GiamToiDa.Value.ToString("N0")đ</div>
                                    }
                                }
                                else
                                {
                                    @($"{v.GiaTriGiam:N0}đ")
                                }
                            </td>
                            <td style="font-size:13px;">
                                @(v.DieuKienToiThieu > 0 ? $"≥{v.DieuKienToiThieu:N0}đ" : "Không giới hạn")
                            </td>
                            <td>
                                <span style="font-weight:700;">@v.DaDung</span>
                                <span style="color:var(--muted);"> / @(v.SoLuong == 0 ? "∞" : v.SoLuong.ToString())</span>
                            </td>
                            <td style="font-size:12px;">
                                <div>@v.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                <div style="color:var(--muted);">→ @v.NgayHetHan.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                @if (conHan)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else if (!v.IsActive)
                                {
                                    <span class="badge bg-secondary">Vô hiệu</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hạn</span>
                                }
                            </td>
                            <td>
                                @if (v.IsActive)
                                {
                                    <form method="post" action="/Admin/VoHieuVoucher/@v.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger rounded-pill">Vô hiệu</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/Admin/KichHoatVoucher/@v.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-success rounded-pill">Kích hoạt</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4" style="color:var(--muted);">Chưa có voucher nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
