@model IEnumerable<Web_Stadium.EFCore.Voucher>
@{
    ViewData["Title"] = "Voucher Sân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sanList = (ViewBag.SanList as IEnumerable<Web_Stadium.EFCore.SanBong>) ?? Enumerable.Empty<Web_Stadium.EFCore.SanBong>();
    double tongTienGiam = (double)(ViewBag.TongTienGiam ?? 0m);
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Owner — Khuyến mãi</div>
        <h1 style="font-style:italic;line-height:0.9">VOUCHER<br><span class="text-green">SÂN CỦA TÔI</span></h1>
    </div>
</div>

<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2 flex-wrap justify-content-center">
        <a href="/Owner" class="btn btn-outline-success rounded-pill">📊 Tổng quan</a>
        <a href="/Owner/DanhSachSan" class="btn btn-outline-green rounded-pill">🏟️ Danh sách sân</a>
        <a href="/Owner/QuanLyStaff" class="btn btn-outline-info rounded-pill">👷 Nhân viên</a>
        <a href="/Owner/BaoCao" class="btn btn-outline-primary rounded-pill">📈 Báo cáo</a>
        <a href="/Owner/Voucher" class="btn btn-success rounded-pill">🎫 Voucher</a>
    </div>
</div>

<div class="container section">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-family:var(--ff-h);font-size:1.8rem;margin:0;">Voucher của tôi</h2>
        <a href="/Owner/TaoVoucher" class="btn btn-success rounded-pill">+ Tạo voucher mới</a>
    </div>

    <!-- KPI -->
    <div class="summary-grid mb-4">
        <div class="report-kpi report-kpi-green">
            <div class="kpi-title">TỔNG LƯỢT DÙNG</div>
            <div class="kpi-value">@(ViewBag.TongLuotDung ?? 0)</div>
            <div class="kpi-sub">Khách đã dùng voucher sân</div>
        </div>
        <div class="report-kpi">
            <div class="kpi-title">OWNER CHỊU</div>
            <div class="kpi-value" style="color:#ef4444;">@((tongTienGiam / 1000).ToString("F0"))K</div>
            <div class="kpi-sub">đ tổng tiền đã giảm</div>
        </div>
        <div class="report-kpi">
            <div class="kpi-title">ĐANG HOẠT ĐỘNG</div>
            <div class="kpi-value">@Model.Count(v => v.IsActive && v.NgayHetHan > DateTime.Now)</div>
            <div class="kpi-sub">voucher</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--muted);">
            <div style="font-size:3rem;">🎫</div>
            <div class="mt-2">Chưa có voucher nào. <a href="/Owner/TaoVoucher" class="text-success">Tạo ngay</a></div>
        </div>
    }
    else
    {
        @foreach (var sanGrp in Model.GroupBy(v => v.SanBong?.TenSan ?? "Chưa xác định"))
        {
            <div class="mb-4">
                <div style="font-size:14px;font-weight:700;color:var(--green);margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:6px;">
                    🏟️ @sanGrp.Key
                </div>
                <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead style="background:var(--bg2);">
                                <tr>
                                    <th>Tên Voucher</th>
                                    <th>Loại giảm</th>
                                    <th>Giá trị</th>
                                    <th>Điều kiện</th>
                                    <th>Dùng / Tổng</th>
                                    <th>Hiệu lực</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in sanGrp)
                                {
                                    var conHan = v.NgayHetHan > DateTime.Now && v.IsActive;
                                    <tr>
                                        <td>
                                            <div style="font-weight:700;">@v.TenVoucher</div>
                                            <div style="font-size:11px;color:var(--muted);">@v.MaVoucher</div>
                                        </td>
                                        <td>
                                            <span class="badge @(v.LoaiGiam == "PhanTram" ? "bg-info" : "bg-secondary")">
                                                @(v.LoaiGiam == "PhanTram" ? "%" : "VNĐ")
                                            </span>
                                        </td>
                                        <td style="font-weight:700;color:var(--green);">
                                            @if (v.LoaiGiam == "PhanTram")
                                            {
                                                @($"{v.GiaTriGiam:F0}%")
                                                if (v.GiamToiDa.HasValue)
                                                {
                                                    <div style="font-size:11px;color:var(--muted);">Max @v.GiamToiDa.Value.ToString("N0")đ</div>
                                                }
                                            }
                                            else
                                            {
                                                @($"{v.GiaTriGiam:N0}đ")
                                            }
                                        </td>
                                        <td style="font-size:13px;">
                                            @(v.DieuKienToiThieu > 0 ? $"≥{v.DieuKienToiThieu:N0}đ" : "Không")
                                        </td>
                                        <td>
                                            <span style="font-weight:700;">@v.DaDung</span>
                                            <span style="color:var(--muted);"> / @(v.SoLuong == 0 ? "∞" : v.SoLuong.ToString())</span>
                                        </td>
                                        <td style="font-size:12px;">
                                            <div>@v.NgayBatDau.ToString("dd/MM/yy")</div>
                                            <div style="color:var(--muted);">→ @v.NgayHetHan.ToString("dd/MM/yy")</div>
                                        </td>
                                        <td>
                                            @if (conHan)
                                            {
                                                <span class="badge bg-success">Hoạt động</span>
                                            }
                                            else if (!v.IsActive)
                                            {
                                                <span class="badge bg-secondary">Vô hiệu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hết hạn</span>
                                            }
                                        </td>
                                        <td>
                                            @if (v.IsActive)
                                            {
                                                <form method="post" action="/Owner/VoHieuVoucher/@v.Id" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill">Tắt</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" action="/Owner/KichHoatVoucher/@v.Id" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-sm btn-outline-success rounded-pill">Bật</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .summary-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:18px; }
    .report-kpi { background:linear-gradient(135deg,#fff,#f7fafc); border:1px solid var(--border); border-radius:24px; padding:24px; box-shadow:var(--shadow-sm); }
    .report-kpi-green { border-color:rgba(14,168,106,.3); background:linear-gradient(135deg,rgba(14,168,106,.08),#fff); }
    .kpi-title { font-size:11px; font-weight:700; letter-spacing:2px; color:var(--muted); margin-bottom:10px; }
    .kpi-value { font-family:var(--ff-h); font-size:2.4rem; color:var(--text); line-height:1; margin-bottom:8px; }
    .report-kpi-green .kpi-value { color:var(--green); }
    .kpi-sub { font-size:13px; color:var(--muted); }
</style>
