# ================================================================
# GoStaffApi — bien moi truong can set truoc khi chay.
# Go khong tu doc file .env (khong dung thu vien dotenv) — day chi la
# file THAM KHAO, phai tu export that qua PowerShell truoc khi `go run`/
# chay server.exe. Vi du:
#
#   $env:GO_STAFF_PORT="8082"
#   $env:GO_STAFF_DB="server=localhost;database=SanBongBTL;user id=sa;password=422005;TrustServerCertificate=true"
#   $env:GO_JWT_SECRET="SanBongBTL_SecretKey_2024_XYZ_MustBe32Chars"
# ================================================================

# Port HTTP — 8080 (tournament-service Java) va 8081 (java-recommendation
# Java) da bi chiem, GoStaffApi dung 8082.
GO_STAFF_PORT=8082

# Connection string SQL Server — LAY DUNG tu tournament-service/src/main/resources/
# application.properties (server=localhost, database=SanBongBTL, user=sa,
# password=422005 la gia tri mac dinh dev trong repo nay — doi neu moi truong
# that dung password khac).
GO_STAFF_DB=server=localhost;database=SanBongBTL;user id=sa;password=422005;TrustServerCertificate=true

# JWT secret — PHAI trung 100% voi:
#   - tournament-service/src/main/resources/application.properties -> jwt.secret
#   - java-recommendation/src/main/resources/application.properties -> jwt.secret
#   - Web_Stadium (C#) appsettings.json -> JWT:Secret
# Neu khong khop, token do C# TokenHelper.TaoToken() phat hanh se bi Go tu choi
# (signature mismatch) du dang nhap dung.
GO_JWT_SECRET=SanBongBTL_SecretKey_2024_XYZ_MustBe32Chars
